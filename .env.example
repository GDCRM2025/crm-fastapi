# Aplicación
APP_URL=https://example.com/crm
JWT_SECRET=replace-with-a-long-random-secret
DEV_NO_AUTH=false

# PostgreSQL
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/database
CRM_DB_POOL_SIZE=3
CRM_DB_MAX_OVERFLOW=2
CRM_DB_POOL_TIMEOUT=5

# Meta / Greenie
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_GRAPH_API_VERSION=v25.0
META_EMBEDDED_SIGNUP_CONFIG_ID=replace-with-embedded-signup-config-id
META_EMBEDDED_SIGNUP_REDIRECT_URI=https://example.com/crm/meta/whatsapp/embedded-signup/callback
META_EMBEDDED_SIGNUP_STATE_SECRET=replace-with-a-separate-long-random-secret
META_EMBEDDED_SIGNUP_REQUIRE_STATE=1
# Durante una rotación se pueden aceptar temporalmente secretos anteriores,
# separados por coma. El secreto vigente debe permanecer en META_APP_SECRET.
META_APP_SECRETS=
IG_WEBHOOK_VERIFY_TOKEN=replace-with-instagram-verify-token
GREENI_DEFAULT_BRAND_ID=gourmet
GREENI_INTERNAL_KEY=replace-with-a-long-random-internal-key

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_WABA_ID=replace-with-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-random-webhook-verify-token
WHATSAPP_VALIDATE_SIGNATURE=true
GREENIE_REALTIME_ENABLED=0
WHATSAPP_TEST_PHONE_NUMBER=
WHATSAPP_TEST_RECIPIENT=
# Obligatoria. Nunca guardar la contraseña real en Git.
DATABASE_URL=postgresql+psycopg://crm_user:REEMPLAZAR@127.0.0.1:5432/crm_db
# GD Finance / SII (certificacion por defecto; nunca guardar certificados aqui)
GD_FINANCE_SII_ENABLED=true
SII_MODE=CERTIFICATION
SII_ISSUE_ENABLED=false
SII_PRIVATE_XML_DIR=/var/lib/greendiamond/private/dte
# SII reutiliza GD_CREDENTIAL_MASTER_KEY / CredentialVault central.
