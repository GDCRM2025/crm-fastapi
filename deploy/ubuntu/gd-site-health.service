[Unit]
Description=Green Diamond CRM Site Health check
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=oscar
Group=oscar
WorkingDirectory=/opt/greendiamond/crm
EnvironmentFile=/opt/greendiamond/crm/.env
ExecStart=/opt/greendiamond/venv/bin/python scripts/jobs/run_site_health.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/greendiamond/crm
