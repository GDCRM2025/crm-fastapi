{
  "expo": {
    "name": "GreenDiamond App",
    "slug": "greendiamond-app",
    "scheme": "greendiamond",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07131F"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite compartir tu ubicación durante eventos (GPS).",
          "locationAlwaysPermission": "Permite compartir tu ubicación durante eventos (GPS).",
          "locationWhenInUsePermission": "Permite compartir tu ubicación durante eventos (GPS)."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "cl.greendiamond.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07131F"
      }
    },
    "ios": {
      "bundleIdentifier": "cl.greendiamond.app"
    }
  }
}
