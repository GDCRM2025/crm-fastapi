<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Settings</title>
  <link rel="stylesheet" href="/web/styles.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body{ padding:18px; }
    .card{
      border-radius:18px;
      padding:16px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.10);
      max-width: 900px;
    }
    :root.light .card{ background: rgba(255,255,255,.70); border-color: rgba(0,0,0,.08); }
    .btn{
      border-radius:12px;
      border:1px solid rgba(255,255,255,.16);
      background: rgba(34,197,94,.18);
      color: inherit;
      padding:10px 12px;
      cursor:pointer;
      font-weight:900;
    }
  </style>
</head>
<body>
  <section class="card">
    <h2 id="ttl" style="margin:0 0 6px 0">Settings</h2>
    <p id="sub" style="opacity:.8; margin:0 0 12px 0">CRUD real (crear/editar/eliminar/buscar/ver más).</p>
    <button class="btn" id="openCrud">Abrir gestor</button>
  </section>

  <script type="module" src="/web/js/settings_crud.js"></script>
  <script>
    window.addEventListener("message", (ev) => {
      if (ev.data?.type === "theme"){
        document.documentElement.classList.toggle("light", ev.data.mode === "light");
      }
    });
  </script>
</body>
</html>
