<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Leads</title>
  <!-- build: GD-LEADS-AGENDA-UNIFICADA-V1 -->

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Tema day/night desde el shell + helpers (cache-bust styles, sorting, etc.) -->
  <script src="../js/iframe-theme.js"></script>

  <style>
    :root{
      --app-bg:#07131F; --surface:#0C1B2B; --surface2:#102235;
      --border:#22384F; --text:#EAF2FF; --muted:#A9BBD2; --accent:#19C37D;
      --radius:14px;
    }
    :root.light{
      --app-bg:#eef5ff; --surface:#fff; --surface2:#f3f7ff;
      --border:#d7e2f2; --text:#0b1523; --muted:#516781; --accent:#19C37D;
    }

    html,body{ height:100%; }
    body{
      margin:0; background:var(--app-bg); color:var(--text);
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      overflow-x:hidden; /* NO scroll lateral */
    }
    body.embed .page{ padding:0; }
    body.embed .toolbar{ display:none !important; }
    .page{ padding:14px; overflow-x:hidden; }

    .toolbar{
      display:flex; align-items:center; gap:10px; padding:10px;
      border:1px solid var(--border); border-radius:var(--radius); background:var(--surface);
      flex-wrap:wrap;
    }

    .toggle{
      display:flex; border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--surface2);
    }
    .toggle button{
      border:0; background:transparent; color:var(--muted);
      font-weight:900; padding:9px 12px; cursor:pointer; letter-spacing:.2px;
    }
    .toggle button.active{ background:var(--accent); color:#062016; }

    .search{
      flex:1; display:flex; align-items:center; gap:8px;
      border:1px solid var(--border); border-radius:12px; background:var(--surface2);
      padding:8px 10px; min-width:220px;
    }
    .search svg{ width:16px; height:16px; color:var(--muted); flex:0 0 auto; }
    .search input{
      width:100%; border:0; outline:none; background:transparent; color:var(--text);
      font-weight:700; font-size:13px;
    }
    .search:focus-within{
      border-color: rgba(25,195,125,.55);
      box-shadow: 0 0 0 3px rgba(25,195,125,.12);
    }
    .monthPicker{
      min-height:38px; border:1px solid var(--border); border-radius:12px;
      background:var(--surface2); color:var(--text); padding:7px 10px;
      font:inherit; font-size:13px; font-weight:900;
    }

    .badge{
      border:1px solid var(--border); border-radius:999px; padding:7px 10px;
      background:var(--surface2); color:var(--muted); font-weight:900; font-size:12px; white-space:nowrap;
    }

    .btn{
      border:1px solid var(--border); background:transparent; color:var(--text);
      border-radius:12px; padding:9px 12px; font-weight:900; cursor:pointer; white-space:nowrap;
    }
    .btn:hover{ border-color: rgba(234,242,255,.35); background: rgba(255,255,255,.03); }
    .btn.primary{ background:var(--accent); color:#062016; border-color:transparent; }
    .btn.primary:hover{ filter:brightness(1.03); }
    .btn.toggle{
      font-size:12px; letter-spacing:.06em; text-transform:uppercase;
      padding:8px 10px;
    }
    .btn.toggle.active{
      background:var(--accent); color:#062016; border-color:transparent;
    }
    .btn .miniCount{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:22px;
      height:22px;
      padding:0 8px;
      border-radius:999px;
      margin-left:8px;
      font-size:11px;
      font-weight:1100;
      border:1px solid var(--border);
      background: rgba(0,0,0,.12);
      color: var(--text);
    }
    :root.light .btn .miniCount{ background: rgba(0,0,0,.06); }
    #btnTrash.dropHover{
      border-color: rgba(239,68,68,.45);
      box-shadow: 0 0 0 3px rgba(239,68,68,.14);
      background: rgba(239,68,68,.06);
    }

    .kanban{
      margin-top:12px;
      display:grid;
      grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr)); /* NO scroll lateral */
      gap:12px;
      align-items:start;
      height: calc(100vh - 170px);
    }

    .column{
      border:2px solid var(--col-color, var(--border));
      border-radius:var(--radius);
      background:var(--surface);
      padding:8px;
      min-height:140px;
      display:flex;
      flex-direction:column;
      min-width:0;
      max-height: 100%;
      overflow:auto;
    }

    .colHead{
      display:flex; justify-content:space-between; align-items:center;
      margin-bottom:10px; gap:10px;
      padding:6px 8px; border-radius:10px;
      background: color-mix(in srgb, var(--col-color) 20%, transparent);
      border:1px solid color-mix(in srgb, var(--col-color) 35%, var(--border));
      position: sticky;
      top: 0;
      z-index: 2;
    }
    .colTitle{
      font-size:12px; font-weight:1000; color:var(--text);
      letter-spacing:.10em; text-transform:uppercase; line-height:1.1;
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    }
    .colCount{
      font-size:12px; font-weight:1000; color:var(--text);
      border:1px solid color-mix(in srgb, var(--col-color) 45%, var(--border));
      background: color-mix(in srgb, var(--col-color) 55%, var(--surface2));
      border-radius:999px; padding:5px 8px; min-width:26px; text-align:center;
    }

    .cardList{
      display:flex; flex-direction:column; gap:8px; min-height:60px;
      background: color-mix(in srgb, var(--col-color) 10%, var(--surface2));
      border:1px solid color-mix(in srgb, var(--col-color) 28%, var(--border));
      border-radius:12px;
      padding:8px;
    }
    .cardList.dropHover{
      outline:2px dashed rgba(25,195,125,.35);
      outline-offset:6px;
      border-radius:12px;
    }

    .card{
      border:1px solid var(--border);
      border-radius:12px;
      background:var(--surface2);
      padding:6px 8px;
      cursor:grab;
      user-select:none;
      min-width:0;
    }
    .card:hover{ border-color: rgba(234,242,255,.28); }
    .card.dragging{ opacity:.65; }
    .card.placeholder{ border-style:dashed; background:transparent; height:58px; }
    .card.overdue{
      border-color: rgba(239,68,68,.62);
      box-shadow: inset 3px 0 0 rgba(239,68,68,.95);
    }

    /* FICHA CHICA (lo que pediste) */
    .cardRow{ display:flex; justify-content:space-between; gap:8px; align-items:flex-start; }
    .cardName{
      font-weight:950; font-size:13px; line-height:1.15;
      display:flex; align-items:center; gap:8px;
      flex:1 1 auto; min-width:0;
      overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .cardName .nameText{
      flex:1 1 auto; min-width:0;
      overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .cardDate{
      flex:0 0 auto;
      font-size:12px; font-weight:1000; color:var(--text);
      border:1px solid var(--border);
      background: rgba(0,0,0,.10);
      border-radius:999px;
      padding:5px 9px;
      white-space:nowrap;
      text-shadow:none;
    }
    :root.light .cardDate{ background:#ffffff; color:#0f172a; border-color:#94a3b8; }
    .cardDate.noDate{
      border-color:#d97706;
      background:#fff7ed;
      color:#7c2d12;
    }
    .cardDate svg{ width:14px; height:14px; vertical-align:-2px; margin-right:6px; opacity:.9; }
    .cardDate svg{ color: currentColor; opacity:.95; }
    .cardDate.cal-red{ border-color:#fca5a5; background:#7f1d1d; color:#ffffff; }
    .cardDate.cal-yellow{ border-color:#facc15; background:#78350f; color:#ffffff; }
    .cardDate.cal-green{ border-color:#86efac; background:#14532d; color:#ffffff; }
    .cardDate.cal-gray{ border-color:#94a3b8; background:#334155; color:#ffffff; }
    :root.light .cardDate.cal-red{ border-color:#991b1b; background:#fee2e2; color:#7f1d1d; }
    :root.light .cardDate.cal-yellow{ border-color:#92400e; background:#fef3c7; color:#78350f; }
    :root.light .cardDate.cal-green{ border-color:#166534; background:#dcfce7; color:#14532d; }
    :root.light .cardDate.cal-gray{ border-color:#475569; background:#e2e8f0; color:#1e293b; }
    .dateWarn{
      display:inline-block;
      margin-right:6px;
      font-size:10px;
      font-weight:1000;
      letter-spacing:.06em;
      text-transform:uppercase;
      vertical-align:1px;
    }

    .flag{
      position:relative;
      width:14px;
      height:14px;
      flex:0 0 auto;
    }
    .flag::before{
      content:"";
      position:absolute;
      left:-3px;
      top:-1px;
      width:2px;
      height:16px;
      border-radius:2px;
      background: rgba(148,163,184,.65);
      box-shadow: 0 10px 25px rgba(0,0,0,.14);
      opacity:.9;
    }
    .flag::after{
      content:"";
      position:absolute;
      left:0;
      top:0;
      width:14px;
      height:14px;
      background: var(--c, #64748b);
      clip-path: polygon(0 0, 100% 0, 100% 28%, 72% 50%, 100% 72%, 100% 100%, 0 100%);
      border-radius:2px;
      box-shadow: 0 0 0 1px rgba(255,255,255,.10) inset, 0 10px 25px rgba(0,0,0,.16);
    }
    .flag.red{ --c: #ef4444; }
    .flag.blue{ --c: #60a5fa; }
    .flag.yellow{ --c: #f59e0b; }
    .flag.green{ --c: #22c55e; }
    .flag.gray{ --c: #64748b; opacity:.75; }

    .flagIcon{
      width:16px;
      height:16px;
      flex:0 0 auto;
      display:inline-flex;
      align-items:center;
      justify-content:center;
    }
    .flagIcon svg{ width:16px; height:16px; display:block; }

    .dots{ display:inline-flex; align-items:center; gap:6px; }
    .dot{
      width:9px; height:9px; border-radius:999px;
      background: var(--c, transparent);
      border: 1px solid rgba(148,163,184,.28);
      box-shadow: 0 0 0 2px rgba(0,0,0,.10);
    }
    .dot.red{ --c: rgba(239,68,68,.95); border-color: rgba(239,68,68,.45); }
    .dot.yellow{ --c: rgba(245,158,11,.95); border-color: rgba(245,158,11,.45); }
    .dot.green{ --c: rgba(34,197,94,.95); border-color: rgba(34,197,94,.45); }

    .cardRow2{
      margin-top:4px;
      display:flex; justify-content:space-between; gap:8px; align-items:center;
      font-size:12px; color:var(--muted);
      min-width:0;
    }
    .cardComuna{
      flex:1 1 auto; min-width:0;
      overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .cardMonto{
      flex:0 0 auto;
      font-weight:950; color:var(--text); opacity:.92;
      white-space:nowrap;
      display:inline-flex; align-items:center; gap:8px;
    }

    .cardActions{ margin-top:6px; display:flex; gap:6px; justify-content:center; }
    .iconBtn{
      width:30px; height:30px; display:grid; place-items:center;
      border:1px solid var(--border); background:transparent;
      border-radius:10px; color:var(--text); cursor:pointer;
    }
    .iconBtn svg{ width:16px; height:16px; }
    .iconBtn.icon-edit{ color:#60a5fa; border-color:rgba(96,165,250,.45); }
    .iconBtn.icon-phone{ color:#22c55e; border-color:rgba(34,197,94,.45); }
    .iconBtn.icon-wa{ color:#25D366; border-color:rgba(37,211,102,.45); }
    .iconBtn.icon-quote{ color:#f59e0b; border-color:rgba(245,158,11,.45); }
    .iconBtn:hover{
      border-color: rgba(234,242,255,.28);
      background: rgba(255,255,255,.03);
    }

    .tableWrap{
      margin-top:12px;
      border:1px solid var(--border);
      border-radius:var(--radius);
      background:var(--surface);
      max-height:62vh;
      overflow:auto;
    }
    table{ width:100%; border-collapse:collapse; font-size:13px; }
    thead th{
      text-align:left; font-size:12px; letter-spacing:.10em; text-transform:uppercase;
      color:var(--muted); padding:12px 12px; border-bottom:1px solid var(--border);
      position:sticky; top:0; z-index:3; background:var(--surface);
    }
    tbody td{
      padding:10px 12px; border-bottom:1px solid var(--border); vertical-align:top;
    }
    tbody tr:hover td{ background: rgba(255,255,255,.02); }

    .sub{ color:var(--muted); font-weight:800; font-size:12px; margin-top:2px; }

    .statePill{
      display:inline-flex; align-items:center; gap:8px;
      border:1px solid var(--border); background:var(--surface2);
      border-left:4px solid var(--s, var(--border));
      padding:6px 10px; border-radius:999px;
      font-weight:950; font-size:12px; color:var(--text); white-space:nowrap;
    }

    td.actions{ white-space:nowrap; display:flex; gap:6px; align-items:center; }

    .errorBox{
      margin-top:12px;
      padding:12px;
      border:1px solid rgba(255,80,80,.35);
      background: rgba(255,80,80,.08);
      border-radius:14px;
      color: rgba(255,220,220,.95);
      font-weight:850;
      display:none;
      white-space: pre-wrap;
    }

    .card.flash{
      border-color:#facc15;
      box-shadow: 0 0 0 2px rgba(250,204,21,.22), 0 10px 20px rgba(250,204,21,.08);
      animation: flashCard 2.6s ease-out 1;
    }
    @keyframes flashCard{
      0%{ transform: translateY(-1px); background: rgba(250,204,21,.10); }
      100%{ transform: translateY(0); background: var(--surface2); }
    }
    tbody tr.flash td{
      background: rgba(250,204,21,.12);
      animation: flashRow 2.6s ease-out 1;
    }
    @keyframes flashRow{
      0%{ background: rgba(250,204,21,.16); }
      100%{ background: transparent; }
    }

    /* === SweetAlert form (FALTABA en tu versión actual) === */
    .swForm{ text-align:left; margin-top:6px; }
    .grid2{ display:grid; grid-template-columns: 1fr 1fr; gap:10px; }
    .grid2 .span2{ grid-column: 1 / -1; }

    .swForm label{
      display:block;
      font-size:12px;
      font-weight:950;
      color:var(--muted);
      letter-spacing:.02em;
    }
    .swInp, .swSel, .swTa{
      width:100%;
      margin-top:6px;
      border-radius:12px;
      border:1px solid var(--border);
      background:var(--surface2);
      color:var(--text);
      padding:10px 10px;
      font-weight:850;
      outline:none;
      box-sizing:border-box;
    }
    .swTa{ resize:vertical; min-height:88px; }
    .swInp:focus, .swSel:focus, .swTa:focus{
      border-color: rgba(25,195,125,.55);
      box-shadow: 0 0 0 3px rgba(25,195,125,.12);
    }
    .swBtn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:10px 12px;
      border-radius:12px;
      border:1px solid rgba(25,195,125,.32);
      background: rgba(25,195,125,.16);
      color: var(--text);
      font-weight: 950;
      cursor:pointer;
    }
    .swBtn:hover{ filter:brightness(1.06); }
    .swBtn.secondary{
      border:1px solid var(--border);
      background: rgba(255,255,255,.03);
      color: var(--text);
    }
    .swBtn:disabled{ opacity:.45; cursor:not-allowed; filter:none; }

    .wspBox{
      margin-top:6px;
      padding:10px;
      border-radius:14px;
      border:1px dashed rgba(255,255,255,.12);
      background: rgba(255,255,255,.03);
    }
    .wspRow{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
    }
	    .wspRow select{ flex: 1 1 260px; }

	    .swal2-popup{
	      background: var(--surface) !important;
	      color: var(--text) !important;
	      border: 1px solid var(--border) !important;
	      border-radius: 16px !important;
	    }
	    .swal2-title{ color: var(--text) !important; }
	    .swal2-html-container{ color: var(--text) !important; }

	    /* Agenda modal: permitir scroll dentro del contenido */
	    .gdAgenda .swal2-html-container{ max-height: 78vh; overflow:auto !important; }
	    /* Edit modal: sin scroll global (solo Notas/Historial) */
	    .gdEditLead .swal2-html-container{ max-height: 72vh; overflow: auto !important; }
	    .gdEditLead .swForm{ max-height: 70vh; overflow: auto; }
	    .gdEditLead #e_notas{ max-height: 22vh; overflow:auto; }

	    /* WhatsApp picker: más legible */
	    .gdWsp .swal2-html-container{ max-height: 78vh; overflow:auto !important; }
	    .gdWsp .swInp{ font-size:15px; font-weight:750; }
	    .gdWsp .swTa{ font-size:16px; font-weight:650; line-height:1.35; min-height: 190px; }
	    .gdWsp #sw_wa_list .swBtn{ font-size:14px; }

      /* Selector neutro (1 día vs multi-día) */
      .gdNeutral .swal2-radio{
        display:grid !important;
        gap:10px !important;
        justify-content:stretch !important;
        padding:12px !important;
        border-radius:16px !important;
        border:1px solid var(--border) !important;
        background: rgba(0,0,0,.18) !important;
      }
      .gdNeutral .swal2-radio label{
        display:flex !important;
        align-items:center !important;
        gap:10px !important;
        padding:10px 12px !important;
        border-radius:14px !important;
        border:1px solid var(--border) !important;
        background: var(--surface2) !important;
        color: var(--text) !important;
        font-weight:900 !important;
        text-shadow: 0 1px 0 rgba(0,0,0,.25);
      }
      .gdNeutral .swal2-radio input[type="radio"]{
        transform: scale(1.08);
      }
      .gdNeutral .swal2-radio label:hover{
        filter: brightness(1.05);
      }

    /* ===== Mobile pragmatic mode ===== */
    @media (max-width: 820px){
      .page{ padding:10px; }
      .toolbar{ padding:10px; gap:8px; }
      .toggle{ width:100%; }
      /* en móvil usamos Tabla por defecto (más rápido y usable) */
      #btnKanban{ display:none; }
      .search{ min-width: 0; width:100%; }
      #monthBadge{ display:none; }
      #status{ display:none; }
      .badge{ padding:6px 10px; font-size:12px; }
      .btn.primary{ width:100%; padding:12px 14px; border-radius:14px; }

      .tableWrap{ max-height: calc(100vh - 190px); }
      table{ font-size:12px; }
      thead th{ padding:10px 10px; font-size:11px; }
      tbody td{ padding:10px 10px; }

      /* oculta columnas menos importantes en móvil */
      .col-marca, .col-comuna, .col-email, .col-estado { display:none; }

      /* botones táctiles */
      .iconBtn{ width:38px; height:38px; border-radius:12px; }
      .iconBtn svg{ width:18px; height:18px; }
      td.actions{ gap:8px; }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="toolbar">
      <div class="toggle">
        <button id="btnKanban" type="button" class="active">Kanban</button>
        <button id="btnTable" type="button">Tabla</button>
      </div>

      <div class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M10 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="m21 21-4.3-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input id="q" placeholder="Buscar cliente, email, comuna, marca..." autocomplete="off" />
      </div>

      <input class="monthPicker" id="monthPicker" type="month" title="Mes de los eventos que quieres revisar" />
      <button class="btn toggle" id="btnAllMonths" type="button" title="Mostrar leads de todos los meses">Todos</button>

      <div class="badge" id="status">Init…</div>
      <div class="badge" id="monthBadge">Mes seleccionado: 0</div>
      <div class="badge" id="leadCount">0 leads</div>
      <button class="btn" id="btnTrash" type="button" title="Declinados (basurero). También puedes arrastrar un lead aquí para declinar.">
        🗑️ Declinados <span class="miniCount" id="trashCount">0</span>
      </button>
      <button class="btn primary" id="btnCreate" type="button">+ Crear lead</button>
    </div>

    <div class="errorBox" id="errBox"></div>

    <div id="kanbanView" class="kanban"></div>

    <div id="tableView" class="tableWrap" style="display:none">
      <table>
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Marca</th>
            <th>Comuna</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="tblBody"></tbody>
      </table>
    </div>
  </div>

<script>
/* ========= Helpers ========= */
const qs  = (s, el=document) => el.querySelector(s);
const qsa = (s, el=document) => Array.from(el.querySelectorAll(s));
	const IS_MOBILE = window.matchMedia && window.matchMedia("(max-width: 820px)").matches;

  function isClosedEstadoName(estadoUpper){
    const name = String(estadoUpper || "").toUpperCase();
    return name.includes("CONFIRM") || name.includes("DECLIN");
  }

window.addEventListener("message", (ev) => {
  if (ev.data?.type === "openLead"){
    const id = ev.data.id;
    if (Array.isArray(ev.data.stale_ids) && ev.data.stale_ids.length){
      STALE_IDS = new Set(ev.data.stale_ids.map(x => String(x)));
      FILTER_MONTH = false;
    }
    if (!id) return;
    if (LEADS && LEADS.length){
      const lead = LEADS.find(x => String(x.id_lead) === String(id));
      if (lead) setTimeout(() => openEditModal(lead), 80);
    }else{
      PENDING_OPEN_ID = String(id);
    }
  }
});

function setStatus(s){ qs("#status").textContent = s; }

function showError(msg){
  const box = qs("#errBox");
  box.style.display = "block";
  box.textContent = msg;
  setStatus("ERROR");
}
function clearError(){
  const box = qs("#errBox");
  box.style.display = "none";
  box.textContent = "";
}

window.addEventListener("error", (e)=> showError("JS error: " + (e.message || String(e.error || e))));
window.addEventListener("unhandledrejection", (e)=> showError("Promise error: " + String(e.reason || e)));

function getToken(){
  // soporte para diferentes claves (tu login devuelve access_token/token/jwt)
  const keys = ["token","access_token","jwt","gd_token","gd_access_token","crm_token"];
  for (const k of keys){
    const v1 = localStorage.getItem(k);
    if (v1 && String(v1).trim()) return String(v1).trim();
    const v2 = sessionStorage.getItem(k);
    if (v2 && String(v2).trim()) return String(v2).trim();
  }
  try{
    const auth = localStorage.getItem("auth") || sessionStorage.getItem("auth");
    if (auth){
      const o = JSON.parse(auth);
      if (o?.access_token) return String(o.access_token);
      if (o?.token) return String(o.token);
      if (o?.jwt) return String(o.jwt);
    }
  }catch(_){}
  // Fallback: si este view está dentro del shell (/web/index.html),
  // el parent expone GD.getToken()
  try{
    const tParent = window.parent?.GD?.getToken?.();
    if (tParent && String(tParent).trim()) return String(tParent).trim();
  }catch(_){}
  return "";
}
function authHeaders(extra={}){
  const t = getToken();
  const base = { Accept:"application/json", ...(extra||{}) };
  return t ? { ...base, Authorization: "Bearer " + t } : base;
}

function _plainToast(title, kind="success"){
  let box = document.getElementById("gdToast");
  if (!box){
    box = document.createElement("div");
    box.id = "gdToast";
    box.style.cssText = [
      "position:fixed",
      "top:14px",
      "right:14px",
      "z-index:99999",
      "display:grid",
      "gap:8px",
      "max-width:min(520px,92vw)"
    ].join(";");
    document.body.appendChild(box);
  }
  const item = document.createElement("div");
  const bg = kind === "error" ? "rgba(239,68,68,.22)" : "rgba(34,197,94,.18)";
  const br = kind === "error" ? "rgba(239,68,68,.45)" : "rgba(34,197,94,.40)";
  item.style.cssText = [
    "padding:10px 12px",
    "border-radius:12px",
    "background:" + bg,
    "border:1px solid " + br,
    "backdrop-filter:blur(8px)",
    "color:#fff",
    "box-shadow:0 10px 30px rgba(0,0,0,.28)",
    "font-weight:800",
    "line-height:1.25"
  ].join(";");
  item.textContent = String(title || "");
  box.appendChild(item);
  setTimeout(()=>{ try{ item.remove(); }catch(_){ } }, 2400);
}

function toast(title, icon="success"){
  // Importante: SweetAlert2 solo permite un modal activo; un "toast" de Swal puede cerrar el modal actual.
  // Así que siempre usamos un toast propio (DOM) para no romper el flujo.
  _plainToast(title, icon);
}

// Sonido de caja registradora al agendar/confirmar (best-effort).
let _cashCtx = null;
function unlockCashRegisterSound(){
  try{
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;
    if (!_cashCtx) _cashCtx = new Ctx();
    try{ _cashCtx.resume?.(); }catch(_){ }
  }catch(_){}
}
function playCashRegisterSound(){
  try{
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;
    if (!_cashCtx) _cashCtx = new Ctx();
    const ctx = _cashCtx;
    const now = ctx.currentTime || 0;
    const mkTone = (freq, start, dur, gain) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = "square";
      o.frequency.setValueAtTime(freq, start);
      g.gain.setValueAtTime(0.0001, start);
      g.gain.exponentialRampToValueAtTime(gain, start + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
      o.connect(g).connect(ctx.destination);
      o.start(start);
      o.stop(start + dur + 0.02);
    };
    mkTone(880, now + 0.00, 0.10, 0.08);
    mkTone(1320, now + 0.08, 0.12, 0.06);
    mkTone(660, now + 0.16, 0.18, 0.05);
  }catch(_){}
}

(function themeBootstrap(){
  try{
    const mode = localStorage.getItem("gd_theme") || "dark";
    document.documentElement.classList.toggle("light", mode==="light");
  }catch(_){}
  window.addEventListener("message", (ev)=>{
    if (ev.data && ev.data.type === "theme"){
      document.documentElement.classList.toggle("light", ev.data.mode === "light");
    }
  });
})();

// Hosting: el CRM corre bajo /crm (no siempre hay rewrite desde /).
// Para evitar 404 por rutas absolutas, prefijamos automáticamente con /crm cuando aplica.
const API_BASE = (() => {
  try{
    const p = String(location.pathname || "");
    const host = String(location.hostname || "").toLowerCase();
    const isLocal = (host === "127.0.0.1" || host === "localhost");

    // Producción: los HTML suelen abrirse bajo `/web/...` pero el API vive bajo `/crm/...`.
    if (!isLocal && (p.includes("/crm/") || p.startsWith("/web/"))) return "/crm";

    // Fallback seguro en prod (evita /tools/... y /leads/... sin /crm)
    if (!isLocal) return "/crm";

    // Local dev
    return p.includes("/crm/") ? "/crm" : "";
  }catch(_){
    return "";
  }
})();
function apiURL(url){
  const u = String(url || "");
  if (!u) return u;
  if (/^https?:\/\//i.test(u)) return u;
  if (u.startsWith("/crm/")) return u;
  if (u.startsWith("/")) return API_BASE + u;
  return API_BASE + "/" + u;
}

async function apiJSON(url, opts={}){
  const r = await fetch(apiURL(url), { ...opts, headers: authHeaders(opts.headers || {}) });
  const ct = (r.headers.get("content-type") || "").toLowerCase();
  const txt = await r.text();

  let data = null;
  try{ data = txt ? JSON.parse(txt) : null; }
  catch(_){
    throw new Error(`Respuesta NO JSON en ${apiURL(url)} (${r.status}). Content-Type=${ct}. Primeros 200 chars:\n${txt.slice(0,200)}`);
  }

  if (r.status === 401){
    try{ window.parent?.postMessage({type:"auth:expired"}, "*"); }catch(_){}
    throw new Error("401 No autorizado (token vencido o inválido).");
  }

  if (!r.ok){
    const detail = (data && typeof data==="object" && data.detail) ? data.detail : data;
    throw new Error(`${r.status} ${typeof detail==="string" ? detail : JSON.stringify(detail)}`);
  }
  return data;
}

/* ========= Normalizadores ========= */
function escapeHtml(s){
  return String(s ?? "").replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
  }[c]));
}

// ===== OCR (PDF imagen/escaneado) en el navegador =====
// Nota: lo cargamos on-demand para no impactar rendimiento normal.
const __scriptOnce = new Map();
function loadScriptRaw(src){
  return new Promise((resolve, reject) => {
    const el = document.createElement("script");
    el.src = src;
    el.async = true;
    el.onload = () => resolve(true);
    el.onerror = () => reject(new Error("No pude cargar: " + src));
    document.head.appendChild(el);
  });
}
async function loadScriptFirstAvailable(key, sources){
  if (__scriptOnce.has(key)) return __scriptOnce.get(key);
  const p = (async ()=>{
    let lastErr = null;
    for (const src of (sources || [])){
      try{
        await loadScriptRaw(src);
        return true;
      }catch(err){
        lastErr = err;
      }
    }
    throw lastErr || new Error("No pude cargar script");
  })();
  __scriptOnce.set(key, p);
  return p;
}

async function ensurePdfJs(){
  if (window.pdfjsLib?.getDocument) return;
  // Usamos versiones conocidas (evitamos 404). Probamos varios CDNs por si hay bloqueo/CSP.
  const v = "3.11.174";
  await loadScriptFirstAvailable("pdfjs", [
    `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${v}/pdf.min.js`,
    `https://cdn.jsdelivr.net/npm/pdfjs-dist@${v}/build/pdf.min.js`,
    `https://unpkg.com/pdfjs-dist@${v}/build/pdf.min.js`,
  ]);
  if (window.pdfjsLib?.GlobalWorkerOptions){
    // Importante: el worker también puede fallar; probamos el 1ero que funcione.
    window.pdfjsLib.GlobalWorkerOptions.workerSrc =
      `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${v}/pdf.worker.min.js`;
  }
}

async function ensureTesseract(){
  if (window.Tesseract?.recognize) return;
  await loadScriptFirstAvailable("tesseract", [
    "https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js",
    "https://unpkg.com/tesseract.js@5/dist/tesseract.min.js",
  ]);
}

function guessItemsFromOcrText(raw){
  const out = [];
  const seen = new Set();
  const text = String(raw || "").replace(/\r/g, "\n");
  const lines = text
    .split("\n")
    .map(l => l.trim())
    .filter(Boolean)
    // normaliza espacios y OCR raro
    .map(l => l.replace(/\s{2,}/g, " "));

  // 1) Heurística de tabla tipo Camaleón (fecha -> producto -> cantidad (columna) -> total).
  const rxDate = /(LUNES|MARTES|MIERCOLES|MIÉRCOLES|JUEVES|VIERNES|SABADO|SÁBADO|DOMINGO)\s+(\d{1,2})\s+([A-ZÑ]+)\s+(\d{4})/i;
  const isNoise = (l) => /DETALLE DE PRODUCTOS|CANTIDAD|TOTAL|PORTADA|TERMINOS|T[ÉE]RMINOS/i.test(l);
  const isExtra = (l) => /TRASLADOS|MONTAJE|DESMONTAJE|PERSONAL/i.test(l);
  const isMoneyLike = (l) => /\$/.test(l) || /\b\d{1,3}(?:\.\d{3})+\b/.test(l);
  const parseMoney = (l) => {
    const m = String(l).match(/(\d{1,3}(?:\.\d{3})+|\d+)/);
    if (!m) return null;
    const n = Number(m[1].replace(/\./g, ""));
    return Number.isFinite(n) ? n : null;
  };
  const parseQty = (l) => {
    if (!/^\d{1,5}$/.test(l)) return null;
    const n = Number(l);
    if (!Number.isFinite(n) || n <= 0) return null;
    // cantidad razonable
    if (n > 50000) return null;
    return n;
  };
  const isProductLine = (l) => {
    if (isNoise(l) || isExtra(l)) return false;
    if (l.length <= 3) return false;
    // típicamente: "Helados SOFT: barquillo, sabor..."
    if (/:/.test(l) && /[A-Za-zÁÉÍÓÚÑ]/.test(l)) return true;
    // fallback: texto con "HELADOS" etc
    if (/HELADOS|SOFT/i.test(l) && /[A-Za-zÁÉÍÓÚÑ]/.test(l)) return true;
    return false;
  };

  let currentDate = "";
  for (let i = 0; i < lines.length; i++){
    const line = lines[i];
    if (!line) continue;
    const dm = line.match(rxDate);
    if (dm){
      // ejemplo: "MIERCOLES 11 FEBRERO 2026"
      currentDate = `${dm[1]} ${dm[2]} ${dm[3]} ${dm[4]}`.toUpperCase().replace("MIÉRCOLES","MIERCOLES").replace("SÁBADO","SABADO");
      continue;
    }
    if (!isProductLine(line)) continue;

    // Producto: sacamos solo el título antes de ":" si existe, para no guardar la descripción larga.
    let productoBase = line;
    if (productoBase.includes(":")){
      productoBase = productoBase.split(":")[0].trim();
    }
    productoBase = productoBase.replace(/\s{2,}/g, " ").trim();
    if (!productoBase) continue;

    // Busca cantidad y total en las próximas líneas (la tabla suele traer "90", "$", "175.000")
    let qty = null;
    let total = null;
    let sawDollar = false;

    // Caso frecuente OCR: "Producto ... 65 $ 165" en la misma línea.
    // Si hay $, nos quedamos con el lado izquierdo para no confundir monto con cantidad.
    const leftNoMoney = (line.includes("$") ? line.split("$")[0] : line).trim();
    const mInline = leftNoMoney.match(/\b(\d{1,4})\b/);
    if (mInline){
      const inline = Number(mInline[1]);
      if (Number.isFinite(inline) && inline > 0 && inline < 500){
        qty = inline;
      }
    }

    for (let j = i + 1; j < Math.min(lines.length, i + 10); j++){
      const l2 = lines[j];
      if (!l2) continue;
      if (l2.match(rxDate)) break;
      if (isProductLine(l2) && !isExtra(l2)) break;

      const q = parseQty(l2);
      if (q != null && qty == null){
        qty = q;
        continue;
      }

      if (l2 === "$"){ sawDollar = true; continue; }
      if ((sawDollar || isMoneyLike(l2)) && total == null){
        const mny = parseMoney(l2);
        if (mny != null && mny >= 1000){
          total = mny;
          continue;
        }
      }
    }

    if (qty != null){
      const producto = currentDate ? `${productoBase} (${currentDate})` : productoBase;
      const key = (producto + "|" + qty).toUpperCase();
      if (!seen.has(key)){
        seen.add(key);
        out.push({ producto, cantidad: qty, _total: total || null });
      }
    }
    if (out.length >= 40) break;
  }

  // Limpieza final: fuera basura típica OCR
  const cleaned = out.filter(it => {
    const p = String(it.producto || "").trim();
    if (!p || p.length < 4) return false;
    if (/TOTAL|SUBTOTAL|NETO|IVA|VALIDEZ|D[IÍ]AS|H[ÁA]BILES|PEDIDO/i.test(p)) return false;
    return true;
  });
  if (cleaned.length) return cleaned;

  // 2) Fallback simple: "PRODUCTO .... 2" (número al final)
  const rx = /^(.+?)\s+(\d+(?:[.,]\d+)?)\s*$/;
  for (const line of lines){
    const m = line.match(rx);
    if (!m) continue;
    let producto = (m[1] || "").trim();
    const cantidad = Number(String(m[2] || "").replace(",", "."));
    if (!producto || !Number.isFinite(cantidad) || cantidad <= 0) continue;
    // Evita años/fechas/ruido
    if (cantidad >= 1900) continue;        // 2026, etc
    if (cantidad > 500) continue;          // totales/montos no son qty
    if (/\$/.test(producto)) continue;
    if (/TOTAL|SUBTOTAL|NETO|IVA|VALIDEZ|D[IÍ]AS|H[ÁA]BILES|PEDIDO/i.test(producto)) continue;
    if (/(LUNES|MARTES|MIERCOLES|MIÉRCOLES|JUEVES|VIERNES|SABADO|SÁBADO|DOMINGO)\b/i.test(producto)) continue;
    producto = producto.replace(/\s{2,}/g, " ").replace(/[-–—]+$/g, "").trim();
    const key = (producto + "|" + cantidad).toUpperCase();
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({ producto, cantidad });
    if (out.length >= 80) break;
  }
  return out;
}

async function ocrPdfToText({ url, headers, maxPages=2, onProgress }){
  await ensurePdfJs();
  await ensureTesseract();

  const task = window.pdfjsLib.getDocument({ url, httpHeaders: headers || {} });
  const pdf = await task.promise;
  const total = Math.min(maxPages, pdf.numPages || maxPages);
  let all = "";

  for (let i=1; i<=total; i++){
    onProgress && onProgress({ phase:"render", page:i, total });
    const page = await pdf.getPage(i);
    const viewport = page.getViewport({ scale: 2 });
    const canvas = document.createElement("canvas");
    canvas.width = Math.floor(viewport.width);
    canvas.height = Math.floor(viewport.height);
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    await page.render({ canvasContext: ctx, viewport }).promise;

    onProgress && onProgress({ phase:"ocr", page:i, total });
    const r = await window.Tesseract.recognize(canvas, "spa", {
      logger: (m) => {
        if (m?.status === "recognizing text"){
          onProgress && onProgress({ phase:"ocr", page:i, total, pct: m.progress });
        }
      }
    });
    all += "\n" + (r?.data?.text || "");
  }

  return { text: all, pages: total };
}

// Igual que ocrPdfToText, pero usando un PDF local (File) sin depender del servidor.
async function ocrPdfToTextFromFile(file, { maxPages=2, onProgress } = {}){
  await ensurePdfJs();
  await ensureTesseract();

  const buf = await file.arrayBuffer();
  const task = window.pdfjsLib.getDocument({ data: buf });
  const pdf = await task.promise;
  const total = Math.min(maxPages, pdf.numPages || maxPages);
  let all = "";

  for (let i=1; i<=total; i++){
    onProgress && onProgress({ phase:"render", page:i, total });
    const page = await pdf.getPage(i);
    const viewport = page.getViewport({ scale: 2 });
    const canvas = document.createElement("canvas");
    canvas.width = Math.floor(viewport.width);
    canvas.height = Math.floor(viewport.height);
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    await page.render({ canvasContext: ctx, viewport }).promise;

    onProgress && onProgress({ phase:"ocr", page:i, total });
    const r = await window.Tesseract.recognize(canvas, "spa", {
      logger: (m) => {
        if (m?.status === "recognizing text"){
          onProgress && onProgress({ phase:"ocr", page:i, total, pct: m.progress });
        }
      }
    });
    all += "\n" + (r?.data?.text || "");
  }

  return { text: all, pages: total };
}
function fmtDate(iso){
  if (!iso) return "-";
  try{
    const s = String(iso).trim();
    // Evita el desfase de zona horaria para fechas sin hora (YYYY-MM-DD)
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
    if (m){
      const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
      return new Intl.DateTimeFormat("es-CL",{year:"numeric",month:"2-digit",day:"2-digit"}).format(d);
    }
    const d = new Date(s);
    if (isNaN(d.getTime())) return s.slice(0,10);
    return new Intl.DateTimeFormat("es-CL",{year:"numeric",month:"2-digit",day:"2-digit"}).format(d);
  }catch{ return String(iso).slice(0,10); }
}
function money(n){
  const v = Number(n || 0);
  if (!v) return "-";
  try{ return v.toLocaleString("es-CL",{style:"currency",currency:"CLP",maximumFractionDigits:0}); }
  catch{ return "$" + Math.round(v).toLocaleString("es-CL"); }
}

function parseAnyDate(v){
  if (!v) return null;
  try{
    const s = String(v).trim();
    const s10 = s.slice(0,10);
    let m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s10);
    if (m){
      const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
      return isNaN(d.getTime()) ? null : d;
    }
    m = /^(\d{4})\/(\d{2})\/(\d{2})$/.exec(s10);
    if (m){
      const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
      return isNaN(d.getTime()) ? null : d;
    }
    m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(s10);
    if (m){
      const d = new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1]));
      return isNaN(d.getTime()) ? null : d;
    }
    m = /^(\d{2})-(\d{2})-(\d{4})$/.exec(s10);
    if (m){
      const d = new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1]));
      return isNaN(d.getTime()) ? null : d;
    }
    const d = new Date(s);
    return isNaN(d.getTime()) ? null : d;
  }catch(_){
    return null;
  }
}

function daysBetween(a, b){
  try{
    const ms = (a.getTime() - b.getTime());
    return Math.floor(ms / 86400000);
  }catch(_){
    return 0;
  }
}

function followupFlagInfo(lead, estadoUpper=""){
  if (isClosedEstadoName(estadoUpper)) return null;
  const last =
    parseAnyDate(lead?.seguimiento_at) ||
    parseAnyDate(lead?.followup_at) ||
    parseAnyDate(lead?.created_at) ||
    parseAnyDate(lead?.fecha_ingreso) ||
    new Date();
  const now = new Date();
  const d = Math.max(0, daysBetween(now, last));
  if (d >= 4) return { cls:"red", title:`Seguimiento: ${d} días` };
  if (d >= 1) return { cls:"yellow", title:`Seguimiento: ${d} día(s)` };
  return { cls:"green", title:"Seguimiento: al día" };
}

function montoDotInfo(lead){
  const v = Number(lead?.monto_cotizado || 0);
  if (!isFinite(v) || v < 100000) return null;
  if (v <= 399999) return { cls:"red", title:"Monto: 100k–399k" };
  if (v <= 699999) return { cls:"yellow", title:"Monto: 400k–699k" };
  return { cls:"green", title:"Monto: ≥700k" };
}

function urgenciaDotInfo(lead, estadoNombreUpper){
  if (!estadoNombreUpper || !String(estadoNombreUpper).includes("CONTACT")) return null;
  const dEv = parseAnyDate(lead?.fecha_evento);
  if (!dEv) return null;
  const now = new Date();
  const daysTo = Math.ceil((dEv.getTime() - now.getTime()) / 86400000);
  if (daysTo < 3) return { cls:"red", title:`Vence en ${daysTo} día(s)` };
  if (daysTo <= 5) return { cls:"green", title:`Vence en ${daysTo} día(s)` };
  return { cls:"yellow", title:`Vence en ${daysTo} día(s)` };
}

function calendarioInfo(lead, estadoUpper=""){
  const dEv = parseAnyDate(lead?.fecha_evento);
  if (isClosedEstadoName(estadoUpper)){
    // Mantener fecha visible, pero sin colores/alertas.
    return dEv ? { cls:"", title:"", daysTo: null, label:"" } : { cls:"", title:"", daysTo: null, label:"" };
  }
  if (!dEv) return { cls:"yellow", title:"Sin fecha de evento", daysTo:null, label:"SIN FECHA" };
  const now = new Date();
  const daysTo = Math.ceil((dEv.getTime() - now.getTime()) / 86400000);
  if (!isFinite(daysTo)) return { cls:"", title:"", daysTo:null, label:"" };
  if (daysTo < 0) return { cls:"red", title:`Evento vencido hace ${Math.abs(daysTo)} día(s)`, daysTo, label:"VENCIDO" };
  if (daysTo === 0) return { cls:"red", title:"Evento es hoy", daysTo, label:"HOY" };
  if (daysTo <= 3) return { cls:"yellow", title:`Vence en ${daysTo} día(s)`, daysTo, label:"PRONTO" };
  if (daysTo <= 7) return { cls:"green", title:`Vence en ${daysTo} día(s)`, daysTo, label:"OK" };
  return { cls:"gray", title:`Vence en ${daysTo} día(s)`, daysTo, label:"" };
}
function mapBy(arr, key){
  const m = new Map();
  for (const x of (arr||[])) m.set(x[key], x);
  return m;
}

function isInSelectedMonth(lead){
  const raw = lead?.fecha_evento;
  if (!raw) return false;
  const d = parseAnyDate(raw);
  if (!d) return false;
  return d.getFullYear() === FILTER_YEAR && (d.getMonth() + 1) === FILTER_MONTH_NUMBER;
}

function computeMonthTotal(){
  MONTH_TOTAL = LEADS.filter(isInSelectedMonth).length;
  const mb = qs("#monthBadge");
  if (mb){
    const label = new Date(FILTER_YEAR, FILTER_MONTH_NUMBER - 1, 1).toLocaleString("es-CL",{month:"long",year:"numeric"});
    mb.textContent = `${label}: ${MONTH_TOTAL}`;
  }
}

function computeHighlightIds(){
  HIGHLIGHT_IDS = new Set();
  const maxId = LEADS.reduce((m, l)=>Math.max(m, Number(l.id_lead||0)), 0);
  const prev = Number(localStorage.getItem(LAST_LEAD_KEY) || "0");
  const force = new URLSearchParams(location.search).get("highlight") === "new";

  if (!prev && !force){
    if (maxId) localStorage.setItem(LAST_LEAD_KEY, String(maxId));
    return;
  }

  let candidates = LEADS.slice().sort((a,b)=>(Number(b.id_lead||0)-Number(a.id_lead||0)));
  if (prev){
    candidates = candidates.filter(l => Number(l.id_lead||0) > prev);
  }
  // limita para no destacar demasiados
  candidates = candidates.slice(0, 10);
  for (const l of candidates) HIGHLIGHT_IDS.add(Number(l.id_lead||0));
  if (maxId) localStorage.setItem(LAST_LEAD_KEY, String(maxId));
}

function normEstado(e){
  return {
    id_estado: Number(e.id_estado),
    nombre: e.nombre ?? e.estado ?? String(e.id_estado),
    color: e.color || "#64748b",
    orden: Number(e.orden ?? 999),
    is_active: (e.is_active === undefined) ? true : !!e.is_active
  };
}
function normMarca(m){
  return {
    id_marca: Number(m.id_marca),
    nombre: m.nombre ?? m.marca ?? String(m.id_marca),
    is_active: (m.is_active === undefined) ? true : !!m.is_active,
    logo_path: m.logo_path || ""
  };
}
function normComuna(c){
  return {
    id_comuna: Number(c.id_comuna),
    nombre: c.nombre ?? c.comuna ?? String(c.id_comuna),
    is_active: (c.is_active === undefined) ? true : !!c.is_active,
    neto: c.neto, bruto: c.bruto, costo_traslado: c.costo_traslado
  };
}
function normTipo(t){
  return {
    id_tipo_cliente: Number(t.id_tipo_cliente ?? t.id ?? 0),
    nombre: t.nombre ?? t.tipo ?? t.descripcion ?? String(t.id_tipo_cliente ?? t.id ?? ""),
    is_active: (t.is_active === undefined) ? true : !!t.is_active
  };
}

function normLead(l){
  // tu backend devuelve: cliente, marca, comuna, estado_nombre/estado_color...
  return {
    id_lead: Number(l.id_lead),
    cliente: l.cliente ?? l.nombre_cliente ?? "",
    email: l.email ?? "",
    telefono: l.telefono ?? "",
    direccion: l.direccion ?? "",
    id_marca: Number(l.id_marca ?? 0),
    id_estado: Number(l.id_estado ?? 0),
    id_comuna: Number(l.id_comuna ?? 0),
    fecha_evento: l.fecha_evento ?? null,
    fecha_ingreso: l.fecha_ingreso ?? null,
    seguimiento_at: l.seguimiento_at ?? null,
    monto_cotizado: Number(l.monto_cotizado ?? 0),
    plataforma: l.plataforma ?? null,
    notas: l.notas ?? null,
    codigo_cliente: l.codigo_cliente ?? null,
    id_tipo_cliente: l.id_tipo_cliente ?? null,
    num_cotizacion: l.num_cotizacion ?? l.numero_cotizacion ?? null,
    cotizacion_pdf_url: l.cotizacion_pdf_url ?? null,
    id_cotizacion_vigente: l.id_cotizacion_vigente ?? null,
    calendar_event_id: l.calendar_event_id ?? null,
    calendar_html_link: l.calendar_html_link ?? null,
    agenda_approved_at: l.agenda_approved_at ?? null,
    agenda_approved_by: l.agenda_approved_by ?? null,
    pre_start: l.pre_start ?? null,
    pre_end: l.pre_end ?? null,
    calendar_start: l.calendar_start ?? null,
    calendar_end: l.calendar_end ?? null,
    hora_inicio: l.hora_inicio ?? null,
    hora_fin: l.hora_fin ?? null,
    created_at: l.created_at ?? null,
    updated_at: l.updated_at ?? null,

    marca_nombre: l.marca ?? l.marca_nombre ?? null,
    comuna_nombre: l.comuna ?? l.comuna_nombre ?? null,
    estado_nombre: l.estado ?? l.estado_nombre ?? null,
    estado_color: l.color ?? l.estado_color ?? null,
  };
}

/* ========= App state ========= */
let VIEW = "kanban";
let CATS = { marcas:[], comunas:[], estados:[], tipos:[], plataformas:[] };
let LEADS = [];
let FILTER_MONTH = true;
let FILTER_YEAR = new Date().getFullYear();
let FILTER_MONTH_NUMBER = new Date().getMonth() + 1;
let MONTH_TOTAL = 0;
let HIGHLIGHT_IDS = new Set();
let STALE_IDS = null;
let PENDING_OPEN_ID = null;
let QUERY_LEAD_OPENED = false;

const MONTH_FILTER_KEY = "gd_leads_month_filter";
const MONTH_VALUE_KEY = "gd_leads_selected_month";
const LAST_LEAD_KEY = "gd_last_lead_id";

function loadPrefs(){
  const params = new URLSearchParams(location.search);
  const forceAll = params.get("all") === "1" || params.get("todos") === "1";
  FILTER_MONTH = forceAll ? false : localStorage.getItem(MONTH_FILTER_KEY) !== "0";
  const now = new Date();
  const requested = params.get("month") || localStorage.getItem(MONTH_VALUE_KEY) || `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}`;
  const match = /^(\d{4})-(\d{2})$/.exec(requested);
  if (match && Number(match[2]) >= 1 && Number(match[2]) <= 12){
    FILTER_YEAR = Number(match[1]);
    FILTER_MONTH_NUMBER = Number(match[2]);
  }
  if (IS_MOBILE) VIEW = "table";
}
function savePrefs(){
  localStorage.setItem(MONTH_FILTER_KEY, FILTER_MONTH ? "1" : "0");
  localStorage.setItem(MONTH_VALUE_KEY, `${FILTER_YEAR}-${String(FILTER_MONTH_NUMBER).padStart(2,"0")}`);
}

/* ========= Endpoints reales (con fallback) ========= */
async function tryGetFirstJSON(urls){
  let lastErr = null;
  for (const u of urls){
    try{ return await apiJSON(u); }
    catch(e){ lastErr = e; }
  }
  throw lastErr || new Error("No pude cargar endpoint.");
}

async function loadCatalogos(){
  // 1) marcas/comunas/tipos desde /leads/catalogos (respeta marcas del usuario)
  const cat = await tryGetFirstJSON(["/leads/catalogos", "/catalogos", "/cotizador/catalogos"]);

  const marcasRaw = (cat.marcas || cat.items?.marcas || []);
  const comunasRaw = (cat.comunas || cat.items?.comunas || []);
  const tiposRaw  = (cat.tipos_cliente || cat.tipos || []);
  const plataformasRaw = (cat.plataformas || cat.platforms || cat.items?.plataformas || []);

  let marcas = (marcasRaw||[]).map(normMarca).filter(x=>x.is_active);
	  // extra: filtra marcas por usuario (SUPERADMIN es el único global)
	  try{
	    const GD = window.parent && window.parent.GD;
	    const me = GD?.me;
	    const role = (me?.role || me?.rol || "").toString().toUpperCase();
	    const isSuper = role.includes("SUPERADMIN") || role.includes("SUPER_ADMIN") || role.includes("SUPER ADMIN");
	    const userMarcas = (me?.marcas || []).map(m => Number(m)).filter(n => Number.isFinite(n));
	    // ADMIN ahora es acotado por marcas (si el token trae marcas).
	    if (!isSuper && userMarcas.length){
	      marcas = marcas.filter(m => userMarcas.includes(Number(m.id_marca)));
	    }
	  }catch(_){}
  let comunas = (comunasRaw||[]).map(normComuna).filter(x=>x.is_active);

  // si no trajo comunas, intentamos endpoints alternativos (si existen)
  if (!comunas.length){
    try{
      const c2 = await tryGetFirstJSON(["/comunas?limit=500", "/settings/comunas?limit=500&active_only=true"]);
      const items = Array.isArray(c2) ? c2 : (c2.items || []);
      comunas = (items||[]).map(normComuna).filter(x=>x.is_active);
    }catch(_){}
  }

  // 2) estados: endpoint real (con fallback). Importante:
  // En producción han existido catálogos donde estados "cerrados" o poco usados quedan is_active=false,
  // pero igual deben aparecer para poder mover leads (drag&drop / cambios de estado).
  let est = null;
  try{
    est = await apiJSON("/lead-estados");
  }catch(_){
    // compat antigua
    try{ est = await apiJSON("/settings/estados_lead"); }catch(__){}
  }
  // fallback final: algunos deployments anidan `catalogos.estados` en /leads/catalogos
  const estadosRaw =
    (est && (est.items || est.estados || est)) ||
    (cat && (cat.estados || cat.catalogos?.estados || cat.items?.estados)) ||
    [];
  const estados = (Array.isArray(estadosRaw) ? estadosRaw : [])
    .map(normEstado)
    .sort((a,b)=>a.orden-b.orden);

  // 3) tipos: opcional
  const tipos = (tiposRaw||[]).map(normTipo).filter(x=>x.is_active);
  const plataformas = (plataformasRaw||[])
    .map((p,i)=>({
      id_plataforma: Number(p.id_plataforma || p.id || i + 1),
      nombre: String(p.nombre || p.plataforma || p.canal || "").trim().toUpperCase(),
      is_active: p.is_active !== false,
      orden: Number(p.orden || i + 1)
    }))
    .filter(x=>x.nombre && x.is_active)
    .sort((a,b)=>a.orden-b.orden || a.nombre.localeCompare(b.nombre, "es"));

  CATS = { marcas, comunas, estados, tipos, plataformas };
}

async function loadLeads(){
  // Auditoría abre un lead puntual en modal: cargar por ID aunque esté fuera del mes actual.
  try{
    const params = new URLSearchParams(location.search);
    const focusId = params.get("audit_focus") === "1"
      ? (params.get("open_lead") || params.get("id_lead") || params.get("lead_id"))
      : "";
    if (focusId){
      const r = await tryGetFirstJSON([`/leads/by_ids?ids=${encodeURIComponent(String(focusId))}`]);
      const items = Array.isArray(r) ? r : (r.items || []);
      LEADS = (items||[]).map(normLead);
      computeMonthTotal();
      computeHighlightIds();
      return;
    }
  }catch(_){}

  // Optimización: cuando venimos de drilldown (stale_ids), traemos solo esos leads.
  try{
    const params = new URLSearchParams(location.search);
    const rawIds = (params.get("stale_ids") || "").trim();
    const ids = rawIds ? rawIds.split(",").map(x=>x.trim()).filter(Boolean) : [];
    if (ids.length && ids.length <= 450){
      const r = await tryGetFirstJSON([`/leads/by_ids?ids=${encodeURIComponent(ids.join(","))}`]);
      const items = Array.isArray(r) ? r : (r.items || []);
      LEADS = (items||[]).map(normLead);
      computeMonthTotal();
      computeHighlightIds();
      return;
    }
  }catch(_){}

  const monthQS = `month=${FILTER_MONTH_NUMBER}&year=${FILTER_YEAR}&include_no_date=0`;
  const urls = FILTER_MONTH
    ? [`/leads?limit=5000&${monthQS}`, `/leads?limit=1000&${monthQS}`, `/leads?limit=300&${monthQS}`, `/leads?limit=50&${monthQS}`]
    : ["/leads?limit=5000&all=1", "/leads?limit=1000&all=1", "/leads?limit=300&all=1", "/leads?limit=50&all=1"];
  const raw = await tryGetFirstJSON(urls);
  const items = Array.isArray(raw) ? raw : (raw.items || raw.leads || []);
  LEADS = (items||[]).map(normLead);
  computeMonthTotal();
  computeHighlightIds();
}

function openLeadFromQuery(){
  const params = new URLSearchParams(location.search);
  const id = params.get("open_lead") || params.get("id_lead") || params.get("lead_id");
  if (!id || QUERY_LEAD_OPENED) return;
  const lead = LEADS.find(x => String(x.id_lead) === String(id));
  if (lead){
    QUERY_LEAD_OPENED = true;
    const editConfirmed = params.get("edit_confirmed") === "1";
    if (editConfirmed){
      setTimeout(() => openConfirmedEventEditor(lead), 120);
    }else{
      setTimeout(() => openEditModal(lead), 120);
    }
  }else if (params.get("audit_focus") === "1"){
    setTimeout(openLeadFromQuery, 350);
  }
}
function loadStaleFilterFromQuery(){
  const params = new URLSearchParams(location.search);
  const raw = params.get("stale_ids");
  if (!raw) return;
  const ids = raw.split(",").map(x => x.trim()).filter(Boolean);
  if (ids.length){
    STALE_IDS = new Set(ids);
    FILTER_MONTH = false;
  }
}

function isAuditFocusMode(){
  try{
    return new URLSearchParams(location.search).get("audit_focus") === "1";
  }catch(_){
    return false;
  }
}

/* ========= View ========= */
function setView(v){
  VIEW = v;
  qs("#btnKanban").classList.toggle("active", v==="kanban");
  qs("#btnTable").classList.toggle("active", v==="table");
  qs("#kanbanView").style.display = v==="kanban" ? "" : "none";
  qs("#tableView").style.display = v==="table" ? "" : "none";
  render();
  openLeadFromQuery();
}

function getFilteredLeads(){
	  const t = (qs("#q").value || "").trim().toLowerCase();
	  let base = FILTER_MONTH ? LEADS.filter(isInSelectedMonth) : LEADS.slice();
    try{
      const params = new URLSearchParams(location.search);
      const focusId = params.get("audit_focus") === "1"
        ? (params.get("open_lead") || params.get("id_lead") || params.get("lead_id"))
        : "";
      if (focusId){
        base = base.filter(l => String(l.id_lead) === String(focusId));
      }
    }catch(_){}
	  if (STALE_IDS && STALE_IDS.size){
    base = base.filter(l => STALE_IDS.has(String(l.id_lead)));
  }
	  if (!t) return base;

  const mMarca = mapBy(CATS.marcas,"id_marca");
  const mComuna = mapBy(CATS.comunas,"id_comuna");

  return base.filter(l=>{
    const marca = l.marca_nombre || (mMarca.get(l.id_marca)||{}).nombre || "";
    const comuna = l.comuna_nombre || (mComuna.get(l.id_comuna)||{}).nombre || "";
    const blob = [
      l.id_lead, l.cliente, l.codigo_cliente, l.email, l.telefono,
      l.direccion, l.plataforma, l.notas,
      marca, comuna, l.estado_nombre, l.estado
    ].filter(Boolean).join(" ").toLowerCase();
    return blob.includes(t);
  });
}

function _estadoIdByNameIncludes(substrUpper){
  const s = String(substrUpper || "").toUpperCase();
  const hit = (CATS.estados || []).find(e => String(e?.nombre || e?.estado || "").toUpperCase().includes(s));
  return hit ? Number(hit.id_estado) : null;
}
function _declinadoId(){ return _estadoIdByNameIncludes("DECLIN"); }
function _contactadoId(){ return _estadoIdByNameIncludes("CONTACT"); }

function getDeclinados(all=false){
  const did = _declinadoId();
  if (!did) return [];
  const base = all ? (LEADS || []) : getFilteredLeads();
  return (base || []).filter(l => Number(l.id_estado||0) === Number(did));
}

	function render(){
	  clearError();
	  const list = getFilteredLeads();
	  const total = LEADS.length;
	  const baseTotal = FILTER_MONTH ? MONTH_TOTAL : total;
	  qs("#leadCount").textContent = `Mostrando ${list.length} / ${baseTotal}`;
	  qs("#btnAllMonths").classList.toggle("active", !FILTER_MONTH);
    try{
      const d = getDeclinados(true).length;
      qs("#trashCount").textContent = String(d || 0);
    }catch(_){}

	  // columnas visibles (no contamos DECLINADO porque va al basurero 🗑️)
    const did = _declinadoId();
    const visibleStates = (CATS.estados||[]).filter(s => !(did && Number(s.id_estado) === Number(did)));
	  qs("#kanbanView").style.setProperty("--cols", String(Math.max(1, visibleStates.length)));

	  if (VIEW==="kanban") renderKanban(list, visibleStates);
	  else renderTable(list);
	}

/* ========= Icons ========= */
function svgIcon(name){
  const icons = {
    edit: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',
    phone:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9a16 16 0 0 0 7 7l.6-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',
    wa:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.6A8.4 8.4 0 0 1 7.7 19L4 20l1-3.5A8.4 8.4 0 1 1 20 11.6Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8.5 9.5c.3-1 1-1 1.4-1h.4c.3 0 .6.1.7.4l.7 1.7c.1.3.1.6-.1.8l-.5.6c-.2.2-.2.5 0 .8.6 1.1 1.5 1.9 2.6 2.5.3.2.6.2.8 0l.6-.5c.2-.2.5-.2.8-.1l1.7.7c.3.1.4.4.4.7v.4c0 .4 0 1.1-1 1.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    msg:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 8h10M7 12h7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
    quote:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10M7 11h10M7 15h7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M6 3h12a2 2 0 0 1 2 2v14l-4-2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',
  };
  return icons[name] || "";
}

function flagIconHTML(flag){
  if (!flag) return "";
  const clsRaw = String(flag.cls || "gray").trim().toLowerCase();
  const cls = ["red","blue","yellow","green","gray"].includes(clsRaw) ? clsRaw : "gray";
  const title = escapeHtml(flag.title || "");
  // "Banderita" real (no rectángulo), usando CSS .flag + clip-path.
  return `<span class="flag ${cls}" title="${title}" role="img" aria-label="${title}"></span>`;
}

async function openDeclinadosTrash(){
  const did = _declinadoId();
  if (!did){
    toast("No encontré estado DECLINADO", "warning");
    return;
  }
  const items = (LEADS||[]).filter(l => Number(l.id_estado||0) === Number(did));
  const contactadoId = _contactadoId();
  const norm = (v)=> String(v||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"");
  items.sort((a,b)=> norm(a.cliente).localeCompare(norm(b.cliente), "es"));
  const rows = items.map(l=>`
    <tr>
      <td><strong>${escapeHtml(l.cliente||"—")}</strong><div class="muted">#${escapeHtml(l.id_lead||"")}</div></td>
      <td class="muted">${escapeHtml(l.marca_nombre||"")}</td>
      <td class="muted">${escapeHtml(l.comuna_nombre||"")}</td>
      <td class="muted">${escapeHtml(fmtDate(l.fecha_evento)||"—")}</td>
      <td class="muted">${escapeHtml(money(l.monto_cotizado)||"—")}</td>
      <td style="text-align:right; white-space:nowrap">
        <button class="swBtn" data-open="${escapeHtml(l.id_lead||"")}">Ver</button>
        ${contactadoId ? `<button class="swBtn secondary" data-restore="${escapeHtml(l.id_lead||"")}">Restaurar</button>` : ``}
      </td>
    </tr>
  `).join("") || `<tr><td colspan="6" class="muted">No hay declinados.</td></tr>`;

  await Swal.fire({
    title: `🗑️ Declinados (${items.length})`,
    html: `
      <div style="text-align:left;opacity:.8;font-weight:900;margin-bottom:8px">
        Leads declinados (no aparecen en el kanban). Puedes restaurar a CONTACTADO si corresponde.
      </div>
      <div style="max-height:60vh;overflow:auto;border:1px solid var(--border);border-radius:14px">
        <table style="width:100%;border-collapse:collapse;font-size:13px">
          <thead>
            <tr style="position:sticky;top:0;background:var(--surface);border-bottom:1px solid var(--border)">
              <th style="text-align:left;padding:10px">Lead</th>
              <th style="text-align:left;padding:10px">Marca</th>
              <th style="text-align:left;padding:10px">Comuna</th>
              <th style="text-align:left;padding:10px">Evento</th>
              <th style="text-align:left;padding:10px">Monto</th>
              <th style="text-align:right;padding:10px">Acciones</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
    `,
    width: 980,
    showConfirmButton:false,
    showCloseButton:true,
    didOpen: ()=>{
      const box = Swal.getHtmlContainer();
      box?.querySelectorAll("[data-open]").forEach(b=>{
        b.addEventListener("click", ()=>{
          const id = Number(b.getAttribute("data-open")||0);
          const lead = (LEADS||[]).find(x=>Number(x.id_lead)===id);
          if (lead) openEditModal(lead);
        });
      });
      box?.querySelectorAll("[data-restore]").forEach(b=>{
        b.addEventListener("click", async ()=>{
          const id = Number(b.getAttribute("data-restore")||0);
          if (!id || !contactadoId) return;
          const res = await Swal.fire({
            icon:"question",
            title:"¿Restaurar a Contactado?",
            text:"Esto moverá el lead a CONTACTADO.",
            showCancelButton:true,
            confirmButtonText:"Restaurar",
            cancelButtonText:"Cancelar",
          });
          if (!res.isConfirmed) return;
          try{
            await setLeadEstado(id, contactadoId);
            const lead = (LEADS||[]).find(x=>Number(x.id_lead)===id);
            if (lead) lead.id_estado = Number(contactadoId);
            toast("Restaurado", "success");
            render();
          }catch(e){
            toast("No pude restaurar: " + String(e?.message||e), "error");
          }
        });
      });
    }
  });
}
function iconButton(title, iconName, handler){
  const b = document.createElement("button");
  b.type = "button";
  b.className = "iconBtn icon-" + iconName;
  b.title = title;
  b.innerHTML = svgIcon(iconName);
  b.addEventListener("click", handler);
  return b;
}

/* ========= Kanban render ========= */
	function renderKanban(list, statesOverride){
	  const mMarca = mapBy(CATS.marcas,"id_marca");
	  const mComuna = mapBy(CATS.comunas,"id_comuna");
	  const mEstado = mapBy(CATS.estados,"id_estado");

    const STATES = Array.isArray(statesOverride) && statesOverride.length ? statesOverride : (CATS.estados || []);
    const declinadoId = _declinadoId();
	  const by = new Map();
	  for (const st of STATES) by.set(st.id_estado, []);
	  for (const l of list){
	    const sid = l.id_estado ?? 0;
	    if (!by.has(sid)) by.set(sid, []);
	    by.get(sid).push(l);
	  }

	  const root = qs("#kanbanView");
	  root.innerHTML = "";

	  // Basurero: declinados NO se muestran como columna, pero se pueden arrastrar al botón 🗑️.
	  for (const st of STATES){
      if (declinadoId && Number(st.id_estado) === Number(declinadoId)) continue;
	    const col = document.createElement("div");
	    col.className = "column";
	    col.style.setProperty("--col-color", st.color || "transparent");

    const head = document.createElement("div");
    head.className = "colHead";

    const title = document.createElement("div");
    title.className = "colTitle";
    title.textContent = st.nombre || st.estado || st.name || ("Estado " + (st.id_estado ?? ""));

    const count = document.createElement("div");
    count.className = "colCount";
    count.textContent = String((by.get(st.id_estado)||[]).length);

    head.appendChild(title);
    head.appendChild(count);

    const listEl = document.createElement("div");
    listEl.className = "cardList";
    listEl.addEventListener("dragover", (e)=>onDragOver(e, listEl));
    listEl.addEventListener("drop", (e)=>onDrop(e, st.id_estado));

    const arr = (by.get(st.id_estado)||[]).slice().sort((a,b)=>(b.id_lead||0)-(a.id_lead||0));

    for (const l of arr){
      const card = document.createElement("div");
      card.className = "card";
      card.draggable = true;
      if (HIGHLIGHT_IDS.has(Number(l.id_lead||0))){
        card.classList.add("flash");
        setTimeout(()=>card.classList.remove("flash"), 2600);
      }

      card.addEventListener("dragstart", (e)=>onDragStart(e, l.id_lead, card));
      card.addEventListener("dragend", ()=>onDragEnd());

      card.addEventListener("click",(ev)=>{
        if (ev.target?.closest?.("button")) return;
        openEditModal(l);
      });

      const marca = l.marca_nombre || (mMarca.get(l.id_marca)||{}).nombre || "-";
      const comuna = l.comuna_nombre || (mComuna.get(l.id_comuna)||{}).nombre || "-";

      // FICHA CHICA: A + B + iconos + badges (seguimiento/monto/urgencia)
      const row1 = document.createElement("div");
      row1.className = "cardRow";
      const estObj = (mEstado.get(l.id_estado) || {});
      const estUpper = String(estObj.nombre || l.estado_nombre || "").toUpperCase();
      const isClosed = isClosedEstadoName(estUpper);
      const flag = isClosed ? null : followupFlagInfo(l, estUpper);
      const flagHtml = flagIconHTML(flag);
      const cal = calendarioInfo(l, estUpper);
      const calClass = (!isClosed && cal?.cls && cal.cls !== "noDate") ? `cal-${cal.cls}` : "";
      const dateClass = isClosed ? "" : (calClass || (l.fecha_evento ? "" : "noDate"));
      const dateTitle = isClosed ? "" : (cal?.title || "");
      if (!isClosed && cal?.daysTo < 0) card.classList.add("overdue");
      row1.innerHTML = `
        <div class="cardName">
          ${flagHtml}
          <span class="nameText">${escapeHtml(l.cliente || "-")}</span>
        </div>
        <div class="cardDate ${escapeHtml(dateClass)}" title="${escapeHtml(dateTitle)}">${
          l.fecha_evento
            ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/></svg>${cal?.label ? `<span class="dateWarn">${escapeHtml(cal.label)}</span>` : ``}${escapeHtml(fmtDate(l.fecha_evento))}`
            : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/><path d="M9 14l6 6M15 14l-6 6"/></svg><span class="dateWarn">SIN FECHA</span>`
        }</div>
      `;

      const dotMonto = isClosed ? null : montoDotInfo(l);
      const row2 = document.createElement("div");
      row2.className = "cardRow2";
      row2.innerHTML = `
        <div class="cardComuna">${escapeHtml(comuna)} · ${escapeHtml(marca)}</div>
        <div class="cardMonto">
          <span class="dots">
            ${dotMonto ? `<span class="dot ${escapeHtml(dotMonto.cls)}" title="${escapeHtml(dotMonto.title)}"></span>` : ``}
          </span>
          ${escapeHtml(money(l.monto_cotizado))}
        </div>
      `;

      const actions = document.createElement("div");
      actions.className = "cardActions";
      actions.appendChild(iconButton("Editar","edit",(e)=>{ e.stopPropagation(); openEditModal(l); }));
      actions.appendChild(iconButton("Llamar","phone",(e)=>{ e.stopPropagation(); doCall(l); }));
      actions.appendChild(iconButton("WhatsApp","wa",(e)=>{ e.stopPropagation(); doWhatsApp(l); }));
      if (ENABLE_SEGUIMIENTO){
        actions.appendChild(iconButton("Seguimiento","msg",(e)=>{ e.stopPropagation(); doSeguimiento(l); }));
      }
      actions.appendChild(iconButton("Cotizar","quote",(e)=>{ e.stopPropagation(); doCotizar(l); }));

      card.appendChild(row1);
      card.appendChild(row2);
      card.appendChild(actions);
      listEl.appendChild(card);
    }

    col.appendChild(head);
    col.appendChild(listEl);
    root.appendChild(col);
  }
}

function renderTable(list){
  const mMarca = mapBy(CATS.marcas,"id_marca");
  const mComuna = mapBy(CATS.comunas,"id_comuna");
  const mEstado = mapBy(CATS.estados,"id_estado");

  const tb = qs("#tblBody");
  tb.innerHTML = "";

  for (const l of list){
    const tr = document.createElement("tr");
    if (HIGHLIGHT_IDS.has(Number(l.id_lead||0))){
      tr.classList.add("flash");
      setTimeout(()=>tr.classList.remove("flash"), 2600);
    }

    const est = mEstado.get(l.id_estado);
    const estado = est ? est.nombre : (l.estado_nombre || ("#" + (l.id_estado ?? "-")));
    const color = est ? (est.color || "") : (l.estado_color || "");
    const estUpper = String(estado || "").toUpperCase();
    const isClosed = isClosedEstadoName(estUpper);
    const flag = isClosed ? null : followupFlagInfo(l, estUpper);
    const flagHtml = flagIconHTML(flag);
    const cal = calendarioInfo(l, estUpper);
    const calClass = (!isClosed && cal?.cls && cal.cls !== "noDate") ? `cal-${cal.cls}` : "";
    const dateClass = isClosed ? "" : (calClass || (l.fecha_evento ? "" : "noDate"));
    const dateTitle = isClosed ? "" : (cal?.title || "");
    const dotMonto = isClosed ? null : montoDotInfo(l);

    const marca = l.marca_nombre || (mMarca.get(l.id_marca)||{}).nombre || "-";
    const comuna = l.comuna_nombre || (mComuna.get(l.id_comuna)||{}).nombre || "-";

    tr.innerHTML =
      `<td>` +
        `<div style="display:flex;align-items:center;gap:10px;min-width:0">` +
          `${flagHtml}` +
          `<div style="min-width:0">` +
            `<strong style="display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(l.cliente || "-")}</strong>` +
            `<div class="sub col-email" style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(l.email || "")}</div>` +
          `</div>` +
        `</div>` +
      `</td>` +
      `<td class="col-marca">${escapeHtml(marca)}</td>` +
      `<td class="col-comuna">${escapeHtml(comuna)}</td>` +
      `<td>` +
        `<span class="cardDate ${escapeHtml(dateClass)}" title="${escapeHtml(dateTitle)}">` +
          (l.fecha_evento
            ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/></svg>${cal?.label ? `<span class="dateWarn">${escapeHtml(cal.label)}</span>` : ``}${escapeHtml(fmtDate(l.fecha_evento))}`
            : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/><path d="M9 14l6 6M15 14l-6 6"/></svg><span class="dateWarn">SIN FECHA</span>`) +
        `</span>` +
      `</td>` +
      `<td>` +
        `<span class="dots">` +
          `${dotMonto ? `<span class="dot ${escapeHtml(dotMonto.cls)}" title="${escapeHtml(dotMonto.title)}"></span>` : ``}` +
        `</span>` +
        `<span style="margin-left:8px">${escapeHtml(money(l.monto_cotizado))}</span>` +
      `</td>` +
      `<td class="col-estado"><span class="statePill" style="--s:${escapeHtml(color)}">${escapeHtml(estado)}</span></td>` +
      `<td class="actions"></td>`;

    const actionsTd = tr.querySelector(".actions");
    actionsTd.appendChild(iconButton("Editar","edit",()=>openEditModal(l)));
    actionsTd.appendChild(iconButton("Llamar","phone",()=>doCall(l)));
    actionsTd.appendChild(iconButton("WhatsApp","wa",()=>doWhatsApp(l)));
    if (ENABLE_SEGUIMIENTO){
      actionsTd.appendChild(iconButton("Seguimiento","msg",()=>doSeguimiento(l)));
    }
    actionsTd.appendChild(iconButton("Cotizar","quote",()=>doCotizar(l)));

    tr.addEventListener("dblclick", ()=>openEditModal(l));
    tb.appendChild(tr);
  }
}

/* ========= Acciones ========= */
  // Lead actualmente abierto en modal (para refrescar notas/historial sin recargar).
  let EDITING_LEAD_ID = null;

  function applyNoteToLeadLocal(lead, block){
    const b = String(block || "").trim();
    if (!b) return;
    const cur = String(lead?.notas || "").trim();
    lead.notas = cur ? (cur + "\n\n" + b) : b;
    try{
      if (EDITING_LEAD_ID != null && Number(lead?.id_lead) === Number(EDITING_LEAD_ID)){
        const ta = document.getElementById("e_notas");
        if (ta) ta.value = lead.notas || "";
      }
    }catch(_){}
  }

  async function logLeadActionNote(lead, { kind, title, text, followup, contact_outcome }){
    try{
      const out = await apiJSON(`/leads/${lead.id_lead}/append_note`, {
        method: "POST",
        headers: { "Content-Type":"application/json" },
        body: JSON.stringify({
          kind,
          title,
          text,
          followup: !!followup,
          contact_outcome: String(contact_outcome || ""),
        }),
      });
      if (out && typeof out === "object" && out.block){
        applyNoteToLeadLocal(lead, out.block);
      }
      if (out?.estado?.id_estado){
        lead.id_estado = Number(out.estado.id_estado);
        lead.estado_nombre = String(out.estado.nombre || "CONTACTADO");
        try{
          const estadoSelect = document.getElementById("e_estado");
          if (estadoSelect) estadoSelect.value = String(out.estado.id_estado);
        }catch(_){}
        render();
      }
      return out;
    }catch(_){
      return null;
    }
  }

	async function doCall(lead){
	  const tel = String(lead?.telefono || "").trim();
	  if (!tel){ toast("Lead sin teléfono", "warning"); return; }
	  try{
	    await logLeadActionNote(lead, { kind:"CALL", title:"Llamada iniciada", text:`Se inicia llamada a ${tel}.` });
	  }catch(_){}
	  window.open("tel:" + tel, "_self");
	}
	function doWhatsApp(lead){
	  const defaultAction = (arguments?.length > 1 && arguments[1] && typeof arguments[1] === "object")
	    ? (arguments[1].defaultAction || "open")
	    : "open";
	  const tel = String(lead.telefono || "").replace(/\D/g,"");
	  if (!tel){ toast("Lead sin teléfono", "warning"); return; }
	  const tpls = followupTemplatesFor(lead);
	  const stName = estadoNombre(lead?.id_estado || "") || "SEGUIMIENTO";
	  const labels = tpls.map((t, i)=>{
	    const txt = String(t || "").trim();
	    const first = (txt.split("\n").map(x=>x.trim()).find(Boolean) || "").replace(/\s{2,}/g," ");
	    const short = first.length > 54 ? (first.slice(0,54) + "…") : first;
	    return `WSP ${String(i+1).padStart(2,"0")} · ${short || stName}`;
	  });
	  const otherAction = (defaultAction === "copy") ? "open" : "copy";

		  Swal.fire({
		    title: "WhatsApp",
		    html: `
	      <div class="wspBox" style="text-align:left">
	        <div class="wspRow">
	          <div class="muted" style="font-weight:950;flex:1 1 auto;min-width:0">Estado: <span style="color:var(--text)">${escapeHtml(stName)}</span> · Plantillas: <b>${tpls.length}</b></div>
	          <input id="sw_wa_q" class="swInp" placeholder="Buscar plantilla…" style="flex:1 1 240px;min-width:220px" />
	        </div>
	        <div style="display:grid;grid-template-columns: 280px 1fr;gap:10px;margin-top:10px;align-items:start">
	          <div id="sw_wa_list" style="max-height:44vh;overflow:auto;border:1px solid var(--border);border-radius:14px;background:var(--surface2);padding:8px"></div>
	          <div style="display:grid;gap:8px">
	            <div class="muted" style="font-weight:950">Mensaje (editable)</div>
	            <textarea id="sw_wa_txt" class="swTa" rows="10" placeholder="Mensaje…"></textarea>
	            <div class="muted" style="font-size:12px">Al ${defaultAction==="copy" ? "copiar" : "abrir"} se registra automáticamente en el historial.</div>
	          </div>
	        </div>
	      </div>
	    `,
		    showCancelButton: true,
		    confirmButtonText: (defaultAction === "copy") ? "Copiar" : "Abrir WhatsApp",
		    cancelButtonText: "Cancelar",
		    showDenyButton: true,
		    denyButtonText: (defaultAction === "copy") ? "Abrir WhatsApp" : "Copiar",
		    customClass: { popup: "gdWsp" },
		    didOpen: () => {
		      const listEl = document.getElementById("sw_wa_list");
	      const qEl = document.getElementById("sw_wa_q");
	      const ta = document.getElementById("sw_wa_txt");
	      if (!listEl || !ta) return;
	      let selectedIdx = 0;
	      const renderList = ()=>{
	        const q = String(qEl?.value || "").trim().toLowerCase();
	        const parts = [];
	        for (let i=0;i<labels.length;i++){
	          const lab = labels[i] || "";
	          const body = String(tpls[i] || "");
	          const hay = !q || lab.toLowerCase().includes(q) || body.toLowerCase().includes(q);
	          if (!hay) continue;
	          parts.push(`
	            <button type="button" data-idx="${i}" class="swBtn ${i===selectedIdx ? "" : "secondary"}" style="width:100%;text-align:left;justify-content:flex-start;padding:10px 10px;border-radius:14px;margin-bottom:8px;white-space:normal;line-height:1.25">
	              <span style="display:block;font-weight:1000">${escapeHtml(lab)}</span>
	              <span class="muted" style="display:block;margin-top:4px;font-size:12px;opacity:.85">${escapeHtml(String(body).replace(/\\s+/g,' ').slice(0,80))}${String(body).length>80?'…':''}</span>
	            </button>
	          `);
	        }
	        listEl.innerHTML = parts.join("") || `<div class="muted" style="padding:10px">Sin coincidencias.</div>`;
	        listEl.querySelectorAll("button[data-idx]").forEach((b)=>{
	          b.addEventListener("click", ()=>{
	            const idx = Number(b.getAttribute("data-idx") || "0");
	            if (!Number.isFinite(idx)) return;
	            selectedIdx = idx;
	            ta.value = String(tpls[selectedIdx] || "");
	            renderList();
	          });
	        });
	      };
	      const init = ()=>{
	        selectedIdx = 0;
	        ta.value = String(tpls[0] || "");
	        renderList();
	      };
	      if (qEl) qEl.addEventListener("input", renderList);
	      init();
	    },
	    preConfirm: () => {
	      const ta = document.getElementById("sw_wa_txt");
	      const v = (ta?.value || "").trim();
	      if (!v) { Swal.showValidationMessage("Mensaje vacío"); return false; }
	      const q = document.getElementById("sw_wa_q");
	      // idx seleccionado está implícito en el primer número del label si el usuario no tocó lista,
	      // pero lo guardamos leyendo el textarea contra tpls.
	      let idx = 0;
	      const raw = String(ta?.value || "");
	      const hit = tpls.findIndex(t => String(t||"").trim() === raw.trim());
	      if (hit >= 0) idx = hit;
	      return { msg: v, idx, action: defaultAction, q: String(q?.value||"") };
	    },
	    preDeny: () => {
	      const ta = document.getElementById("sw_wa_txt");
	      const v = (ta?.value || "").trim();
	      if (!v) return false;
	      let idx = 0;
	      const raw = String(ta?.value || "");
	      const hit = tpls.findIndex(t => String(t||"").trim() === raw.trim());
	      if (hit >= 0) idx = hit;
	      return { msg: v, idx, action: otherAction };
	    }
	  }).then(async (res)=>{
	    if (!res.isConfirmed && !res.isDenied) return;
	    const action = String(res.value?.action || (res.isDenied ? otherAction : defaultAction));
	    const msg = String(res.value?.msg || "").trim();
	    const idx = Number(res.value?.idx || 0);
	    if (!msg) return;

	    if (action === "copy"){
	      try{ await navigator.clipboard.writeText(msg); }catch(_){}
	    }
	    // Log historial (best-effort)
	    try{
	      await logLeadActionNote(lead, {
	        kind: "WSP",
	        title: `WhatsApp ${String(idx+1).padStart(2,"0")} · ${stName} · ${action==="copy" ? "COPIADO" : "ENVIADO"}`,
	        text: msg,
	      });
	    }catch(_){}

	    if (action === "open"){
	      window.open("https://wa.me/" + tel + "?text=" + encodeURIComponent(msg), "_blank", "noopener");
	    }
	  });
	}

	async function doSeguimiento(lead){
	  // Unificamos UX: Seguimiento usa el mismo picker de WhatsApp (buscador + preview + log inmediato),
	  // evitando diferencias (ej: "Copiar" sin registro) y manteniendo trazabilidad consistente.
	  try{
	    return doWhatsApp(lead, { defaultAction: "open" });
	  }catch(_){
	    toast("No pude abrir Seguimiento", "error");
	  }
	}
function doCotizar(lead){
  const id = encodeURIComponent(lead.id_lead);
  location.href = `/web/views/cotizador.html?v=20260421-cotpretty3&id_lead=${id}&lead_id=${id}`;
}

/* ========= Drag & Drop (con fallback endpoint) ========= */
let DRAG_ID = null;
let PLACEHOLDER = null;

function getDragAfterElement(container, y){
  const els = [...container.querySelectorAll(".card:not(.dragging):not(.placeholder)")];
  let closest = { offset: Number.NEGATIVE_INFINITY, element: null };
  for (const el of els){
    const box = el.getBoundingClientRect();
    const offset = y - box.top - box.height/2;
    if (offset < 0 && offset > closest.offset) closest = { offset, element: el };
  }
  return closest.element;
}
function onDragStart(e, id, cardEl){
  DRAG_ID = id;
  cardEl.classList.add("dragging");
  if (e.dataTransfer){
    e.dataTransfer.setData("text/plain", String(id));
    e.dataTransfer.setDragImage(cardEl, 20, 20);
  }
  PLACEHOLDER = document.createElement("div");
  PLACEHOLDER.className = "card placeholder";
  PLACEHOLDER.innerHTML = "&nbsp;";
}
function onDragEnd(){
  document.querySelector(".card.dragging")?.classList.remove("dragging");
  if (PLACEHOLDER?.parentElement) PLACEHOLDER.parentElement.removeChild(PLACEHOLDER);
  PLACEHOLDER = null; DRAG_ID = null;
  qsa(".cardList").forEach(el=>el.classList.remove("dropHover"));
}
function onDragOver(e, listEl){
  e.preventDefault();
  listEl.classList.add("dropHover");
  if (!PLACEHOLDER) return;
  const after = getDragAfterElement(listEl, e.clientY);
  if (after == null) listEl.appendChild(PLACEHOLDER);
  else listEl.insertBefore(PLACEHOLDER, after);
}

async function setLeadEstado(leadId, newEstado, extra = {}){
  if (!String(extra.movement_comment || extra.motivo || "").trim()){
    const res = await Swal.fire({
      title: "Comentario obligatorio",
      html: `<div style="text-align:left">
        <div style="font-weight:900;margin-bottom:8px">Para mover un lead hay que dejar evidencia.</div>
        <div class="muted">Escribe qué hiciste, qué respondió el cliente o cuál es el próximo paso.</div>
      </div>`,
      input: "textarea",
      inputPlaceholder: "Ej: Se llamó al cliente, pidió reenviar cotización y volver a contactar mañana.",
      inputAttributes: { maxlength: 1000 },
      showCancelButton: true,
      confirmButtonText: "Guardar movimiento",
      cancelButtonText: "Cancelar",
      preConfirm: (value)=>{
        const txt = String(value || "").trim();
        if (txt.length < 8){
          Swal.showValidationMessage("Escribe un comentario claro. Mínimo 8 caracteres.");
          return false;
        }
        return txt;
      }
    });
    if (!res.isConfirmed) throw new Error("Movimiento cancelado: falta comentario.");
    extra = { ...extra, movement_comment: String(res.value || "").trim() };
  }
  const payloads = [
    // Prefer nuevo endpoint unificado (incluye auditoría y evita desalineación de routers).
    { url: `/leads/${leadId}/move`,      method:"POST", body: { id_estado: Number(newEstado), ...extra } },
    { url: `/leads/${leadId}/estado_ex`, method:"POST", body: { id_estado: Number(newEstado), ...extra } },
    { url: `/leads/${leadId}/estado`,    method:"POST", body: { id_estado: Number(newEstado), ...extra } },
    { url: `/leads/${leadId}`,           method:"PUT",  body: { id_estado: Number(newEstado), ...extra } },
    { url: `/leads/${leadId}`,           method:"PATCH",body: { id_estado: Number(newEstado), ...extra } },
  ];

  let lastErr = null;
  for (const p of payloads){
    try{
      await apiJSON(p.url, {
        method: p.method,
        headers: { "Content-Type":"application/json" },
        body: JSON.stringify(p.body),
      });
      return;
    }catch(e){
      lastErr = e;
    }
  }
  throw lastErr || new Error("No pude actualizar estado.");
}

function estadoNombre(id){
  const est = (CATS.estados || []).find(e => Number(e.id_estado) === Number(id));
  return (est?.nombre || est?.estado || "").toString().toUpperCase();
}

function isConfirmEstadoName(nameUpper){
  const s = String(nameUpper || "").toUpperCase();
  // Backend bloquea CONFIRM* (y a veces “vendido” se usa como sinónimo).
  return s.includes("CONFIRM") || s.includes("VENDID") || s.includes("VENDIDO") || s.includes("EVENTO VEND");
}

/* ========= Mensajes predefinidos ========= */
const DECLINE_TEMPLATES = [
  { id:"no_responde", label:"Cliente no contesta", text:"Cliente no contesta. Cierro el lead por falta de respuesta." },
  { id:"sin_presupuesto", label:"Sin presupuesto", text:"Cliente indica que no cuenta con presupuesto. Queda declinado." },
  { id:"cambio_fecha", label:"Cambió fecha / no hay disponibilidad", text:"Cliente cambió la fecha o no hay disponibilidad. Lead declinado." },
  { id:"cancelado", label:"Evento cancelado", text:"Evento cancelado por el cliente. Lead declinado." },
  { id:"competencia", label:"Eligió otra opción", text:"Cliente eligió otra alternativa. Lead declinado." },
  { id:"no_califica", label:"No califica", text:"No califica para el servicio solicitado. Lead declinado." },
  { id:"fuera_zona", label:"Fuera de cobertura", text:"Fuera de cobertura/logística. Lead declinado." },
  { id:"sin_contacto", label:"Sin datos / contacto inválido", text:"Contacto inválido o incompleto. Lead declinado." },
  { id:"duplicado", label:"Duplicado", text:"Lead duplicado. Se declina para evitar duplicidad." },
  { id:"otro", label:"Otro (editar)", text:"" },
];

  // Seguimiento masivo (plantillas): requerido para WSP por estado + logging a historial.
  const ENABLE_SEGUIMIENTO = true;

function renderTpl(t, lead){
  const cliente = (lead?.cliente || lead?.nombre_cliente || "").trim();
  const marca = (lead?.marca_nombre || lead?.marca || "").trim();
  const fecha = String(lead?.fecha_evento || "").slice(0,10);
  return String(t || "")
    .replaceAll("{cliente}", cliente || "cliente")
    .replaceAll("{marca}", marca || "marca")
    .replaceAll("{fecha_evento}", fecha || "");
}

function followupTemplatesFor(lead){
  const st = estadoNombre(lead?.id_estado || "");
  const fecha = String(lead?.fecha_evento || "").slice(0, 10);
  const num = String(lead?.num_cotizacion || "").trim();
  const monto = money(lead?.monto_cotizado || 0);

  // 10 inicios x 5 cierres => 50 plantillas.
  const openers = [
    "Hola {cliente}, soy del equipo {marca}.",
    "Hola {cliente}, ¿cómo estás? Soy del equipo {marca}.",
    "Hola {cliente}, te escribo por tu solicitud en {marca}.",
    "Hola {cliente}, te contacto para avanzar con tu evento.",
    "Hola {cliente}, gracias por escribirnos.",
    "Hola {cliente}, quedo atento(a) para coordinar tu servicio.",
    "Hola {cliente}, te escribo para confirmar algunos detalles.",
    "Hola {cliente}, ¿tienes un minuto para revisar el estado de tu cotización?",
    "Hola {cliente}, quería dejarte un mensaje corto para coordinar.",
    "Hola {cliente}, te escribo para cerrar los últimos detalles.",
  ];
  const closers = [
    "Quedo atento(a).",
    "Gracias, quedo atento(a) a tu confirmación.",
    "Quedo pendiente para avanzar cuando me indiques.",
    "Si te acomoda, lo cerramos hoy para asegurar disponibilidad.",
    "Cualquier cosa me dices y lo ajustamos.",
  ];

  let body = "¿Me confirmas fecha, dirección y cantidad de personas para enviarte la propuesta final?";
  if (st.includes("NUEVO") || st.includes("CONTACT")){
    body = `Para ayudarte mejor, ¿me confirmas la fecha${fecha ? " (" + fecha + ")" : ""} y la cantidad aproximada de personas?`;
  }else if (st.includes("COTIZ")){
    body = `Te envié la cotización${num ? " N° " + num : ""}${monto ? " (" + monto + ")" : ""}. ¿La revisamos y la dejamos lista para aprobación?`;
  }else if (st.includes("PEND") || st.includes("SEGUIM") || st.includes("ESPER")){
    body = "Solo para confirmar si avanzamos con la reserva. Si hay algún cambio, lo ajustamos.";
  }else if (st.includes("CONFIRM")){
    body = "Para coordinar operación: ¿confirmamos horario de montaje/desmontaje y punto exacto de instalación?";
  }

  const out = [];
  for (let i = 0; i < openers.length; i++){
    for (let j = 0; j < closers.length; j++){
      out.push(renderTpl(`${openers[i]}\n\n${body}\n\n${closers[j]}`, lead));
    }
  }
  return out;
}

async function handleDeclinado(lead, newEstado){
  const res = await Swal.fire({
    icon:"warning",
    title:"¿Declinar lead?",
    text:"Se solicitará un motivo.",
    showCancelButton:true,
    confirmButtonText:"Sí, declinar",
    cancelButtonText:"Cancelar"
  });
  if (!res.isConfirmed) return false;

  const selOpts = DECLINE_TEMPLATES.map(t => `<option value="${escapeHtml(t.id)}">${escapeHtml(t.label)}</option>`).join("");
  const motivo = await Swal.fire({
    title:"Motivo de declinación",
    html: `
      <div style="text-align:left;display:grid;gap:10px">
        <label>Buscar motivo
          <input id="sw_decl_q" class="swInp" placeholder="Escribe para filtrar (ej: presupuesto, duplicado)..." />
        </label>
        <label>Mensaje predefinido
          <select id="sw_decl_tpl" class="swInp">${selOpts}</select>
        </label>
        <label>Motivo (editable)
          <textarea id="sw_decl_txt" class="swInp" rows="4" placeholder="Escribe el motivo..."></textarea>
        </label>
        <div class="muted">Tip: puedes editar el texto antes de guardar.</div>
      </div>
    `,
    showCancelButton:true,
    confirmButtonText:"Guardar",
    cancelButtonText:"Cancelar",
    didOpen: () => {
      const sel = document.getElementById("sw_decl_tpl");
      const q = document.getElementById("sw_decl_q");
      const ta = document.getElementById("sw_decl_txt");
      const all = Array.isArray(DECLINE_TEMPLATES) ? DECLINE_TEMPLATES.slice() : [];

      const render = (needle) => {
        const n = String(needle || "").trim().toLowerCase();
        const keep = sel?.value || "";
        const items = !n ? all : all.filter(t => {
          const id = String(t?.id || "").toLowerCase();
          const label = String(t?.label || "").toLowerCase();
          const text = String(t?.text || "").toLowerCase();
          return id.includes(n) || label.includes(n) || text.includes(n);
        });
        if (sel){
          sel.innerHTML = items.map(t => `<option value="${escapeHtml(t.id)}">${escapeHtml(t.label)}</option>`).join("")
            || `<option value="">(sin resultados)</option>`;
          if (keep && items.some(t => String(t.id) === String(keep))) sel.value = keep;
        }
      };

      const apply = () => {
        const id = sel?.value || "no_responde";
        const tpl = DECLINE_TEMPLATES.find(x => x.id === id) || DECLINE_TEMPLATES[0];
        const txt = renderTpl(tpl.text || "", lead);
        if (ta && !ta.value) ta.value = txt;
        if (ta && txt) ta.value = txt; // siempre reemplaza al cambiar template
      };
      if (sel) sel.addEventListener("change", apply);
      if (q){
        q.addEventListener("input", () => {
          render(q.value);
          apply();
        });
        // focus para agilizar
        try{ q.focus(); }catch(_){ }
      }
      render("");
      apply();
    },
    preConfirm: () => {
      const ta = document.getElementById("sw_decl_txt");
      const v = (ta?.value || "").trim();
      if (!v) {
        Swal.showValidationMessage("Motivo requerido");
        return false;
      }
      return v;
    }
  });
  if (!motivo.isConfirmed) return false;

  await setLeadEstado(lead.id_lead, newEstado, { motivo: motivo.value || "" });
  return true;
}

async function handleConfirmado(lead, newEstado, movementComment=""){
  try{ unlockCashRegisterSound(); }catch(_){ }
  let statusComment = String(movementComment || "").trim() || "Confirmado desde flujo de agenda/cotización.";
  // Refrescamos el lead desde API para evitar usar data stale (p.ej. id_cotizacion_vigente).
  try{
    const fresh = await apiJSON(`/leads/${lead.id_lead}`);
    if (fresh && typeof fresh === "object"){
      Object.assign(lead, fresh);
    }
  }catch(_){ }

  if (!lead.fecha_evento){
    await Swal.fire("Falta fecha", "El lead no tiene fecha de evento.", "warning");
    return false;
  }

  // Historial cotizador
  let qItems = [];
  try{
    let hist = null;
    try{ hist = await apiJSON(`/quotes/history?id_lead=${lead.id_lead}`); }
    catch(_){ hist = await apiJSON(`/crm/quotes/history?id_lead=${lead.id_lead}`); }
    qItems = Array.isArray(hist) ? hist : (hist?.items || []);
  }catch(err){
    // Best-effort: si falla el historial del cotizador, seguimos en modo "Manual" para no bloquear confirmación.
    // (Esto evita el modal de error "Failed to fetch" al pasar a CONFIRMADO).
    console.warn("[confirmado] No pude cargar quotes/history. Continuo en modo manual.", err);
    qItems = [];
  }

  // Manual/MICE items (si existen)
  let manualItems = [];
  try{
    const mi = await apiJSON(`/leads/${lead.id_lead}/mice_items`);
    // Preferimos by_day para soportar multi-día.
    manualItems = Array.isArray(mi?.by_day) ? mi.by_day : (Array.isArray(mi?.items) ? mi.items : []);
    lead._mice_items = manualItems;
  }catch(_){ }
  const manualAvailable = (manualItems.length > 0)
    || !!String(lead.cotizacion_pdf_url || "").trim()
    || !!String(lead.num_cotizacion || "").trim()
    || (Number(lead.monto_cotizado || 0) > 0);

  async function ensureQuoteMeta(){
    const curNum = String(lead.num_cotizacion || "").trim();
    const curMonto = Number(lead.monto_cotizado || 0);
    if (curNum && Number.isFinite(curMonto) && curMonto > 0) return true;
    const resMeta = await Swal.fire({
      title: "Datos de cotización externa",
      html: `
        <div style="text-align:left;display:grid;gap:10px">
          <label>N° cotización<input id="sw_numcot" class="swInp" value="${escapeHtml(curNum)}" placeholder="Ej: 12876" /></label>
          <label>Monto<input id="sw_monto" class="swInp" type="number" step="0.01" value="${escapeHtml(String(curMonto || ""))}" placeholder="Ej: 1500000" /></label>
          <div class="muted">Obligatorio cuando la cotización NO está hecha en el cotizador.</div>
        </div>
      `,
      showCancelButton: true,
      confirmButtonText: "Guardar",
      cancelButtonText: "Cancelar",
      focusConfirm: false,
      preConfirm: ()=>{
        const n = (qs("#sw_numcot").value || "").trim();
        const m = Number(qs("#sw_monto").value || 0);
        if (!n) return Swal.showValidationMessage("Falta N° cotización.");
        if (!Number.isFinite(m) || m <= 0) return Swal.showValidationMessage("Monto inválido.");
        return { num_cotizacion: n, monto_cotizado: m };
      }
    });
    if (!resMeta.isConfirmed) return false;
    try{
      await apiJSON(`/leads/${lead.id_lead}`, {
        method:"PUT",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify(resMeta.value)
      });
      lead.num_cotizacion = resMeta.value.num_cotizacion;
      lead.monto_cotizado = resMeta.value.monto_cotizado;
      return true;
    }catch(err){
      await Swal.fire("Error", "No pude guardar N°/monto. " + String(err.message||err), "error");
      return false;
    }
  }

  async function ensureManualMiceItems(){
    // Si ya existen productos cargados manualmente, no volver a pedirlos.
    try{
      const cur = await apiJSON(`/leads/${lead.id_lead}/mice_items`);
      const itemsCur = (cur?.by_day || cur?.items || []);
      if (Array.isArray(itemsCur) && itemsCur.length){
        lead._mice_items = itemsCur;
        return true;
      }
    }catch(_){ }

    // 1) intento: parsear PDF si existe (rápido si el PDF tiene texto).
    let parsed = null;
    try{
      if (lead.cotizacion_pdf_url){
        parsed = await apiJSON(`/leads/${lead.id_lead}/cotizacion_pdf/parse`, { method:"POST" });
      }
    }catch(_){ }

    // Carga catálogo de productos (venta) para ayudar al usuario (solo selección, sin texto libre).
    const marcaName = (()=>{
      try{
        const hit = (CATS?.marcas || []).find(m => Number(m.id_marca)===Number(lead.id_marca));
        return String(hit?.nombre || hit?.marca || "").trim();
      }catch(_){ return ""; }
    })();
    let allProds = [];
    try{
      const r = await apiJSON("/crm/productos?limit=5000");
      const arr = Array.isArray(r) ? r : (r?.items || []);
      const norm = (s)=>String(s||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").trim().toUpperCase();
      const want = norm(marcaName);
      allProds = want ? arr.filter(p => norm(p?.marca) === want) : arr;
    }catch(_){
      allProds = [];
    }

    const defaultDay = String(lead.fecha_evento || "").slice(0,10);
    const list = [];
    if (parsed?.ok && Array.isArray(parsed.items) && parsed.items.length){
      parsed.items.forEach(it => {
        const producto = String(it.producto || "").trim();
        const cantidad = Number(it.cantidad || 0);
        if (producto && Number.isFinite(cantidad) && cantidad > 0){
          list.push({ producto, cantidad, service_date: defaultDay || null });
        }
      });
    }

    const parserHint = (parsed && parsed.ok)
      ? (parsed.items?.length ? `Leí ${parsed.items.length} líneas desde el PDF (${parsed.used}). Revísalas y aprueba.` : `No encontré productos en el PDF (${parsed.used}). Agrega manualmente.`)
      : (parsed && parsed.ok === false)
        ? (`No pude leer el PDF automáticamente (${parsed.error || "error"}). Agrega manualmente.`)
        : (`Carga aquí los productos y cantidades para que el sistema calcule montaje y OPS.`);

    const html = `
      <div style="text-align:left;display:grid;gap:10px">
        <div class="muted">${escapeHtml(parserHint)}</div>
        ${lead.cotizacion_pdf_url ? `
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <button type="button" class="swBtn secondary" id="mi_ocr">Escanear PDF (OCR)</button>
            <div class="muted" id="mi_ocr_status">Si el PDF es imagen/escaneado, usa OCR desde tu PC (puede tardar).</div>
          </div>
        ` : ``}
	        <div style="border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.10);display:grid;gap:10px">
	          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
	            <label style="width:180px">
	              <div class="muted" style="margin-bottom:6px">Día</div>
	              <input id="mi_day" class="swInp" type="date" value="${escapeHtml(defaultDay)}" />
	            </label>
	            <label style="flex:1;min-width:240px">
	              <div class="muted" style="margin-bottom:6px">Producto (marca: ${escapeHtml(marcaName || "—")})</div>
	              <input id="mi_prod_search" class="swInp" placeholder="Buscar producto…" />
	            </label>
            <label style="flex:1;min-width:260px">
              <div class="muted" style="margin-bottom:6px">Selecciona</div>
              <select id="mi_prod_sel" class="swSel"><option value="">${allProds.length ? "— Selecciona —" : "(sin productos)"}</option></select>
            </label>
            <label style="width:140px">
              <div class="muted" style="margin-bottom:6px">Cantidad</div>
              <input id="mi_qty" class="swInp" type="number" step="0.001" value="1" />
            </label>
            <button type="button" class="swBtn" id="mi_add">Agregar</button>
          </div>
          <div class="muted" id="mi_prod_status">${allProds.length ? `Productos cargados: ${allProds.length}` : "No hay productos para esta marca."}</div>
        </div>
        <div id="mi_list" style="display:grid;gap:6px"></div>
      </div>
    `;

    function renderList(){
      const box = qs("#mi_list");
      if (!box) return;
      box.innerHTML = list.length ? list.map((it, idx)=>{
        const d = String(it.service_date || it.fecha || it.dia || defaultDay || "").slice(0,10);
        return `
        <div style="display:flex;gap:8px;align-items:center;justify-content:space-between;border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:8px 10px;background:rgba(0,0,0,.12)">
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <input class="swInp" type="date" value="${escapeHtml(d)}" style="width:160px" data-mi-day="${idx}" />
            <div style="min-width:220px"><b>${escapeHtml(it.producto)}</b></div>
            <input class="swInp" type="number" step="0.001" value="${escapeHtml(String(it.cantidad))}" style="width:120px" data-mi-qty="${idx}" />
          </div>
          <button type="button" class="swBtn secondary" data-mi-del="${idx}">Quitar</button>
        </div>
        `;
      }).join("") : `<div class="muted">Aún no agregas productos.</div>`;
      box.querySelectorAll("[data-mi-del]").forEach(btn=>{
        btn.onclick = ()=>{ const i = Number(btn.getAttribute("data-mi-del")); if (!Number.isFinite(i)) return; list.splice(i,1); renderList(); };
      });
      box.querySelectorAll("[data-mi-day]").forEach(inp=>{
        inp.onchange = ()=>{
          const i = Number(inp.getAttribute("data-mi-day"));
          if (!Number.isFinite(i) || !list[i]) return;
          const v = String(inp.value || "").slice(0,10);
          list[i].service_date = v || null;
        };
      });
      box.querySelectorAll("[data-mi-qty]").forEach(inp=>{
        inp.onchange = ()=>{
          const i = Number(inp.getAttribute("data-mi-qty"));
          if (!Number.isFinite(i) || !list[i]) return;
          const v = Number(inp.value || 0);
          if (!Number.isFinite(v) || v <= 0) return;
          list[i].cantidad = v;
        };
      });
    }

    const res = await Swal.fire({
      title: "Productos para MICE",
      html,
      width: 900,
      focusConfirm: false,
      showCancelButton: true,
      confirmButtonText: "Guardar productos",
      cancelButtonText: "Cancelar",
      didOpen: ()=>{
        const addBtn = qs("#mi_add");
        const prodSel = qs("#mi_prod_sel");
        const prodSearch = qs("#mi_prod_search");
        const qtyEl  = qs("#mi_qty");
        const dayEl  = qs("#mi_day");
        const prodSt = qs("#mi_prod_status");

        function renderProducts(filterText=""){
          if (!prodSel) return;
          const ft = String(filterText || "").trim().toLowerCase();
          const items = ft
            ? allProds.filter(p => String(p.producto || "").toLowerCase().includes(ft))
            : allProds;
          const opts = items.length
            ? items.slice(0, 2000).map(p => `<option value="${escapeHtml(p.producto || "")}">${escapeHtml(p.producto || "")}</option>`).join("")
            : `<option value="">(sin productos)</option>`;
          prodSel.innerHTML = `<option value="">— Selecciona —</option>` + opts;
          if (prodSt){
            prodSt.textContent = allProds.length ? `Productos cargados: ${allProds.length}` : "No hay productos para esta marca.";
          }
        }
        renderProducts("");
        prodSearch && prodSearch.addEventListener("input", ()=>{
          renderProducts(prodSearch.value);
          if (prodSel) prodSel.value = "";
        });

        const add = ()=>{
          const producto = String(prodSel?.value || "").trim();
          const cantidad = Number(qtyEl?.value || 0);
          const day = String(dayEl?.value || "").slice(0,10);
          if (!producto){ toast("Selecciona un producto de la lista", "error"); return; }
          if (!Number.isFinite(cantidad) || cantidad <= 0){ toast("Cantidad inválida", "error"); return; }
          list.push({ producto, cantidad, service_date: day || defaultDay || null });
          if (prodSearch) prodSearch.value = "";
          if (prodSel) prodSel.value = "";
          if (qtyEl) qtyEl.value = "1";
          renderList();
        };
        addBtn && (addBtn.onclick = add);
        prodSearch && prodSearch.addEventListener("keydown", e=>{ if (e.key==="Enter"){ e.preventDefault(); add(); }});
        renderList();

        const ocrBtn = qs("#mi_ocr");
        const ocrStatus = qs("#mi_ocr_status");
        if (ocrBtn && lead.cotizacion_pdf_url){
          ocrBtn.onclick = async ()=>{
            const ask = await Swal.fire({
              title:"OCR del PDF",
              text:"Esto usa el PC del ejecutivo y puede tardar 30–120 segundos. ¿Continuar?",
              icon:"question",
              showCancelButton:true,
              confirmButtonText:"Escanear",
              cancelButtonText:"Cancelar"
            });
            if (!ask.isConfirmed) return;

            const setMsg = (msg)=>{ if (ocrStatus) ocrStatus.textContent = msg; };
            try{
              ocrBtn.disabled = true;
              setMsg("Preparando OCR…");

	              const pdfUrl = apiURL(`/leads/${lead.id_lead}/cotizacion_pdf`);
              const prog = ({ phase, page, total, pct })=>{
                const p = (pct != null) ? ` · ${(pct*100).toFixed(0)}%` : "";
                setMsg(phase === "render"
                  ? `Renderizando página ${page}/${total}…`
                  : `OCR página ${page}/${total}${p}…`);
              };

              const r = await ocrPdfToText({
                url: pdfUrl,
                headers: authHeaders(),
                maxPages: 2,
                onProgress: prog
              });

              const guessed = guessItemsFromOcrText(r.text);
              if (!guessed.length){
                setMsg("OCR listo, pero no pude detectar líneas (agrega manualmente).");
                return;
              }

	              guessed.forEach(it => list.push({ ...it, service_date: defaultDay || null }));
	              renderList();
	              setMsg(`OCR listo: agregué ${guessed.length} línea(s). Revísalas y ajusta cantidades.`);
            }catch(err){
              setMsg("Error OCR: " + String(err?.message || err));
            }finally{
              ocrBtn.disabled = false;
            }
          };
        }
      },
      preConfirm: ()=>{
        if (!list.length){
          Swal.showValidationMessage("Debes agregar al menos 1 producto.");
          return false;
        }
        const items = list.map(it=>({
          producto: String(it.producto || "").trim(),
          cantidad: Number(it.cantidad || 0),
          service_date: String(it.service_date || "").slice(0,10) || null
        })).filter(it=>it.producto && Number.isFinite(it.cantidad) && it.cantidad > 0);
        return { items };
      }
    });
    if (!res.isConfirmed) return false;

    await apiJSON(`/leads/${lead.id_lead}/mice_items`, {
      method: "PUT",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify(res.value),
    });
    try{
      const cur = await apiJSON(`/leads/${lead.id_lead}/mice_items`);
      lead._mice_items = Array.isArray(cur?.by_day) ? cur.by_day : (Array.isArray(cur?.items) ? cur.items : []);
    }catch(_){ }
    return true;
  }

  // Google Calendar status (para el UI)
  let gcalConnected = false;
  try{
    const st = await apiJSON("/tools/gcal/status");
    gcalConnected = !!st?.connected;
  }catch(_){ }

  const money = (n)=>{
    const x = Number(n||0);
    if (!Number.isFinite(x)) return "";
    return "$" + new Intl.NumberFormat("es-CL",{maximumFractionDigits:0}).format(x);
  };

  const leadCot = lead.id_cotizacion_vigente;
  const leadCotId = (leadCot != null && String(leadCot).trim() != "") ? String(leadCot).trim() : null;

  const quoteOptions = (()=>{
    const opts = [];
    const manualLabel = (()=>{
      const num = String(lead.num_cotizacion || "").trim();
      const monto = Number(lead.monto_cotizado || 0);
      const mTxt = Number.isFinite(monto) && monto > 0 ? ` — ${money(monto)}` : "";
      const nTxt = num ? `N°${num}` : "sin N°";
      const itTxt = (lead._mice_items?.length || 0) ? ` · ${lead._mice_items.length} item(s)` : " · sin productos";
      return `Manual (${nTxt}${mTxt}${itTxt})`;
    })();
    opts.push(`<option value="manual">${escapeHtml(manualLabel)}</option>`);
    const seen = new Set();
    qItems.forEach(q=>{
      const id = q.id_cotizacion || q.id;
      if (id != null) seen.add(String(id).trim());
      const num = q.numero ? `N°${q.numero}` : `#${id}`;
      const rev = (q.revision != null) ? Number(q.revision) : Number(q.version || 0);
      const ver = rev > 0 ? ` (${rev})` : "";
      const total = q.total ? ` — ${money(q.total)}` : "";
      const fecha = q.fecha_evento || q.fecha_emision || q.created_at || "";
      opts.push(`<option value="${id}">${escapeHtml(num + ver + total + (fecha ? " · " + fecha : ""))}</option>`);
    });
    // Si el lead tiene id_cotizacion_vigente pero no vino en history (por caché/migración),
    // igual lo dejamos seleccionable (anti-tontos).
    try{
      if (leadCotId && !seen.has(String(leadCotId))){
        opts.push(`<option value="${escapeHtml(leadCotId)}">#${escapeHtml(leadCotId)} · (cotización vigente)</option>`);
      }
    }catch(_){}
    return opts.join("");
  })();

  const defCotId = leadCotId || (qItems[0] ? String(qItems[0].id_cotizacion || qItems[0].id || "").trim() : null);
  const defaultSel = (manualAvailable && manualItems.length) ? "manual" : (defCotId || (qItems[0] ? String(qItems[0].id_cotizacion || qItems[0].id || "") : "manual"));

  const html = `
    <style>
      .agGrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start}
      .agCard{border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.10);display:grid;gap:10px}
      .agRow{display:flex;gap:10px;flex-wrap:wrap;align-items:end}
      .agLabel{display:grid;gap:6px}
      .agLabel > .muted{font-weight:900}
      .agSmall{font-size:12px;opacity:.9}
      .agMono{margin:0;white-space:pre-wrap;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;opacity:.95}
      .agPreview{max-height:200px;overflow:auto;border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.10)}
      .agPill{padding:8px 10px;border-radius:999px}
      @media (max-width: 980px){ .agGrid{grid-template-columns:1fr} }
      /* Scroll claro dentro del modal (cuando no cabe en pantallas más chicas) */
      .gdAgenda .swal2-html-container{ scrollbar-width: thin; scrollbar-color: rgba(148,163,184,.40) transparent; }
      .gdAgenda .swal2-html-container::-webkit-scrollbar{ width: 8px; }
      .gdAgenda .swal2-html-container::-webkit-scrollbar-thumb{ background: rgba(148,163,184,.28); border-radius: 999px; border: 2px solid transparent; background-clip: content-box; }
      .gdAgenda .swal2-html-container:hover::-webkit-scrollbar-thumb{ background: rgba(148,163,184,.42); background-clip: content-box; }
    </style>
    <div style="text-align:left;display:grid;gap:12px">
      <div class="agCard" style="padding:12px;gap:10px">
        <div class="agRow" style="justify-content:space-between;align-items:center;gap:10px">
          <div class="muted" style="font-weight:1200">Set up de agendamiento</div>
          <button type="button" class="swBtn secondary" id="ag_setup_toggle" style="white-space:nowrap">Ocultar</button>
        </div>
        <div id="ag_setup_body" style="display:grid;gap:10px">
        <div class="agRow" style="gap:14px;align-items:center;flex-wrap:wrap">
          <label class="agLabel" style="min-width:260px">
            <div class="muted">Modalidad</div>
            <select id="ag_modality" class="swSel">
              <option value="simple">Único (1 día)</option>
              <option value="multiday">Multi día</option>
              <option value="multiloc">Multi locación</option>
              <option value="blocks">Por bloques</option>
              <option value="multiday_blocks">Multi día + Bloques</option>
              <option value="multiday_multiloc">Multi día + Multi locación</option>
              <option value="blocks_multiloc">Bloques + Multi locación</option>
              <option value="multiday_blocks_multiloc">Multi día + Bloques + Multi locación</option>
            </select>
          </label>
          <label style="display:flex;align-items:center;gap:8px">
            <input type="checkbox" id="ag_flag_blocks" />
            <span class="muted" style="font-weight:1000">Evento por bloques</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px">
            <input type="checkbox" id="ag_flag_multiday" />
            <span class="muted" style="font-weight:1000">Multi día</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px">
            <input type="checkbox" id="ag_flag_multiloc" />
            <span class="muted" style="font-weight:1000">Multi locación</span>
          </label>
          <div class="muted agSmall" style="flex:1;min-width:280px">Bloques => <b>1 solo evento</b>. Sin bloques => eventos por <b>Día × Locación</b> (si aplica). Al elegir flags se modela abajo sin “aplicar”.</div>
        </div>

        <div class="agRow" style="gap:12px;align-items:flex-end;flex-wrap:wrap">
          <label class="agLabel" id="ag_blocks_n_wrap" style="width:180px;display:none">
            <div class="muted">Cantidad de bloques</div>
            <input id="ag_blocks_n" class="swInp" type="number" min="1" step="1" placeholder="Ej: 2" disabled />
          </label>
          <label class="agLabel" id="ag_locs_n_wrap" style="width:180px;display:none">
            <div class="muted">Cantidad de locaciones</div>
            <input id="ag_locs_n" class="swInp" type="number" min="1" step="1" placeholder="Ej: 2" disabled />
          </label>
          <label class="agLabel" id="ag_days_n_wrap" style="width:220px;display:none">
            <div class="muted">Días (cuando Multi día)</div>
            <input id="ag_days_n" class="swInp" type="number" min="1" step="1" placeholder="Ej: 2" disabled />
          </label>
          <label style="display:flex;align-items:center;gap:8px;margin-top:26px">
            <input id="ag_flag_montaje_event" type="checkbox" />
            <span class="muted" style="font-weight:1000">Agendar montaje previo</span>
          </label>
        </div>

        <div style="border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.08);display:grid;gap:10px">
          <div class="muted" style="font-weight:1100">Montaje general (editable)</div>
          <div class="muted agSmall">Se calcula por productos. Puedes corregirlo antes de confirmar. (Esto NO es el montaje previo.)</div>
          <textarea id="ag_mont_manual" class="swTa" rows="4" placeholder="Ej: 2 x Carro Clásico&#10;1 x Máquina café"></textarea>
        </div>

        <div id="ag_montaje_event_box" style="display:none;border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.08);display:grid;gap:10px">
          <div class="muted" style="font-weight:1100">Montaje previo (evento separado)</div>
          <div class="muted agSmall">Se crea un evento adicional “MONTAJE …” con fecha/hora/dirección. Montaje general se usa como descripción.</div>
          <div class="agRow" style="gap:12px;align-items:flex-end;flex-wrap:wrap">
            <label class="agLabel" style="width:180px">
              <div class="muted">Día montaje</div>
              <input id="ag_mont_day" class="swInp" type="date" />
            </label>
            <label class="agLabel">
              <div class="muted">Inicio</div>
              <select id="ag_mont_hini" class="swSel"></select>
            </label>
            <label class="agLabel">
              <div class="muted">Fin</div>
              <select id="ag_mont_hfin" class="swSel"></select>
            </label>
            <label class="agLabel" style="flex:1;min-width:220px">
              <div class="muted">Comuna</div>
              <input id="ag_mont_loc" class="swInp" placeholder="Ej: Las Condes" />
            </label>
          </div>
          <label class="agLabel">
            <div class="muted">Dirección</div>
            <input id="ag_mont_dir" class="swInp" placeholder="Ej: Av. Apoquindo 2730" />
          </label>
        </div>

        <div id="ag_setup_editor" style="display:grid;gap:10px">
          <div class="muted" style="font-weight:1100">Modelador</div>
          <div class="muted agSmall">Se cargan productos de la cotización (o Manual). Si hay 1 solo grupo, se asigna automático. Si hay varios, asigna hasta que diga “OK”.</div>
          <div id="ag_setup_alert" style="display:none;border:1px solid rgba(239,68,68,.35);background:rgba(239,68,68,.10);border-radius:14px;padding:10px 12px">
            <div class="muted" style="font-weight:1100;color:rgba(239,68,68,.95)">Faltan productos por asignar</div>
            <div class="muted agSmall" id="ag_setup_alert_body" style="margin-top:4px;color:rgba(239,68,68,.92)">—</div>
          </div>
          <div id="ag_group_editor" style="display:grid;gap:10px"></div>
          <div id="ag_products_allocator" style="display:grid;gap:10px;border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.08)">
            <div class="muted" style="font-weight:1100">Productos (asignación)</div>
            <div class="muted agSmall" id="ag_alloc_hint">—</div>
            <div id="ag_alloc_pool" style="display:grid;gap:8px"></div>
            <div id="ag_alloc_status" class="muted agSmall">—</div>
          </div>
        </div>
        </div>
      </div>
      <div class="agGrid">
        <!-- Izquierda: datos + notas + productos (por día) -->
        <div class="agCard">
          <div class="agRow">
            <label class="agLabel" style="flex:1;min-width:280px">
              <div class="muted">Cotización aprobada</div>
              <select id="ag_quote" class="swSel">${quoteOptions}</select>
            </label>
            <button type="button" class="swBtn secondary" id="ag_edit_manual" style="display:none;white-space:nowrap">Editar productos</button>
          </div>

	          <div class="agRow">
	            <label class="agLabel" style="flex:1;min-width:240px">
	              <div class="muted">Abono (opcional)</div>
	              <input id="ag_abono" class="swInp" placeholder="0" inputmode="numeric" />
	            </label>
	            <div class="agLabel" id="ag_abono_extra" style="flex:1;min-width:240px;display:none">
	              <div class="muted">Si NO hay abono</div>
	              <div class="agRow" style="gap:8px;align-items:center">
	                <select id="ag_abono_mode" class="swSel" style="flex:1;min-width:160px" title="Define OC o fecha de abono">
	                  <option value="">— Seleccionar —</option>
	                  <option value="oc">OC</option>
	                  <option value="fecha">Fecha de abono</option>
	                  <option value="credito">Pago a crédito</option>
	                </select>
	                <input id="ag_abono_oc" class="swInp" style="flex:1;min-width:160px;display:none" placeholder="OC / referencia" />
	                <input id="ag_abono_fecha" class="swInp" style="flex:1;min-width:160px;display:none" type="date" />
	              </div>
	              <div class="muted agSmall">Regla: si abono = 0, indica OC, fecha de abono o pago a crédito.</div>
	            </div>
	            <label class="agLabel" style="flex:1;min-width:240px">
	              <div class="muted">Documento</div>
	              <select id="ag_doc_mode" class="swSel" title="Documento (afecta IVA y texto WhatsApp)">
	                <option value="auto">Auto (según tipo cliente)</option>
	                <option value="sin">Sin documento</option>
	                <option value="con">Con documento</option>
	              </select>
	            </label>
	          </div>

          <div class="agRow">
            <label class="agLabel">
              <div class="muted">Inicio (24h)</div>
              <select id="ag_hini" class="swSel"></select>
            </label>
            <label class="agLabel">
              <div class="muted">Fin (24h)</div>
              <select id="ag_hfin" class="swSel"></select>
            </label>
            <label style="display:flex;align-items:center;gap:8px;margin-top:26px">
              <input id="ag_hrtbd" type="checkbox" />
              <span class="muted" style="font-weight:1000">HR TBD</span>
            </label>
            <div class="muted agSmall" id="ag_duracion" style="align-self:center;margin-top:26px">Duración: —</div>
          </div>

          <!-- El setup va ARRIBA (full width). Aquí solo datos del evento. -->
          <div id="ag_after_setup" style="display:grid;gap:12px">
          <div class="agRow" style="gap:12px">
            <label class="agLabel" style="flex:1;min-width:240px">
              <div class="muted">Teléfono</div>
              <input id="ag_tel" class="swInp" value="${escapeHtml(lead.telefono||"")}" placeholder="POR CONFIRMAR" />
            </label>
            <label class="agLabel" style="flex:1;min-width:240px">
              <div class="muted">Dirección</div>
              <input id="ag_dir" class="swInp" value="${escapeHtml(lead.direccion||"")}" placeholder="POR CONFIRMAR" />
            </label>
          </div>

          <label class="agLabel">
            <div class="muted">Location</div>
            <input id="ag_loc" class="swInp" placeholder="Comuna o lugar (ej: Las Condes)" />
          </label>

          <label class="agLabel">
            <div class="muted">Notas (se verán destacadas en Calendar)</div>
            <textarea id="ag_notes" class="swTa" rows="3" placeholder="Notas importantes para operaciones / cliente…"></textarea>
          </label>

          <div id="ag_segments_wrap" style="display:none;border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.10);display:grid;gap:10px">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div class="muted" style="font-weight:1000">Segmentos (multi-locación)</div>
              <button type="button" class="swBtn secondary" id="ag_seg_add" style="white-space:nowrap">Agregar segmento</button>
            </div>
            <div class="muted agSmall">Crea 1 segmento por parada. Cada segmento crea un evento en Calendar.</div>
            <div id="ag_seg_list" style="display:grid;gap:10px"></div>
          </div>

          <div id="ag_blocks_wrap" style="display:none;border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.10);display:grid;gap:10px">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div class="muted" style="font-weight:1000">Bloques (multi-día / multi-locación)</div>
              <button type="button" class="swBtn secondary" id="ag_blk_add" style="white-space:nowrap">Agregar bloque</button>
            </div>
            <div class="muted agSmall">1 solo evento en Calendar. Los bloques se listan en la descripción por horario (como “BLOQUE A: ENTREGA 15.30 – 16.00”).</div>
            <div id="ag_blk_list" style="display:grid;gap:10px"></div>
          </div>

          <div class="agPreview" id="ag_products_wrap" style="max-height:none">
            <div class="muted" style="margin-bottom:6px;font-weight:1000">Productos (día seleccionado)</div>
            <pre id="ag_products_day" class="agMono">(cargando…)</pre>
          </div>
          </div>
        </div>

        <!-- Derecha: tabs + montaje + preview del evento por día -->
        <div class="agCard">
          <div class="agRow">
            <div class="muted agSmall" id="ag_calc_status" style="flex:1;align-self:center">Calculando…</div>
          </div>

          <label class="agLabel">
            <div class="muted">Título</div>
            <input id="ag_title" class="swInp" placeholder="Título del evento" />
          </label>

	          <div id="ag_day_editor_wrap">
	            <div class="agRow" style="align-items:center;justify-content:space-between">
	              <div class="muted" id="ag_day_hdr" style="font-weight:1000">Agenda por día</div>
	              <div id="ag_day_tabs" style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end"></div>
	            </div>
	
	            <div id="ag_day_montaje_wrap" style="border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.10);display:grid;gap:10px">
	              <div class="muted" style="font-weight:1000">Montaje sugerido</div>
	              <div class="agRow" style="align-items:center">
	                <label class="agLabel" style="width:140px">
	                  <div class="muted">OPS (día)</div>
                  <input id="ag_ops_day" class="swInp" type="number" min="0" step="1" />
                </label>
                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:22px">
                  <button type="button" class="swBtn secondary" id="ag_montaje_confirm" style="white-space:nowrap">Confirmar montaje</button>
                  <button type="button" class="swBtn" id="ag_montaje_edit" style="white-space:nowrap">Editar</button>
                </div>
              </div>
              <textarea id="ag_montaje_day" class="swTa" rows="7" placeholder="Montaje sugerido…"></textarea>
            </div>
          </div>

          <label class="agLabel">
            <div class="muted">Descripción (opcional)</div>
            <textarea id="ag_desc" class="swTa" rows="3" placeholder="Descripción para Calendar…"></textarea>
          </label>

          <div class="agPreview">
            <div class="muted" style="margin-bottom:6px;font-weight:1000">Previsualización (día seleccionado)</div>
            <pre id="ag_preview_day" class="agMono">(cargando…)</pre>
          </div>

          <div class="muted agSmall" style="display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap">
            <div>Google Calendar: <b>${gcalConnected ? "conectado" : "NO conectado"}</b></div>
            ${gcalConnected ? "" : `<a href="${escapeHtml(apiURL("/tools/gcal/start"))}" target="_blank" rel="noopener" style="color:#60a5fa;font-weight:1000">Conectar</a>`}
          </div>
        </div>
      </div>
    </div>
  `;

  const touched = { title:false, loc:false, desc:false };
  let previewEvents = [];
  let selectedIdx = 0;
  let TIMES = [];
  let TIMES_OPT = "";
  let agendaMode = "simple"; // derived from flags
  let setupApplied = false; // true after "Armar set up"
  let segState = []; // [{comuna,direccion,start_time,end_time,ops,products_text,montaje_text}]
  let blockState = []; // [{day,comuna,direccion,start_time,end_time,hr_tbd,ops,products_text,montaje_text,label}]
  const dayEdits = {}; // day -> { ops, montaje }
  const touchedDay = {}; // day -> { ops, montaje }

  // ===== Modelador (setup) =====
  let setupGroups = []; // [{kind:'block'|'segment', key, day, comuna, direccion, start_time, end_time, hr_tbd, label, loc_idx, day_idx, ops, products_map:{prod:qty}}]
  let allocPool = [];   // [{producto, cantidad}]
  let allocTotals = {}; // producto -> total qty

	  const _flags = ()=>({
	    blocks: !!qs("#ag_flag_blocks")?.checked,
	    multiday: !!qs("#ag_flag_multiday")?.checked,
	    multiloc: !!qs("#ag_flag_multiloc")?.checked,
	  });

	  const _setModality = (mode)=>{
	    const elB = qs("#ag_flag_blocks");
	    const elD = qs("#ag_flag_multiday");
	    const elL = qs("#ag_flag_multiloc");
	    if (!elB || !elD || !elL) return;
	    const m = String(mode || "").trim();
	    const set = (b,d,l)=>{
	      elB.checked = !!b;
	      elD.checked = !!d;
	      elL.checked = !!l;
	      // defaults razonables cuando se activan
	      if (!!b && qs("#ag_blocks_n") && !String(qs("#ag_blocks_n").value||"").trim()) qs("#ag_blocks_n").value = "2";
	      if (!!d && qs("#ag_days_n") && !String(qs("#ag_days_n").value||"").trim()) qs("#ag_days_n").value = "2";
	      if (!!l && qs("#ag_locs_n") && !String(qs("#ag_locs_n").value||"").trim()) qs("#ag_locs_n").value = "2";
	    };
	    if (m === "multiday") return set(false,true,false);
	    if (m === "multiloc") return set(false,false,true);
	    if (m === "blocks") return set(true,false,false);
	    if (m === "multiday_blocks") return set(true,true,false);
	    if (m === "multiday_multiloc") return set(false,true,true);
	    if (m === "blocks_multiloc") return set(true,false,true);
	    if (m === "multiday_blocks_multiloc") return set(true,true,true);
	    // default
	    return set(false,false,false);
	  };

  const _setCountsEnabled = ()=>{
    const f = _flags();
    const elB = qs("#ag_blocks_n");
    const elL = qs("#ag_locs_n");
    const elD = qs("#ag_days_n");
    const wB = qs("#ag_blocks_n_wrap");
    const wL = qs("#ag_locs_n_wrap");
    const wD = qs("#ag_days_n_wrap");
    if (wB) wB.style.display = f.blocks ? "" : "none";
    if (wD) wD.style.display = f.multiday ? "" : "none";
    if (wL) wL.style.display = f.multiloc ? "" : "none";
    if (elB) elB.disabled = !f.blocks;
    if (elD) elD.disabled = !f.multiday;
    if (elL) elL.disabled = !f.multiloc;
    // defaults razonables (solo cuando se habilita y está vacío)
    if (f.blocks && elB && !String(elB.value||"").trim()) elB.value = "2";
    if (f.multiday && elD && !String(elD.value||"").trim()) elD.value = "2";
    if (f.multiloc && elL && !String(elL.value||"").trim()) elL.value = "2";
  };

  const _datePlusDays = (d0, add)=>{
    try{
      const d = new Date(String(d0).slice(0,10) + "T00:00:00");
      if (isNaN(d.getTime())) return String(d0).slice(0,10);
      d.setDate(d.getDate() + Number(add||0));
      return d.toISOString().slice(0,10);
    }catch(_){ return String(d0).slice(0,10); }
  };

	  const _groupLabel = (g, idx)=>{
	    if (!g) return `Grupo ${idx+1}`;
	    if (g.kind === "block"){
	      const bi = Number.isFinite(Number(g.block_idx)) ? Number(g.block_idx) : idx;
	      const lab = String(g.label || "").trim() || `BLOQUE ${String.fromCharCode(65 + (bi % 26))}`;
	      const d = String(g.day||"").slice(0,10) || "—";
	      const l = (g.multiloc ? `Loc ${Number(g.loc_idx||0)+1}` : "");
	      const st = String(g.start_time||"").trim() || "HR TBD";
	      const en = String(g.end_time||"").trim() || "";
	      const hr = (st && en) ? `${st}-${en}` : st;
	      return `${lab}${l ? (" · " + l) : ""} · ${d} · ${hr}`;
	    }
    // segment
    const d = String(g.day||"").slice(0,10) || "—";
    const l = (g.multiloc ? `Loc ${Number(g.loc_idx||0)+1}` : "Loc");
    const st = String(g.start_time||"").trim() || "HR TBD";
    const en = String(g.end_time||"").trim() || "";
    const hr = (st && en) ? `${st}-${en}` : st;
    return `${d} · ${l} · ${hr}`;
  };

  const _renderGroupEditor = ()=>{
    const wrap = qs("#ag_group_editor");
    if (!wrap) return;
    if (!Array.isArray(setupGroups) || !setupGroups.length){
      wrap.innerHTML = `<div class="muted">Arma el set up para continuar.</div>`;
      return;
    }
    const cards = setupGroups.map((g, i)=>{
      const lab = _groupLabel(g, i);
      const comuna = escapeHtml(String(g.comuna||""));
      const direccion = escapeHtml(String(g.direccion||""));
      const day = escapeHtml(String(g.day||"").slice(0,10));
      return `
        <div data-g-idx="${i}" style="border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.08);display:grid;gap:10px">
          <div class="muted" style="font-weight:1100">${escapeHtml(lab)}</div>
          <div class="agRow" style="gap:12px">
            <label class="agLabel" style="width:180px">
              <div class="muted">Día</div>
              <input class="swInp" type="date" data-f="day" value="${day}" />
            </label>
            <label class="agLabel">
              <div class="muted">Inicio</div>
              <select class="swSel" data-f="start_time">${TIMES_OPT || `<option value=\"\">—</option>`}</select>
            </label>
            <label class="agLabel">
              <div class="muted">Fin</div>
              <select class="swSel" data-f="end_time">${TIMES_OPT || `<option value=\"\">—</option>`}</select>
            </label>
            <label class="agLabel" style="width:140px">
              <div class="muted">OPS</div>
              <input class="swInp" type="number" min="1" step="1" data-f="ops" value="${escapeHtml(String(g.ops ?? 1))}" />
            </label>
          </div>
          <div class="agRow" style="gap:12px">
            <label class="agLabel" style="flex:1;min-width:220px">
              <div class="muted">Comuna</div>
              <input class="swInp" data-f="comuna" value="${comuna}" placeholder="Ej: Las Condes" />
            </label>
            <label class="agLabel" style="flex:2;min-width:240px">
              <div class="muted">Dirección</div>
              <input class="swInp" data-f="direccion" value="${direccion}" placeholder="Ej: Av. Apoquindo 2730" />
            </label>
          </div>
          ${g.kind === "block" ? `
            <label class="agLabel">
              <div class="muted">Etiqueta bloque (opcional)</div>
              <input class="swInp" data-f="label" value="${escapeHtml(String(g.label||""))}" placeholder="Ej: ENTREGA / BLOQUE A" />
            </label>
          ` : ``}
          <div style="border-top:1px solid rgba(255,255,255,.08);padding-top:10px;display:grid;gap:8px">
            <div class="muted" style="font-weight:1000">Productos asignados</div>
            <div data-f="plist" class="muted agSmall">${escapeHtml(_productsMapToText(g.products_map||{})) || "—"}</div>
          </div>
        </div>
      `;
    }).join("");
    wrap.innerHTML = cards;

    // seed selects to values
    wrap.querySelectorAll("[data-g-idx]").forEach(card=>{
      const idx = Number(card.getAttribute("data-g-idx")||-1);
      const g = setupGroups[idx];
      if (!g) return;
      const selS = card.querySelector("[data-f='start_time']");
      const selE = card.querySelector("[data-f='end_time']");
      if (selS && g.start_time) selS.value = g.start_time;
      if (selE && g.end_time) selE.value = g.end_time;
    });

    // wire edits
    wrap.querySelectorAll("[data-g-idx] input,[data-g-idx] select").forEach(inp=>{
      inp.addEventListener("input", ()=>{ _readGroupsFromDOM(); _schedulePreview(); });
      inp.addEventListener("change", ()=>{ _readGroupsFromDOM(); _schedulePreview(); });
    });
  };

  const _productsMapToText = (m)=>{
    try{
      const lines = [];
      const keys = Object.keys(m||{}).sort((a,b)=>a.localeCompare(b));
      for (const k of keys){
        const q = Number(m[k]||0);
        if (!(q>0)) continue;
        lines.push(`${q} x ${k}`);
      }
      return lines.join(" • ");
    }catch(_){ return ""; }
  };

  const _readGroupsFromDOM = ()=>{
    try{
      const wrap = qs("#ag_group_editor");
      if (!wrap) return setupGroups;
      const cards = [...wrap.querySelectorAll("[data-g-idx]")];
      for (const card of cards){
        const idx = Number(card.getAttribute("data-g-idx")||-1);
        const g = setupGroups[idx];
        if (!g) continue;
        g.day = String(card.querySelector("[data-f='day']")?.value || g.day || "").slice(0,10);
        g.start_time = String(card.querySelector("[data-f='start_time']")?.value || "").trim();
        g.end_time = String(card.querySelector("[data-f='end_time']")?.value || "").trim();
        g.ops = Number(String(card.querySelector("[data-f='ops']")?.value || "").trim() || 1) || 1;
        g.comuna = String(card.querySelector("[data-f='comuna']")?.value || "").trim();
        g.direccion = String(card.querySelector("[data-f='direccion']")?.value || "").trim();
        if (g.kind === "block"){
          g.label = String(card.querySelector("[data-f='label']")?.value || "").trim();
        }
      }
    }catch(_){}
    return setupGroups;
  };

  const _buildGroupsFromFlags = ()=>{
    const f = _flags();
    const d0 = String(lead.fecha_evento || "").slice(0,10) || (new Date()).toISOString().slice(0,10);
    const daysN = Math.max(1, Number(qs("#ag_days_n")?.value || 1) || 1);
    const locN = Math.max(1, Number(qs("#ag_locs_n")?.value || 1) || 1);
    const blkN = Math.max(1, Number(qs("#ag_blocks_n")?.value || 2) || 2);
    const hIni = (qs("#ag_hini")?.value || "").trim();
    const hFin = (qs("#ag_hfin")?.value || "").trim();
    const comuna0 = (qs("#ag_loc")?.value || "").trim();
    const dir0 = (qs("#ag_dir")?.value || "").trim();

	    const groups = [];
	    if (f.blocks){
      // Bloques: 1 solo evento en Calendar; si es multi-día, el usuario define días y bloques por día.
      // Si además es multi-locación, cada bloque puede tener su propia dirección.
	      const days = f.multiday ? Array.from({length:daysN}, ()=>"") : [d0];
	      for (let di=0; di<days.length; di++){
	        const day = days[di];
	        for (let bi=0; bi<blkN; bi++){
	          const li = f.multiloc ? (bi % locN) : 0;
	          groups.push({
	            kind:"block",
	            key:`blk_${di}_${bi}`,
	            day,
	            day_idx: di,
	            block_idx: bi,
	            loc_idx: li,
	            multiloc: !!f.multiloc,
	            comuna: comuna0,
	            direccion: dir0,
	            start_time: hIni,
	            end_time: hFin,
	            hr_tbd: false,
            ops: 1,
            label: "",
            products_map: {},
          });
        }
      }
    }else{
      const days = f.multiday ? Array.from({length:daysN}, ()=>"") : [d0];
      for (let di=0;di<days.length;di++){
        const day = days[di];
        const locCount = f.multiloc ? locN : 1;
        for (let li=0;li<locCount;li++){
          groups.push({
            kind:"segment",
            key:`seg_${di}_${li}`,
            day,
            day_idx: di,
            loc_idx: li,
            multiloc: !!f.multiloc,
            comuna: comuna0,
            direccion: dir0,
            start_time: hIni,
            end_time: hFin,
            hr_tbd: false,
            ops: 1,
            products_map: {},
          });
        }
      }
    }
    setupGroups = groups;
    return setupGroups;
  };

  const _renderAllocPool = ()=>{
    const box = qs("#ag_alloc_pool");
    const status = qs("#ag_alloc_status");
    if (!box) return;
    const groups = Array.isArray(setupGroups) ? setupGroups : [];
    const opts = groups.map((g,i)=>`<option value="${i}">${escapeHtml(_groupLabel(g,i))}</option>`).join("");

    const rows = (allocPool||[]).map((it, idx)=>{
      const prod = String(it.producto||"").trim();
      const total = Number(it.cantidad||0) || 0;
      const used = _allocatedTotalFor(prod);
      const rem = Math.max(0, total - used);
      return `
        <div data-alloc-row="${idx}" data-prod="${escapeHtml(prod)}" style="display:grid;grid-template-columns:1fr 110px 1fr 110px 140px;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.08)">
          <div style="font-weight:1000">${escapeHtml(prod)}</div>
          <div class="muted">${escapeHtml(String(total))}</div>
          <select class="swSel" data-alloc-g>${opts}</select>
          <input class="swInp" data-alloc-q type="number" min="0" step="0.01" value="${escapeHtml(String(rem))}" />
          <button type="button" class="swBtn secondary" data-alloc-add ${rem<=0 ? "disabled" : ""}>Asignar</button>
        </div>
      `;
    }).join("");
    box.innerHTML = rows || `<div class="muted">Sin productos cargados.</div>`;

    box.querySelectorAll("[data-alloc-add]").forEach((btn)=>{
      btn.addEventListener("click", ()=>{
        const row = btn.closest("[data-alloc-row]");
        const prod = String(row?.getAttribute("data-prod") || "").trim();
        const sel = row?.querySelector("[data-alloc-g]");
        const inp = row?.querySelector("[data-alloc-q]");
        const gi = Number(sel && sel.value ? sel.value : 0);
        const qty = Number(String(inp && inp.value ? inp.value : "").trim() || 0) || 0;
        if (!(qty>0)) return;
        _assignProductToGroup(prod, qty, gi);
        _renderGroupEditor();
        _renderAllocPool();
        _updateAllocStatus();
        _schedulePreview();
      });
    });
    _updateAllocStatus();
    if (status) status.textContent = status.textContent || "—";
  };

  const _allocatedTotalFor = (producto)=>{
    let sum = 0;
    const groups = Array.isArray(setupGroups) ? setupGroups : [];
    for (const g of groups){
      const m = g.products_map || {};
      const v = Number(m[producto] || 0) || 0;
      sum += v;
    }
    return sum;
  };

  const _assignProductToGroup = (producto, qty, groupIdx)=>{
    const g = setupGroups[groupIdx];
    if (!g) return;
    const total = Number((allocTotals||{})[producto] || 0) || 0;
    const used = _allocatedTotalFor(producto);
    const rem = Math.max(0, total - used);
    const q = Math.min(rem, Number(qty||0) || 0);
    if (!(q>0)) return;
    g.products_map ||= {};
    g.products_map[producto] = (Number(g.products_map[producto] || 0) || 0) + q;
  };

  const _updateAllocStatus = ()=>{
    const st = qs("#ag_alloc_status");
    if (!st) return;
    const missing = [];
    for (const it of (allocPool||[])){
      const prod = String(it.producto||"").trim();
      const total = Number(it.cantidad||0) || 0;
      const used = _allocatedTotalFor(prod);
      const rem = total - used;
      if (rem > 0.0001) missing.push(`${prod} (${rem.toFixed(2)})`);
    }
    if (missing.length){
      st.textContent = "Falta asignar: " + missing.slice(0,6).join(", ") + (missing.length>6 ? "…" : "");
      _showMissingAllocAlert(missing.map(x=>String(x).replace(/\s*\([^)]*\)\s*$/,"")));
    }else{
      st.textContent = "OK: todos los productos están asignados.";
      _showMissingAllocAlert([]);
    }
  };

  const _showMissingAllocAlert = (missingProds)=>{
    // No debe cerrar ni sacar del modal: mostramos alerta inline arriba del modelador.
    try{
      const wrap = qs("#ag_setup_alert");
      const body = qs("#ag_setup_alert_body");
      if (!wrap || !body) return;
      const arr = (missingProds||[]).map(x=>String(x||"").trim()).filter(Boolean);
      const msg = arr.slice(0, 10).join(", ") + (arr.length > 10 ? "…" : "");
      body.textContent = msg || "—";
      wrap.style.display = arr.length ? "block" : "none";
      // Scroll suave a la alerta
      try{ wrap.scrollIntoView({ behavior:"smooth", block:"nearest" }); }catch(_){}
    }catch(_){}
  };

  const _groupsToPayload = ()=>{
    const f = _flags();
    if (f.blocks){
      const blocks = (setupGroups||[]).filter(g=>g.kind==="block").map((g, idx)=>({
        day: String(g.day||"").slice(0,10),
        label: String(g.label||"").trim(),
        comuna: String(g.comuna||"").trim(),
        direccion: String(g.direccion||"").trim(),
        start_time: String(g.start_time||"").trim(),
        end_time: String(g.end_time||"").trim(),
        hr_tbd: false,
        ops: Number(g.ops||1) || 1,
        products_text: _mapToLines(g.products_map||{}),
        montaje_text: "", // montaje global se maneja aparte
      }));
      return { blocks };
    }
    const segments = (setupGroups||[]).filter(g=>g.kind==="segment").map((g)=>({
      day: String(g.day||"").slice(0,10),
      comuna: String(g.comuna||"").trim(),
      direccion: String(g.direccion||"").trim(),
      start_time: String(g.start_time||"").trim(),
      end_time: String(g.end_time||"").trim(),
      ops: Number(g.ops||1) || 1,
      products_text: _mapToLines(g.products_map||{}),
      montaje_text: "", // montage global
    }));
    return { segments };
  };

  const _mapToLines = (m)=>{
    const lines = [];
    const keys = Object.keys(m||{}).sort((a,b)=>a.localeCompare(b));
    for (const k of keys){
      const q = Number(m[k]||0) || 0;
      if (!(q>0)) continue;
      lines.push(`${q} ${k}`);
    }
    return lines.join("\n").trim();
  };

  const saveCurrentDay = ()=>{
    const e = previewEvents[selectedIdx];
    if (!e) return;
    const day = String(e.day || "").trim();
    if (!day) return;
    const opsV = (qs("#ag_ops_day")?.value || "").trim();
    const mtV = (qs("#ag_montaje_day")?.value || "").trim();
    dayEdits[day] = { ops: opsV, montaje: mtV };
  };

	  // GD-AGENDA-RUNTIME-V17

	  window.__gdAgendaMontageEditing = false;

	  const setMontajeLocked = (locked, force=false)=>{
	    const ta = qs("#ag_montaje_day");
	    if (locked && window.__gdAgendaMontageEditing && !force) return;
	    if (ta) ta.readOnly = !!locked;
	    const ops = qs("#ag_ops_day");
	    if (ops) ops.readOnly = !!locked;
	    const btnC = qs("#ag_montaje_confirm");
	    const btnE = qs("#ag_montaje_edit");
	    if (btnC) btnC.disabled = false;
	    if (btnE) btnE.disabled = !locked;
	  };

  // ===== Multi-locación (segmentos) =====
  const _segWrap = ()=> qs("#ag_segments_wrap");
  const _segList = ()=> qs("#ag_seg_list");
  const _segAddBtn = ()=> qs("#ag_seg_add");
  const _blkWrap = ()=> qs("#ag_blocks_wrap");
  const _blkList = ()=> qs("#ag_blk_list");
  const _blkAddBtn = ()=> qs("#ag_blk_add");
  const _dayEditorWrap = ()=> qs("#ag_day_editor_wrap");
  const _productsWrap = ()=> qs("#ag_products_wrap");
  let _segDebounce = null;
  const _schedulePreview = ()=>{
    try{
      clearTimeout(_segDebounce);
      _segDebounce = setTimeout(()=>{ try{ runPreview(); }catch(_){ } }, 220);
    }catch(_){}
  };

  const _normalizeBullets = (txt)=>{
    const raw = String(txt || "");
    const lines = raw.split("\n").map(l=>l.trim()).filter(Boolean);
    const out = [];
    for (const ln0 of lines){
      const ln = String(ln0 || "").trim();
      if (!ln) continue;
      const up = ln.toUpperCase();
      if (up === "PRODUCTOS" || up === "PRODUCTOS:" || up === "MONTAJE" || up === "MONTAJE:" || up === "MONTAJE SUGERIDO") continue;
      if (ln.startsWith("•")) out.push(ln);
      else if (ln.startsWith("-")) out.push("• " + ln.replace(/^-+\s*/, ""));
      else out.push("• " + ln);
    }
    return out;
  };

  const _readSegStateFromDOM = ()=>{
    try{
      const list = _segList();
      if (!list) return segState || [];
      const cards = [...list.querySelectorAll("[data-seg-idx]")];
      const next = [];
      for (const card of cards){
        const comuna = (card.querySelector("[data-f='comuna']")?.value || "").trim();
        const direccion = (card.querySelector("[data-f='direccion']")?.value || "").trim();
        const start_time = (card.querySelector("[data-f='start_time']")?.value || "").trim();
        const end_time = (card.querySelector("[data-f='end_time']")?.value || "").trim();
        const ops = Number((card.querySelector("[data-f='ops']")?.value || "").trim() || 0);
        const products_text = (card.querySelector("[data-f='products_text']")?.value || "").trim();
        const montaje_text = (card.querySelector("[data-f='montaje_text']")?.value || "").trim();
        next.push({ comuna, direccion, start_time, end_time, ops, products_text, montaje_text });
      }
      segState = next;
      return segState;
    }catch(_){
      return segState || [];
    }
  };

  const _renderSegments = ()=>{
    const wrap = _segWrap();
    const list = _segList();
    if (!wrap || !list) return;
    const parts = [];
    const n = Math.max(1, (segState || []).length);
    for (let i=0;i<(segState||[]).length;i++){
      const s = segState[i] || {};
      parts.push(`
        <div data-seg-idx="${i}" style="border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.08);display:grid;gap:10px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
            <div class="muted" style="font-weight:1000">Segmento ${i+1}/${n}</div>
            <button type="button" class="swBtn secondary" data-seg-del="${i}" ${n<=1 ? "disabled" : ""} style="white-space:nowrap">Quitar</button>
          </div>
          <div class="agRow" style="gap:12px">
            <label class="agLabel" style="flex:1;min-width:200px">
              <div class="muted">Comuna</div>
              <input class="swInp" data-f="comuna" value="${escapeHtml(s.comuna||"")}" placeholder="Ej: Providencia" />
            </label>
            <label class="agLabel" style="flex:2;min-width:240px">
              <div class="muted">Dirección</div>
              <input class="swInp" data-f="direccion" value="${escapeHtml(s.direccion||"")}" placeholder="Ej: Av. Apoquindo 2730" />
            </label>
          </div>
          <div class="agRow" style="gap:12px">
            <label class="agLabel">
              <div class="muted">Inicio (24h)</div>
              <select class="swSel" data-f="start_time">${TIMES_OPT || `<option value=\"\">—</option>`}</select>
            </label>
            <label class="agLabel">
              <div class="muted">Fin (24h)</div>
              <select class="swSel" data-f="end_time">${TIMES_OPT || `<option value=\"\">—</option>`}</select>
            </label>
            <label class="agLabel" style="width:140px">
              <div class="muted">OPS</div>
              <input class="swInp" type="number" min="1" step="1" data-f="ops" value="${escapeHtml(String(s.ops ?? ""))}" />
            </label>
          </div>
          <label class="agLabel">
            <div class="muted">Productos</div>
            <textarea class="swTa" rows="4" data-f="products_text" placeholder="Ej: 400 Pop corn">${escapeHtml(s.products_text||"")}</textarea>
          </label>
          <label class="agLabel">
            <div class="muted">Montaje</div>
            <textarea class="swTa" rows="3" data-f="montaje_text" placeholder="Ej: 1 x Carro Clásico">${escapeHtml(s.montaje_text||"")}</textarea>
          </label>
        </div>
      `);
    }
    list.innerHTML = parts.join("");

    // Set selects current values + listeners
    [...list.querySelectorAll("[data-seg-idx]")].forEach((card, i)=>{
      const s = segState[i] || {};
      const selA = card.querySelector("select[data-f='start_time']");
      const selB = card.querySelector("select[data-f='end_time']");
      if (selA) selA.value = String(s.start_time || "");
      if (selB) selB.value = String(s.end_time || "");
      card.querySelectorAll("input,textarea,select").forEach((inp)=>{
        inp.addEventListener("input", ()=>{ _readSegStateFromDOM(); _schedulePreview(); });
        inp.addEventListener("change", ()=>{ _readSegStateFromDOM(); _schedulePreview(); });
      });
    });

    list.querySelectorAll("button[data-seg-del]").forEach((b)=>{
      b.addEventListener("click", ()=>{
        const idx = Number(b.getAttribute("data-seg-del") || -1);
        if (!Number.isFinite(idx) || idx < 0) return;
        if ((segState||[]).length <= 1) return;
        _readSegStateFromDOM();
        segState.splice(idx, 1);
        _renderSegments();
        _schedulePreview();
      });
    });
  };

  const _seedSegmentsFromCurrent = ()=>{
    try{
      const loc = (qs("#ag_loc")?.value || "").trim() || (previewEvents[0]?.location || "");
      const dir = (qs("#ag_dir")?.value || "").trim();
      const hIni = (qs("#ag_hini")?.value || "").trim();
      const hFin = (qs("#ag_hfin")?.value || "").trim();
      const ops = Number((qs("#ag_ops_day")?.value || "").trim() || (previewEvents[0]?.ops ?? 1) || 1);
      const prod = (qs("#ag_products_day")?.textContent || "").trim();
      const mt = (qs("#ag_montaje_day")?.value || "").trim();
      const s1 = { comuna: loc, direccion: dir, start_time: hIni, end_time: hFin, ops: (Number.isFinite(ops) && ops>0)?ops:1, products_text: prod, montaje_text: mt };
      const s2 = { comuna: loc, direccion: dir, start_time: hIni, end_time: hFin, ops: 1, products_text: "", montaje_text: "" };
      segState = [s1, s2];
    }catch(_){
      segState = [{ comuna:"", direccion:"", start_time:"", end_time:"", ops:1, products_text:"", montaje_text:"" }];
    }
  };

  const _readBlockStateFromDOM = ()=>{
    try{
      const list = _blkList();
      if (!list) return blockState || [];
      const cards = [...list.querySelectorAll("[data-blk-idx]")];
      const next = [];
      for (const card of cards){
        const day = (card.querySelector("[data-f='day']")?.value || "").trim();
        const label = (card.querySelector("[data-f='label']")?.value || "").trim();
        const comuna = (card.querySelector("[data-f='comuna']")?.value || "").trim();
        const direccion = (card.querySelector("[data-f='direccion']")?.value || "").trim();
        const start_time = (card.querySelector("[data-f='start_time']")?.value || "").trim();
        const end_time = (card.querySelector("[data-f='end_time']")?.value || "").trim();
        const hr_tbd = !!card.querySelector("[data-f='hr_tbd']")?.checked;
        const ops = Number((card.querySelector("[data-f='ops']")?.value || "").trim() || 0);
        const products_text = (card.querySelector("[data-f='products_text']")?.value || "").trim();
        const montaje_text = (card.querySelector("[data-f='montaje_text']")?.value || "").trim();
        next.push({ day, label, comuna, direccion, start_time, end_time, hr_tbd, ops, products_text, montaje_text });
      }
      blockState = next;
      return blockState;
    }catch(_){
      return blockState || [];
    }
  };

  const _renderBlocks = ()=>{
    const wrap = _blkWrap();
    const list = _blkList();
    if (!wrap || !list) return;
    const isBlocks = (agendaMode === "blocks");
    wrap.style.display = isBlocks ? "grid" : "none";
    if (!isBlocks){
      list.innerHTML = "";
      return;
    }
    const blks = Array.isArray(blockState) ? blockState : [];
    const parts = [];
    for (let i=0;i<blks.length;i++){
      const b = blks[i] || {};
      parts.push(`
        <div data-blk-idx="${i}" style="border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;background:rgba(0,0,0,.08);display:grid;gap:10px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
            <div class="muted" style="font-weight:1000">Bloque ${i+1}/${blks.length}</div>
            <button type="button" class="swBtn secondary" data-blk-del="${i}" ${blks.length<=1 ? "disabled" : ""} style="white-space:nowrap">Quitar</button>
          </div>
          <div class="agRow" style="gap:12px;flex-wrap:wrap">
            <label class="agLabel" style="flex:1;min-width:180px">
              <div class="muted">Día</div>
              <input class="swInp" type="date" data-f="day" value="${escapeHtml(String(b.day||"").slice(0,10))}" />
            </label>
            <label class="agLabel" style="flex:1;min-width:200px">
              <div class="muted">Etiqueta (opcional)</div>
              <input class="swInp" data-f="label" value="${escapeHtml(b.label||"")}" placeholder="Montaje / Bloque 1 / etc" />
            </label>
            <label class="agLabel" style="width:140px">
              <div class="muted">OPS</div>
              <input class="swInp" type="number" min="0" step="1" data-f="ops" value="${escapeHtml(String((b.ops!=null)?b.ops:""))}" />
            </label>
          </div>
          <div class="agRow" style="gap:12px;flex-wrap:wrap">
            <label class="agLabel" style="flex:1;min-width:220px">
              <div class="muted">Comuna</div>
              <input class="swInp" data-f="comuna" value="${escapeHtml(b.comuna||"")}" placeholder="Las Condes" />
            </label>
            <label class="agLabel" style="flex:2;min-width:260px">
              <div class="muted">Dirección</div>
              <input class="swInp" data-f="direccion" value="${escapeHtml(b.direccion||"")}" placeholder="Dirección completa" />
            </label>
          </div>
          <div class="agRow">
            <label class="agLabel">
              <div class="muted">Inicio</div>
              <input class="swInp" data-f="start_time" value="${escapeHtml(b.start_time||"")}" placeholder="18:00" />
            </label>
            <label class="agLabel">
              <div class="muted">Fin</div>
              <input class="swInp" data-f="end_time" value="${escapeHtml(b.end_time||"")}" placeholder="23:00" />
            </label>
            <label style="display:flex;align-items:center;gap:8px;margin-top:26px">
              <input data-f="hr_tbd" type="checkbox" ${b.hr_tbd ? "checked" : ""} />
              <span class="muted" style="font-weight:1000">HR TBD</span>
            </label>
          </div>
          <label class="agLabel">
            <div class="muted">Productos (opcional; si lo dejas vacío se calcula por día)</div>
            <textarea class="swTa" rows="4" data-f="products_text" placeholder="• ...">${escapeHtml(b.products_text||"")}</textarea>
          </label>
          <label class="agLabel">
            <div class="muted">Montaje (opcional; si lo dejas vacío se sugiere)</div>
            <textarea class="swTa" rows="4" data-f="montaje_text" placeholder="• ...">${escapeHtml(b.montaje_text||"")}</textarea>
          </label>
        </div>
      `);
    }
    list.innerHTML = parts.join("");
    list.querySelectorAll("[data-blk-idx] input,[data-blk-idx] textarea").forEach((inp)=>{
      inp.addEventListener("input", ()=>{ _readBlockStateFromDOM(); _schedulePreview(); });
      inp.addEventListener("change", ()=>{ _readBlockStateFromDOM(); _schedulePreview(); });
    });
    list.querySelectorAll("button[data-blk-del]").forEach((b)=>{
      b.addEventListener("click", ()=>{
        const idx = Number(b.getAttribute("data-blk-del") || -1);
        if (!Number.isFinite(idx) || idx < 0) return;
        if ((blockState||[]).length <= 1) return;
        _readBlockStateFromDOM();
        blockState.splice(idx, 1);
        _renderBlocks();
        _schedulePreview();
      });
    });
  };

	  const _deriveAgendaMode = ()=>{
	    const f = _flags();
	    if (f.blocks) return "blocks";
	    if (f.multiloc) return "multiloc";
	    if (f.multiday) return "multiday";
	    return "simple";
	  };

	  const _flagsKey = ()=>{
	    const f = _flags();
	    const b = f.blocks ? "1" : "0";
	    const d = f.multiday ? "1" : "0";
	    const l = f.multiloc ? "1" : "0";
	    return `${b}${d}${l}`;
	  };

	  const _syncModalitySelect = ()=>{
	    const sel = qs("#ag_modality");
	    if (!sel) return;
	    const k = _flagsKey(); // b d l
	    const map = {
	      "000":"simple",
	      "010":"multiday",
	      "001":"multiloc",
	      "100":"blocks",
	      "110":"multiday_blocks",
	      "011":"multiday_multiloc",
	      "101":"blocks_multiloc",
	      "111":"multiday_blocks_multiloc",
	    };
	    const v = map[k] || "simple";
	    if (String(sel.value) !== v) sel.value = v;
	  };

  const _applyMultiLocUI = ()=>{
	    const mode = (agendaMode === "blocks") ? "blocks" : ((agendaMode === "multiloc") ? "segments" : "day");
	    const wrap = _segWrap();
	    const wrapB = _blkWrap();
	    const dayHdr = qs("#ag_day_hdr");
	    const dayMont = qs("#ag_day_montaje_wrap");
	    const prodW = _productsWrap();
	    // Con el nuevo "modelador", NO mostramos los editores legacy de segmentos/bloques.
	    if (wrap) wrap.style.display = "none";
	    if (wrapB) wrapB.style.display = "none";
	    if (dayHdr) dayHdr.textContent = (mode === "segments") ? "Segmentos" : ((mode === "blocks") ? "Bloques" : "Agenda por día");
	    if (dayMont) dayMont.style.display = (mode === "day") ? "" : "none";
	    if (prodW) prodW.style.display = (mode === "day") ? "" : "none";
	  };

  const renderDayTabs = ()=>{
    const wrap = qs("#ag_day_tabs");
    if (!wrap) return;
    const qSel = (qs("#ag_quote")?.value || "manual").toString().trim() || "manual";
    const quoteSource = (qSel === "manual") ? "manual" : "cotizador";
    const mode = (agendaMode === "blocks") ? "blocks" : ((agendaMode === "multiloc") ? "segments" : "day");
    const showTabs = (mode !== "blocks") && (previewEvents.length > 1);
    wrap.style.display = showTabs ? "flex" : "none";
    if (!showTabs){
      wrap.innerHTML = "";
      return;
    }
	    const parts = [];
	    for (let i=0;i<previewEvents.length;i++){
	      const e = previewEvents[i] || {};
      const d = String(e.day || "").slice(0,10);
      const lab = String(e.label || "").trim() || `Día ${i+1}/${previewEvents.length} · ${d || "-"}`;
      parts.push(`<button type="button" class="swBtn ${i===selectedIdx ? "" : "secondary"}" data-ag-day="${i}" style="padding:8px 10px;border-radius:999px">${escapeHtml(lab)}</button>`);
    }
    wrap.innerHTML = parts.join("");
    wrap.querySelectorAll("button[data-ag-day]").forEach((b)=>{
      b.addEventListener("click", ()=>{
        const i = Number(b.getAttribute("data-ag-day") || 0);
        if (!Number.isFinite(i)) return;
        if (i === selectedIdx) return;
        saveCurrentDay();
        selectedIdx = Math.max(0, Math.min(previewEvents.length-1, i));
        renderDayTabs();
        renderPreviewForSelectedDay();
      });
    });
  };

  const renderPreviewForSelectedDay = ()=>{
    const ev = previewEvents[selectedIdx] || {};
    const day = String(ev.day || "").trim();

    if (!touched.title && qs("#ag_title")) qs("#ag_title").value = ev.title || "";
    if (!touched.loc && qs("#ag_loc")) qs("#ag_loc").value = ev.location || "";
    // "Descripción" es un override opcional. No la llenamos con el auto-preview para no confundir.
    if (!touched.desc && qs("#ag_desc")) qs("#ag_desc").value = "";

    const ed = (day && dayEdits[day]) ? dayEdits[day] : null;
    const td = (day && touchedDay[day]) ? touchedDay[day] : { ops:false, montaje:false };

    if (qs("#ag_ops_day") && !td.ops) qs("#ag_ops_day").value = (ed?.ops ?? (ev.ops != null ? String(ev.ops) : "")) || "";
    if (qs("#ag_montaje_day") && !td.montaje) qs("#ag_montaje_day").value = (ed?.montaje ?? (ev.montaje_text || "")) || "";
    if (qs("#ag_products_day")) qs("#ag_products_day").textContent = ev.products_text || "(sin productos)";
    if (qs("#ag_preview_day")) qs("#ag_preview_day").textContent = ev.description || "";

    // por defecto: montaje bloqueado (profesional). El usuario debe presionar "Editar".
    setMontajeLocked(true);
  };

  const runPreview = async ()=>{
    const st = qs("#ag_calc_status");
    if (!setupApplied){
      if (st) st.textContent = "Arma el set up para previsualizar…";
      return;
    }
    const qSel = (qs("#ag_quote")?.value || "manual").toString().trim() || "manual";
    const quoteSource = (qSel === "manual") ? "manual" : "cotizador";
    const idCot = (quoteSource === "cotizador") ? qSel : null;
            const daysN = Math.max(1, Number(qs("#ag_days_n")?.value || 1) || 1);
			      const hIni = (qs("#ag_hini")?.value || "").trim();
			      const hFin = (qs("#ag_hfin")?.value || "").trim();
			      const hrTbd = !!qs("#ag_hrtbd")?.checked || !hIni || !hFin;
    const tel = (qs("#ag_tel")?.value || "").trim();
    const dir = (qs("#ag_dir")?.value || "").trim();
    const notes = (qs("#ag_notes")?.value || "").trim();
    const montGlobal = (qs("#ag_mont_manual")?.value || "").trim();
    _readGroupsFromDOM();
    agendaMode = _deriveAgendaMode();
    const fNow = _flags();
    const isBlocks = !!fNow.blocks;
    const isMultiLoc = !!fNow.multiloc;
    const isMultiDay = !!fNow.multiday;
    _applyMultiLocUI();

    // En varios días las fechas nunca se inventan: cada una debe elegirla el ejecutivo.
    if (isMultiDay && (setupGroups || []).some((g) => !String(g.day || "").trim())) {
      previewEvents = [];
      if (st) st.textContent = "Selecciona la fecha de cada día para calcular montaje.";
      return;
    }

    // Si hay más de 1 grupo, exige asignación completa antes de previsualizar (evita eventos incorrectos).
    try{
      if (Array.isArray(setupGroups) && setupGroups.length > 1){
        _updateAllocStatus();
        const missing = [];
        for (const it of (allocPool||[])){
          const prod = String(it.producto||"").trim();
          const total = Number(it.cantidad||0) || 0;
          const used = _allocatedTotalFor(prod);
          const rem = total - used;
          if (rem > 0.0001) missing.push(prod);
        }
        if (missing.length){
          if (st) st.textContent = "Asigna productos para previsualizar (faltan: " + missing.slice(0,4).join(", ") + (missing.length>4 ? "…" : "") + ")";
          return;
        }
      }
    }catch(_){}

    if (st) st.textContent = "Calculando…";
    try{
      const modelPayload = _groupsToPayload();
      // Overrides por día (OPS/Montaje) deben entrar en el preview (dry_run)
      // para que se vea el resultado antes de confirmar.
      const overrideByDay = [];
      try{
        for (const [day, ed] of Object.entries(dayEdits || {})){
          const d = String(day || "").slice(0,10);
          if (!d) continue;
          const row = { day: d };
          const opsV = String(ed?.ops ?? "").trim();
          const mtV = String(ed?.montaje ?? "").trim();
          if (opsV !== "") row.ops = Number(opsV);
          if (mtV) row.montaje_text = mtV;
          if (row.ops != null || row.montaje_text) overrideByDay.push(row);
        }
      }catch(_){}
      const out = await apiJSON(`/leads/${lead.id_lead}/move`, {
        method:"POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({
          id_estado: Number(newEstado),
          movement_comment: statusComment,
          agendar: true,
          dry_run: true,
          quote_source: quoteSource,
          ...(idCot ? { id_cotizacion: Number(idCot) } : {}),
          telefono: tel,
          direccion: dir,
          ...(notes ? { agenda_notes: notes } : {}),
          ...(montGlobal ? { override_montaje_text: montGlobal } : {}),
          ...(overrideByDay.length ? { override_by_day: overrideByDay } : {}),
          ...(qs("#ag_flag_montaje_event")?.checked ? {
            montaje_event: {
              day: String(qs("#ag_mont_day")?.value || "").slice(0,10),
              start_time: String(qs("#ag_mont_hini")?.value || "").trim(),
              end_time: String(qs("#ag_mont_hfin")?.value || "").trim(),
              comuna: String(qs("#ag_mont_loc")?.value || "").trim(),
              direccion: String(qs("#ag_mont_dir")?.value || "").trim(),
            }
          } : {}),
          ...( (isBlocks || isMultiLoc) ? { hr_tbd: false, start_time: hIni, end_time: hFin } : (hrTbd ? { hr_tbd: true } : { start_time: hIni, end_time: hFin, hr_tbd: false }) ),
          ...modelPayload,
          // Si es Multi día, NO forzar evento único aunque el modo diga "simple".
          ...( (!isBlocks && !isMultiLoc) ? {
            force_single_day: (!isMultiDay ? 1 : 0),
            multi_day_mode: (isMultiDay ? 1 : 0),
            days_n: (isMultiDay ? daysN : 1),
          } : {}),
        })
      });
      previewEvents = (Array.isArray(out?.eventos) && out.eventos.length) ? out.eventos : (out?.evento ? [out.evento] : []);
      if (selectedIdx >= previewEvents.length) selectedIdx = 0;
      renderDayTabs();
      renderPreviewForSelectedDay();
      if (st) st.textContent = "Listo";
	    }catch(err){
	      previewEvents = [];
	      const allocationOk = /^OK:/i.test(String(qs("#ag_alloc_status")?.textContent || "").trim());
	      const assignedText = (setupGroups || []).length === 1
	        ? _mapToLines((setupGroups[0] || {}).products_map || {})
	        : "";
	      const productEl = qs("#ag_products_day");
	      if (productEl) {
	        if (assignedText) productEl.textContent = assignedText;
	        else if (!allocationOk) productEl.textContent = "(sin productos)";
	      }
	      if (qs("#ag_preview_day")) qs("#ag_preview_day").textContent = "";
	      const msg = String(err?.message || err);
	      if (st) st.textContent = msg;
	      try{ toast("Error en previsualización: " + msg, "error"); }catch(_){}
	    }
	  };

			  const res = await Swal.fire({
			    title:"Confirmar + Agenda",
			    html,
			    width: 1040,
		    focusConfirm:false,
		    showCancelButton:true,
		    confirmButtonText:"Confirmar y crear en Calendar",
		    cancelButtonText:"Cancelar",
		    heightAuto:false,
			    customClass: { popup: "gdAgenda" },
				    didOpen: async ()=>{
              // Guard anti-caídas: si hay error JS dentro del modal, mostramos feedback y evitamos quedar “en blanco”.
              // Importante: NO cerramos el modal (anti-tontos).
              try{
                const onErr = (ev)=>{
                  try{
                    const msg = String(ev?.message || ev?.error?.message || ev?.error || "Error interno");
                    const st = qs("#ag_calc_status");
                    if (st) st.textContent = "Error: " + msg;
                    toast("Error interno en Agenda: " + msg, "error");
                  }catch(_){}
                };
                window.addEventListener("error", onErr);
                window.addEventListener("unhandledrejection", (ev)=>onErr({ message: (ev?.reason?.message || ev?.reason || "Promise rechazada") }));
                // cleanup
                Swal.getPopup()?.addEventListener("swal2:close", ()=>{
                  try{ window.removeEventListener("error", onErr); }catch(_){}
                }, { once:true });
              }catch(_){}

			      const q = qs("#ag_quote");
			      if (q) q.value = defaultSel || "manual";
	
	      // Horas (24h) - selector estable en iOS/Android (evita pickers 12h).
	      TIMES = (() => {
	        const out = [];
	        for (let h = 0; h < 24; h++) {
	          for (const m of [0, 15, 30, 45]) {
	            out.push(String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0"));
	          }
	        }
	        return out;
	      })();
	      TIMES_OPT = `<option value="">—</option>` + TIMES.map((t) => `<option value="${t}">${t}</option>`).join("");
	      const fillSel = (id) => {
	        const el = qs(id);
	        if (!el) return;
	        el.innerHTML = TIMES_OPT;
	      };
	      fillSel("#ag_hini");
	      fillSel("#ag_hfin");
        fillSel("#ag_mont_hini");
        fillSel("#ag_mont_hfin");

      const timeFromDT = (v) => {
        if (!v) return "";
        try {
          const d = new Date(v);
          if (isNaN(d.getTime())) return "";
          return String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
        } catch (_) {
          return "";
        }
      };
      const preStart = lead?.pre_start || lead?.calendar_start || lead?.hora_inicio || "";
      const preEnd = lead?.pre_end || lead?.calendar_end || lead?.hora_fin || "";
      const hini0 = timeFromDT(preStart) || String(preStart || "").slice(0, 5);
      const hfin0 = timeFromDT(preEnd) || String(preEnd || "").slice(0, 5);
      if (hini0 && hfin0) {
        if (qs("#ag_hini")) qs("#ag_hini").value = TIMES.includes(hini0) ? hini0 : hini0;
        if (qs("#ag_hfin")) qs("#ag_hfin").value = TIMES.includes(hfin0) ? hfin0 : hfin0;
        if (qs("#ag_hrtbd")) qs("#ag_hrtbd").checked = false;
      } else {
        if (qs("#ag_hrtbd")) qs("#ag_hrtbd").checked = true;
      }

      // Defaults montaje previo: día anterior, misma comuna/dirección y rango 09:00-10:00.
      try{
        const dLead = String(lead.fecha_evento || "").slice(0,10) || (new Date()).toISOString().slice(0,10);
        const dMont = _datePlusDays(dLead, -1);
        if (qs("#ag_mont_day")) qs("#ag_mont_day").value = dMont;
        if (qs("#ag_mont_hini")) qs("#ag_mont_hini").value = "09:00";
        if (qs("#ag_mont_hfin")) qs("#ag_mont_hfin").value = "10:00";
        if (qs("#ag_mont_loc")) qs("#ag_mont_loc").value = (qs("#ag_loc")?.value || "").trim();
        if (qs("#ag_mont_dir")) qs("#ag_mont_dir").value = (qs("#ag_dir")?.value || "").trim();
      }catch(_){}

	      const editManualBtn = qs("#ag_edit_manual");
	      const refreshManualBtn = ()=>{
	        const v = (qs("#ag_quote")?.value || "").toString().trim();
	        if (editManualBtn) editManualBtn.style.display = (v === "manual") ? "" : "none";
	      };
      refreshManualBtn();
      q && q.addEventListener("change", async ()=>{ refreshManualBtn(); await runPreview(); });

	      qs("#ag_title") && qs("#ag_title").addEventListener("input", ()=>{ touched.title=true; });
	      qs("#ag_loc") && qs("#ag_loc").addEventListener("input", ()=>{ touched.loc=true; });
	      qs("#ag_desc") && qs("#ag_desc").addEventListener("input", ()=>{ touched.desc=true; });
	      qs("#ag_notes") && qs("#ag_notes").addEventListener("input", runPreview);
        // Montaje global: debe reflejarse de inmediato en preview (no solo al final).
        try{
          let _mtDeb = null;
          const mt = qs("#ag_mont_manual");
          if (mt){
            mt.addEventListener("input", ()=>{
              try{ clearTimeout(_mtDeb); }catch(_){}
              _mtDeb = setTimeout(()=>{ try{ runPreview(); }catch(_){ } }, 250);
            });
          }
        }catch(_){}
        // Modelador: reacciona EN VIVO a flags/cantidades/cotización.
        try{
          const st0 = qs("#ag_calc_status");
          const hint = qs("#ag_alloc_hint");

          const loadPool = async ()=>{
            const qSel = (qs("#ag_quote")?.value || "manual").toString().trim() || "manual";
            const quoteSource = (qSel === "manual") ? "manual" : "cotizador";
            if (hint) hint.textContent = (quoteSource === "cotizador")
              ? "Productos desde cotización (cotizador). Asigna por grupo."
              : "Productos manuales (lead_mice_items). Asigna por grupo.";
            let items = [];
            if (quoteSource === "cotizador"){
              try{
                const out = await apiJSON(`/quotes/${Number(qSel)}/items`);
                items = Array.isArray(out?.items) ? out.items : [];
              }catch(e){
                items = [];
                try{
                  const m = String(e?.message || e || "");
                  if (st0) st0.textContent = m;
                }catch(_){}
              }
            }else{
              try{
                const out = await apiJSON(`/leads/${lead.id_lead}/mice_items`);
                items = Array.isArray(out?.items) ? out.items : [];
              }catch(_){ items = []; }
            }
            const map = {};
            for (const it of (items||[])){
              const p = String(it.producto || it.nombre || "").trim();
              const q = Number(it.cantidad || it.qty || 0) || 0;
              if (!p || !(q>0)) continue;
              map[p] = (Number(map[p]||0) || 0) + q;
            }
            allocPool = Object.keys(map).sort((a,b)=>a.localeCompare(b)).map(p=>({ producto:p, cantidad: map[p] }));
            allocTotals = {};
            for (const it of allocPool) allocTotals[it.producto] = Number(it.cantidad||0) || 0;
          };

          const clearAlloc = ()=>{
            for (const g of (setupGroups||[])){
              g.products_map = {};
            }
          };

          const autoAllocateIfSingle = ()=>{
            if (!Array.isArray(setupGroups) || setupGroups.length !== 1) return;
            const g = setupGroups[0];
            g.products_map = {};
            for (const it of (allocPool||[])){
              const p = String(it.producto||"").trim();
              const q = Number(it.cantidad||0) || 0;
              if (!p || !(q>0)) continue;
              g.products_map[p] = q;
            }
            const assignedText = _mapToLines(g.products_map || {});
            const productEl = qs("#ag_products_day");
            if (productEl) productEl.textContent = assignedText || "(sin productos)";
            const allocStatus = qs("#ag_alloc_status");
            if (allocStatus && assignedText) allocStatus.textContent = "OK: todos los productos están asignados.";
          };

	          const rebuild = async (why="")=>{
	            setupApplied = true;
	            _setCountsEnabled();
	            agendaMode = _deriveAgendaMode();
	            _syncModalitySelect();
	            _buildGroupsFromFlags();
	            await loadPool();
            // Si cambia estructura, limpiamos asignación (salvo modo simple 1 grupo).
            clearAlloc();
            autoAllocateIfSingle();
            _renderGroupEditor();
            _renderAllocPool();
            _updateAllocStatus();
            // UX: en evento simple (sin flags), ocultar modelador/allocator (se autoasigna).
            try{
              const f = _flags();
              const simple = (!f.blocks && !f.multiday && !f.multiloc);
              const ed = qs("#ag_setup_editor");
              const alloc = qs("#ag_products_allocator");
              if (ed) ed.style.display = simple ? "none" : "grid";
              if (alloc) alloc.style.display = simple ? "none" : "grid";
            }catch(_){}
            if (st0){
              st0.textContent = (why ? (`Modelador: ${why}`) : "Modelador listo");
            }
            await runPreview();
          };

	          // wire flags + counts
	          ["#ag_flag_blocks","#ag_flag_multiday","#ag_flag_multiloc","#ag_blocks_n","#ag_locs_n","#ag_days_n"].forEach((id)=>{
	            const el = qs(id);
	            if (!el) return;
	            el.addEventListener("change", ()=>{ rebuild("cambio set up").catch(_=>{}); });
	            el.addEventListener("input", ()=>{ rebuild("cambio set up").catch(_=>{}); });
	          });

	          // modalidad: toggles convenientes para probar/cubrir casos (simple/multiday/multiloc/blocks y combinaciones)
	          try{
	            const selMod = qs("#ag_modality");
	            if (selMod){
	              selMod.addEventListener("change", ()=>{
	                _setModality(selMod.value);
	                rebuild("modalidad").catch(_=>{});
	              });
	            }
	          }catch(_){}

          // montaje previo (evento separado)
          const chkM = qs("#ag_flag_montaje_event");
          const boxM = qs("#ag_montaje_event_box");
          if (chkM && boxM){
            chkM.addEventListener("change", ()=>{
              boxM.style.display = chkM.checked ? "grid" : "none";
            });
            boxM.style.display = chkM.checked ? "grid" : "none";
          }

          // quote change: recarga pool + reasigna si 1 grupo
          q && q.addEventListener("change", ()=>{ rebuild("cambio cotización").catch(_=>{}); });

          // Inicial: arma setup base
          rebuild("inicio").catch(_=>{});
        }catch(_){}

      // Toggle: ocultar/mostrar bloque de set up completo (sin perder estado)
      try{
        const btnT = qs("#ag_setup_toggle");
        const bodyT = qs("#ag_setup_body");
        if (btnT && bodyT){
          btnT.addEventListener("click", ()=>{
            const isHidden = bodyT.style.display === "none";
            bodyT.style.display = isHidden ? "grid" : "none";
            btnT.textContent = isHidden ? "Ocultar" : "Mostrar";
          });
        }
      }catch(_){}

	      // Abono: si es 0, exige OC o fecha de abono (para que finanzas tenga trazabilidad).
	      const abEl = qs("#ag_abono");
	      const abWrap = qs("#ag_abono_extra");
	      const abMode = qs("#ag_abono_mode");
	      const abOC = qs("#ag_abono_oc");
	      const abFecha = qs("#ag_abono_fecha");
	      const parseAbono = ()=>{
	        try{
	          const raw = String(abEl?.value || "");
	          if (!raw.trim()) return 0;
	          const s = raw.replace(/[^0-9,.\-]/g,"").replace(/\\./g,"").replace(/,/g,".");
	          const n = Number(s);
	          return Number.isFinite(n) ? n : 0;
	        }catch(_){ return 0; }
	      };
	      const syncAbMode = ()=>{
	        const m = (abMode?.value || "").toString().trim();
	        if (abOC) abOC.style.display = (m === "oc") ? "" : "none";
	        if (abFecha) abFecha.style.display = (m === "fecha") ? "" : "none";
	      };
	      const syncAbUI = ()=>{
	        const ab = parseAbono();
	        const show = !(ab > 0);
	        if (abWrap) abWrap.style.display = show ? "" : "none";
	        if (!show){
	          if (abMode) abMode.value = "";
	          if (abOC){ abOC.value = ""; abOC.style.display = "none"; }
	          if (abFecha){ abFecha.value = ""; abFecha.style.display = "none"; }
	        }else{
	          syncAbMode();
	        }
	      };
	      abEl && abEl.addEventListener("input", ()=>{ syncAbUI(); runPreview(); });
	      abMode && abMode.addEventListener("change", ()=>{ syncAbMode(); runPreview(); });
	      abOC && abOC.addEventListener("input", runPreview);
	      abFecha && abFecha.addEventListener("change", runPreview);
	      syncAbUI();

      const ensureDayTouched = (day)=>{
        if (!day) return { ops:false, montaje:false };
        if (!touchedDay[day]) touchedDay[day] = { ops:false, montaje:false };
        if (!dayEdits[day]) dayEdits[day] = {};
        return touchedDay[day];
      };
      const currentDay = ()=>{
        const e = previewEvents[selectedIdx] || {};
        return String(e.day || "").slice(0,10);
      };

      // Al editar OPS/Montaje por día, debe reflejarse de inmediato (sin esperar confirmar).
      // Debounce para no saturar Passenger.
      let _dayDeb = null;
      const _debPreview = ()=>{
        try{ clearTimeout(_dayDeb); }catch(_){}
        _dayDeb = setTimeout(()=>{ try{ runPreview(); }catch(_){ } }, 260);
      };

      qs("#ag_ops_day") && qs("#ag_ops_day").addEventListener("input", ()=>{
        const day = currentDay();
        const td = ensureDayTouched(day);
        td.ops = true;
        saveCurrentDay();
        _debPreview();
      });
      qs("#ag_montaje_day") && qs("#ag_montaje_day").addEventListener("input", ()=>{
        const day = currentDay();
        const td = ensureDayTouched(day);
        td.montaje = true;
        saveCurrentDay();
        _debPreview();
      });

	      qs("#ag_montaje_edit") && (qs("#ag_montaje_edit").onclick = ()=>{
	        window.__gdAgendaMontageEditing = true;
	        setMontajeLocked(false);
	        const ta = qs("#ag_montaje_day");
	        ta && ta.focus && ta.focus();
	      });
		      qs("#ag_montaje_confirm") && (qs("#ag_montaje_confirm").onclick = ()=>{
		        const isLocked = !!qs("#ag_montaje_day")?.readOnly;
		        const txt = isLocked
		          ? "¿Confirmas el montaje sugerido para este día?"
		          : "¿Guardar/confirmar los cambios de montaje para este día?";
		        // Importante: NO abrir otro SweetAlert aquí (SweetAlert2 no soporta modales anidados).
		        // Usamos confirm nativo para no cerrar el modal de agenda.
		        if (!window.confirm(txt)) return;
		        saveCurrentDay();
		        setMontajeLocked(true);
		        toast("Montaje confirmado", "success");
		      });

	      editManualBtn && (editManualBtn.onclick = async ()=>{
	        const okMeta = await ensureQuoteMeta();
	        if (!okMeta) return;
	        const okItems = await ensureManualMiceItems();
	        if (!okItems) return;
	        // SweetAlert2 no soporta modales anidados: al abrir el editor se cerró este modal.
	        // Reabrimos el flujo para que el usuario continúe con los productos ya cargados.
	        setTimeout(()=>{ try{ handleConfirmado(lead, newEstado); }catch(_){ } }, 50);
	      });

      const updDur = ()=>{
        const el = qs("#ag_duracion");
        if (!el) return;
        const hIni = (qs("#ag_hini")?.value || "").trim();
        const hFin = (qs("#ag_hfin")?.value || "").trim();
        const hrTbd = !!qs("#ag_hrtbd")?.checked || !hIni || !hFin;
        if (hrTbd || !hIni || !hFin){
          el.textContent = "Duración: —";
          return;
        }
        const parse = (hhmm)=>{
          const m = String(hhmm||"").match(/^\\s*(\\d{1,2}):(\\d{2})\\s*$/);
          if (!m) return null;
          const h = Number(m[1]); const mi = Number(m[2]);
          if (!Number.isFinite(h) || !Number.isFinite(mi) || h<0 || h>23 || mi<0 || mi>59) return null;
          return h*60 + mi;
        };
        const a = parse(hIni), b = parse(hFin);
        if (a == null || b == null){
          el.textContent = "Duración: —";
          return;
        }
        let d = b - a;
        if (d < 0) d += 24*60; // cruza medianoche
        const hh = Math.floor(d/60);
        const mm = d%60;
        el.textContent = `Duración: ${hh}h ${mm.toString().padStart(2,"0")}m`;
      };

      qs("#ag_hrtbd") && qs("#ag_hrtbd").addEventListener("change", ()=>{ updDur(); runPreview(); });
      qs("#ag_hini") && qs("#ag_hini").addEventListener("change", ()=>{ updDur(); runPreview(); });
      qs("#ag_hfin") && qs("#ag_hfin").addEventListener("change", ()=>{ updDur(); runPreview(); });
      qs("#ag_tel") && qs("#ag_tel").addEventListener("change", runPreview);
      qs("#ag_dir") && qs("#ag_dir").addEventListener("change", runPreview);

      // Montaje builder (manual vs lista)
      const montWrap = qs("#ag_mont_list_wrap");
      const montManual = qs("#ag_mont_manual");
      const montList = qs("#ag_mont_list");
      const montHint = qs("#ag_mont_list_hint");
      let invCache = null; // [{id_producto,nombre,categoria}]
      let invSel = {}; // id_producto -> qty
      const getMontMode = ()=> (qs("input[name='ag_mont_mode']:checked")?.value || "manual").toString();
      const setMontUI = ()=>{
        const mode = getMontMode();
        if (montWrap) montWrap.style.display = (mode === "lista") ? "grid" : "none";
        if (montManual) montManual.style.display = "";
      };
      document.querySelectorAll("input[name='ag_mont_mode']").forEach(r=>{
        r.addEventListener("change", ()=>{ setMontUI(); });
      });
      setMontUI();

      const renderInv = (q="")=>{
        if (!montList) return;
        const qq = String(q||"").trim().toLowerCase();
        const items = Array.isArray(invCache) ? invCache : [];
        const filtered = qq ? items.filter(it=>{
          const n = String(it.nombre||"").toLowerCase();
          const c = String(it.categoria||"").toLowerCase();
          return n.includes(qq) || c.includes(qq);
        }) : items;
        const take = filtered.slice(0, 80);
        montList.innerHTML = take.map(it=>{
          const id = Number(it.id_producto||0);
          const qty = invSel[id] != null ? Number(invSel[id]) : 0;
          return `
            <div style="display:flex;gap:10px;align-items:center;justify-content:space-between;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:8px 10px;background:rgba(0,0,0,.10)">
              <div style="min-width:0">
                <div style="font-weight:1000;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(String(it.nombre||"Producto"))}</div>
                <div class="muted agSmall" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(String(it.categoria||""))}</div>
              </div>
              <input class="swInp" data-inv-qty="${id}" type="number" min="0" step="1" value="${escapeHtml(String(qty||0))}" style="width:96px;text-align:center" />
            </div>
          `;
        }).join("") || `<div class="muted">Sin items.</div>`;
        montList.querySelectorAll("input[data-inv-qty]").forEach(inp=>{
          inp.addEventListener("input", ()=>{
            const id = Number(inp.getAttribute("data-inv-qty")||0);
            const v = Number(String(inp.value||"").trim()||0);
            if (Number.isFinite(id) && id>0){
              if (Number.isFinite(v) && v>0) invSel[id] = v;
              else delete invSel[id];
            }
          });
        });
      };

      qs("#ag_mont_search") && qs("#ag_mont_search").addEventListener("input", ()=>{
        renderInv(qs("#ag_mont_search")?.value||"");
      });

      const loadInv = async ()=>{
        try{
          if (montHint) montHint.textContent = "Cargando desde Inventario…";
          const out = await apiJSON("/ops/inventario/productos?q=");
          const items = Array.isArray(out?.items) ? out.items : [];
          invCache = items.map(it=>({
            id_producto: it.id_producto,
            nombre: String(it.nombre||"").trim(),
            categoria: String(it.categoria||"").trim(),
          })).filter(x=>x.id_producto && x.nombre);
          if (montHint) montHint.textContent = `Lista cargada: ${invCache.length} items.`;
          renderInv(qs("#ag_mont_search")?.value||"");
        }catch(e){
          if (montHint) montHint.textContent = "No pude cargar Inventario (sin permisos o error). Usa Manual.";
        }
      };
      qs("#ag_mont_reload") && qs("#ag_mont_reload").addEventListener("click", ()=>{ loadInv(); });

      qs("#ag_mont_apply") && qs("#ag_mont_apply").addEventListener("click", ()=>{
        const items = Array.isArray(invCache) ? invCache : [];
        const lines = [];
        for (const [idStr, qty] of Object.entries(invSel||{})){
          const id = Number(idStr||0);
          const it = items.find(x=>Number(x.id_producto)===id);
          if (!it) continue;
          const q = Number(qty||0);
          if (!(q>0)) continue;
          lines.push(`${q} x ${it.nombre}`);
        }
        const txt = lines.join("\n").trim();
        if (montManual){
          montManual.value = txt || montManual.value || "";
        }
        toast("Montaje aplicado", "success");
      });
	      // Modelador: el armado de set up se hace con el botón "Armar set up".
	      _applyMultiLocUI();
	      updDur();
	      await runPreview();
		    },
			    preConfirm: ()=>{
		      const qSel = (qs("#ag_quote")?.value || "manual").toString().trim() || "manual";
		      const quoteSource = (qSel === "manual") ? "manual" : "cotizador";
		      const idCot = (quoteSource === "cotizador") ? qSel : null;
			      agendaMode = _deriveAgendaMode();
		      const fConfirm = _flags();
		      const blocks = !!fConfirm.blocks;
		      const multiLoc = !!fConfirm.multiloc;
		      const multiDay = !!fConfirm.multiday;
		      const forceSingleDay = (agendaMode === "simple") ? 1 : 0;
          // Anti-tontos: exigir completar cantidades según flags (claridad inmediata).
          try{
            const dn = Number(qs("#ag_days_n")?.value || 0) || 0;
            const ln = Number(qs("#ag_locs_n")?.value || 0) || 0;
            const bn = Number(qs("#ag_blocks_n")?.value || 0) || 0;
            if ((multiDay || (blocks && !!qs("#ag_flag_multiday")?.checked)) && dn < 2){
              Swal.showValidationMessage("Multi día: indica cantidad de días (>=2).");
              return false;
            }
            if (multiLoc && ln < 2){
              Swal.showValidationMessage("Multi locación: indica cantidad de locaciones (>=2).");
              return false;
            }
            if (blocks && bn < 1){
              Swal.showValidationMessage("Evento por bloques: indica cantidad de bloques (>=1).");
              return false;
            }
          }catch(_){}
		      const hIni = (qs("#ag_hini")?.value || "").trim();
		      const hFin = (qs("#ag_hfin")?.value || "").trim();
		      const hrTbd = !!qs("#ag_hrtbd")?.checked || !hIni || !hFin;
			      if (!setupApplied){
			        Swal.showValidationMessage("Primero debes armar el set up.");
			        return false;
			      }
            // Anti-tontos: si el preview no tiene productos/montaje, NO dejamos confirmar
            // (esto evita eventos en Calendar con MONTAJE: — y sin lista de productos).
            try{
              const ev0 = (Array.isArray(previewEvents) && previewEvents.length) ? (previewEvents[0] || {}) : null;
              const pt = String(ev0?.products_text || ev0?.productos || "").trim();
              const hasPt = pt && pt.toUpperCase() !== "PRODUCTOS" && pt.length >= 6;
              if (!hasPt){
                Swal.showValidationMessage("Faltan productos para calcular montaje. Revisa la cotización seleccionada o carga Manual.");
                return false;
              }
            }catch(_){}
	          // En modo SIMPLE (incluye MULTI-DÍA), no se duplica info:
	          // NO usamos modelador/grupos ni asignación por producto.
	          // Solo se usan los campos globales (tel/dir/location/horas) y el backend construye el/los evento(s).
	          // Multi-día se resuelve por `multi_day_mode=1` + agrupación por día en backend.
	          const isSimple = (!multiLoc && !blocks && !multiDay);
	          if (!isSimple){
			        _readGroupsFromDOM();
			        _updateAllocStatus();
			        // Validación: no puede quedar producto sin asignar
			        const missing = [];
		        for (const it of (allocPool||[])){
		          const prod = String(it.producto||"").trim();
		          const total = Number(it.cantidad||0) || 0;
		          const used = _allocatedTotalFor(prod);
		          const rem = total - used;
		          if (rem > 0.0001) missing.push(prod);
		        }
		        if (missing.length){
              _showMissingAllocAlert(missing);
		          Swal.showValidationMessage("Faltan productos por asignar. Revisa el listado en Set up.");
		          return false;
		        }
          }
		      if (!multiLoc && !blocks){
            // Horas globales: en evento simple no obligamos a llenar horas.
            // Si faltan, el backend caerá a horario por defecto (11:00-13:00) y marcará HR TBD en título.
            // Solo exigimos horas cuando el usuario modela segmentos/bloques (validación por grupo).
		        saveCurrentDay();
		      }

		      const model = isSimple ? {} : _groupsToPayload();
		      let segsOut = (!isSimple && model.segments) ? model.segments : null;
		      let blksOut = (!isSimple && model.blocks) ? model.blocks : null;

      // Datos opcionales: nunca bloquean el agendamiento.
      // La comuna sí es obligatoria y se valida por separado.
      const telInputTbd = qs("#ag_tel");
      const dirInputTbd = qs("#ag_dir");
      if (telInputTbd && !String(telInputTbd.value || "").trim()) telInputTbd.value = "TBD";
      if (dirInputTbd && !String(dirInputTbd.value || "").trim()) dirInputTbd.value = "DIR TBD";

      const applyTbd = (row) => {
        const out = { ...(row || {}) };
        if (!String(out.direccion || "").trim()) out.direccion = "DIR TBD";
        if (!String(out.start_time || "").trim() || !String(out.end_time || "").trim()) {
          out.start_time = "";
          out.end_time = "";
          out.hr_tbd = true;
        }
        return out;
      };
      if (blksOut) blksOut = blksOut.map(applyTbd);
      if (segsOut) segsOut = segsOut.map(applyTbd);

          // Defaults: si el usuario llenó Location/Dirección global, pero el grupo/bloque quedó vacío
          // (por ejemplo en evento simple donde el editor está oculto), completamos antes de validar.
          const comunaDef = String(qs("#ag_loc")?.value || "").trim() || String(lead?.comuna_nombre || lead?.comuna || "").trim();
          const dirDef = String(qs("#ag_dir")?.value || "").trim() || String(lead?.direccion || "").trim();
          try{
            if (blksOut){
              blksOut = blksOut.map(b=>{
                const bb = { ...(b||{}) };
                if (!String(bb.comuna||"").trim() && comunaDef) bb.comuna = comunaDef;
                if (!String(bb.direccion||"").trim() && dirDef) bb.direccion = dirDef;
                return bb;
              });
            }
            if (segsOut){
              segsOut = segsOut.map(s=>{
                const ss = { ...(s||{}) };
                if (!String(ss.comuna||"").trim() && comunaDef) ss.comuna = comunaDef;
                if (!String(ss.direccion||"").trim() && dirDef) ss.direccion = dirDef;
                return ss;
              });
            }
          }catch(_){}

		      if (blksOut){
		        for (let i=0;i<blksOut.length;i++){
		          const b = blksOut[i] || {};
		          if (!String(b.day||"").trim()) return Swal.showValidationMessage(`Falta día en Bloque ${i+1}.`);
		          if (!String(b.comuna||"").trim()) return Swal.showValidationMessage(`Falta comuna en Bloque ${i+1}.`);

		          if (!String(b.products_text||"").trim()) return Swal.showValidationMessage(`Faltan productos en Bloque ${i+1}.`);
		        }
		      }
		      if (segsOut){
		        for (let i=0;i<segsOut.length;i++){
		          const s = segsOut[i] || {};
		          if (!String(s.day||"").trim()) return Swal.showValidationMessage(`Falta día en Grupo ${i+1}.`);
		          if (!String(s.comuna||"").trim()) return Swal.showValidationMessage(`Falta comuna en Grupo ${i+1}.`);

		          if (!String(s.products_text||"").trim()) return Swal.showValidationMessage(`Faltan productos en Grupo ${i+1}.`);
		        }
		      }

		      const overrideByDay = [];
		      for (const e of (previewEvents || [])){
	        const day = String(e.day || "").slice(0,10);
	        if (!day) continue;
        const ed = dayEdits[day];
        const td = touchedDay[day];
        if (!ed && !td) continue;
        const row = { day };
        const opsV = (ed?.ops ?? "").toString().trim();
        const mtV = (ed?.montaje ?? "").toString().trim();
	        if ((td?.ops || false) && opsV !== "") row.ops = Number(opsV);
	        if ((td?.montaje || false) && mtV) row.montaje_text = mtV;
	        if (row.ops != null || row.montaje_text) overrideByDay.push(row);
	      }
		      // Validación: SIEMPRE debe haber operadores (>=1) por día.
		      // En manual multi-día esto es crítico para operaciones.
		      if (!multiLoc){
		        const opsByDay = new Map();
		        for (const r of overrideByDay){
		          const d = String(r?.day || "").slice(0,10);
		          if (d && r?.ops != null && Number.isFinite(Number(r.ops))) opsByDay.set(d, Number(r.ops));
		        }
		        for (let i=0;i<(previewEvents||[]).length;i++){
		          const e = previewEvents[i] || {};
		          const d = String(e.day || "").slice(0,10);
		          const baseOps = Number(e.ops ?? 0);
		          const finalOps = opsByDay.has(d) ? Number(opsByDay.get(d) || 0) : baseOps;
		          if (!Number.isFinite(finalOps) || finalOps < 1){
		            try{
		              selectedIdx = Math.max(0, Math.min((previewEvents||[]).length-1, i));
		              renderDayTabs();
		              renderPreviewForSelectedDay();
		              const el = qs("#ag_ops_day");
		              el && el.focus && el.focus();
		            }catch(_){}
		            Swal.showValidationMessage(`Falta OPS (>=1) para ${d ? ("el día " + d) : "un día del evento"}.`);
		            return false;
		          }
		        }
		        // Validación: para agendar (confirm) necesitamos productos cuando es manual.
		        if (quoteSource === "manual"){
		          const hasPrev = Array.isArray(previewEvents) && previewEvents.length > 0;
		          const hasProducts = hasPrev && String((previewEvents[0] || {}).products_text || "").trim();
		          if (!hasProducts){
		            Swal.showValidationMessage("Faltan productos manuales. Usa “Editar productos” antes de agendar.");
		            return false;
		          }
		        }
				      }

				      const abonoVal = (()=>{
				        try{
				          const raw = String(qs("#ag_abono")?.value || "");
				          if (!raw.trim()) return 0;
				          const s = raw.replace(/[^0-9,.\-]/g,"").replace(/\./g,"").replace(/,/g,".");
				          const n = Number(s);
				          return Number.isFinite(n) ? n : 0;
				        }catch(_){ return 0; }
				      })();
				      const abMode = (qs("#ag_abono_mode")?.value || "").toString().trim();
				      const abOC = (qs("#ag_abono_oc")?.value || "").toString().trim();
				      const abFe = (qs("#ag_abono_fecha")?.value || "").toString().trim();
				      if (!(Number(abonoVal) > 0)){
				        if (!abMode){
				          Swal.showValidationMessage("Abono=0: debes indicar OC, fecha de abono o pago a crédito.");
				          return false;
				        }
if (abMode === "fecha" && !abFe){
				          Swal.showValidationMessage("Abono=0: falta fecha de abono.");
				          return false;
				        }
				      }

              // Aplica montaje global a bloques/segmentos si no viene por item.
              const montGlobal = (qs("#ag_mont_manual")?.value || "").trim();
              if (montGlobal){
                try{
                  if (blksOut){
                    blksOut = blksOut.map(b=>({ ...b, montaje_text: (String(b.montaje_text||"").trim() || montGlobal) }));
                  }
                  if (segsOut){
                    segsOut = segsOut.map(s=>({ ...s, montaje_text: (String(s.montaje_text||"").trim() || montGlobal) }));
                  }
                }catch(_){}
              }

              // Montaje previo: validación mínima si está activado
              if (qs("#ag_flag_montaje_event")?.checked){
                const md = String(qs("#ag_mont_day")?.value || "").slice(0,10);
                const mhi = String(qs("#ag_mont_hini")?.value || "").trim();
                const mhf = String(qs("#ag_mont_hfin")?.value || "").trim();
                const ml = String(qs("#ag_mont_loc")?.value || "").trim();
                const mdir = String(qs("#ag_mont_dir")?.value || "").trim();
                if (!md || !mhi || !mhf || !ml || !mdir){
                  Swal.showValidationMessage("Montaje previo: faltan datos (día/horas/comuna/dirección).");
                  return false;
                }
              }

					    return {
					        quote_source: quoteSource,
					        id_cotizacion: idCot ? Number(idCot) : null,
					        hr_tbd: (segsOut || blksOut) ? false : hrTbd,
			        start_time: segsOut
			          ? String((segsOut[0]||{}).start_time || "").trim()
			          : (blksOut ? String((blksOut[0]||{}).start_time || "").trim() : hIni),
			        end_time: segsOut
			          ? String((segsOut[0]||{}).end_time || "").trim()
			          : (blksOut ? String((blksOut[0]||{}).end_time || "").trim() : hFin),
				        abono: abonoVal,
			        abono_mode: abMode,
			        abono_oc: abOC,
			        abono_fecha: abFe,
			        doc_mode: (qs("#ag_doc_mode")?.value || "auto").toString().trim() || "auto",
			        telefono: (qs("#ag_tel")?.value || "").trim(),
			        direccion: (qs("#ag_dir")?.value || "").trim(),
			        agenda_notes: (qs("#ag_notes")?.value || "").trim(),
              override_montaje_text: (qs("#ag_mont_manual")?.value || "").trim(),
			        override_title: (qs("#ag_title")?.value || "").trim(),
			        override_location: (qs("#ag_loc")?.value || "").trim(),
			        override_description: (qs("#ag_desc")?.value || "").trim(),
              ...( (qs("#ag_flag_montaje_event")?.checked)
                ? {
                    montaje_event: {
                      day: String(qs("#ag_mont_day")?.value || "").slice(0,10),
                      start_time: String(qs("#ag_mont_hini")?.value || "").trim(),
                      end_time: String(qs("#ag_mont_hfin")?.value || "").trim(),
                      comuna: String(qs("#ag_mont_loc")?.value || "").trim(),
                      direccion: String(qs("#ag_mont_dir")?.value || "").trim(),
                    }
                  }
                : {}),
				        ...(blksOut
                  ? { blocks: blksOut }
                  : (segsOut
                      ? { segments: segsOut }
                      : {
                          override_by_day: overrideByDay,
                          force_single_day: (multiDay ? 0 : forceSingleDay),
                          multi_day_mode: (multiDay ? 1 : 0),
                          days_n: (multiDay ? daysN : 1),
                        })),
				      };
					    }
			  });

	  if (!res.isConfirmed) return false;
	  const v = res.value || {};

  if (v.quote_source === "manual"){
    const okMeta = await ensureQuoteMeta();
    if (!okMeta) return false;
    const okItems = await ensureManualMiceItems();
    if (!okItems) return false;
  }

	  {
	    const ok = await Swal.fire({
      icon: "question",
      title: "¿Confirmar evento?",
      text: "Se confirmará el lead y se intentará crear/actualizar el/los evento(s) en Google Calendar.",
      showCancelButton: true,
      confirmButtonText: "Sí, confirmar",
      cancelButtonText: "Cancelar",
    });
    if (!ok.isConfirmed) return false;
	  }

    const approveAgendaWithRetry = async ()=>{
      let lastErr = null;
      for (let i=0;i<3;i++){
        try{
          return await apiJSON(`/tools/agenda/${lead.id_lead}/approve`, { method:"PUT" });
        }catch(err){
          lastErr = err;
          const msg = String(err?.message || err || "");
          const retryable = /Agenda ocupada|Reintenta|429/i.test(msg);
          if (!retryable) throw err;
          await new Promise(r=>setTimeout(r, 1200 + i*600));
        }
      }
      throw lastErr || new Error("No se pudo agendar");
    };

	  // Validación final abono: si abono = 0, exige OC o fecha de abono.
	  try{
	    const ab = Number(v.abono || 0);
	    if (!(ab > 0)){
	      const mode = String(v.abono_mode || "").trim();
	      const oc = String(v.abono_oc || "").trim();
	      const fe = String(v.abono_fecha || "").trim();
	      if (!mode) throw new Error("Debes indicar OC, fecha de abono o pago a crédito (abono=0).");
		      if (mode === "fecha" && !fe) throw new Error("Falta fecha de abono (abono=0).");
	    }
	  }catch(err){
	    await Swal.fire({ icon:"warning", title:"Abono", text: String(err?.message || err) });
	    return false;
	  }

					  const payload = {
					    id_estado: Number(newEstado),
              movement_comment: statusComment,
					    agendar: true,
				    quote_source: v.quote_source,
			    ...(v.id_cotizacion ? { id_cotizacion: v.id_cotizacion } : {}),
			    telefono: v.telefono,
			    direccion: v.direccion,
				    ...(v.abono != null ? { abono: v.abono } : {}),
				    ...(v.abono_mode ? { abono_mode: v.abono_mode } : {}),
				    ...(v.abono_oc ? { abono_oc: v.abono_oc } : {}),
				    ...(v.abono_fecha ? { abono_fecha: v.abono_fecha } : {}),
				    ...(v.doc_mode ? { doc_mode: v.doc_mode } : {}),
				    ...(v.hr_tbd ? { hr_tbd: true } : { start_time: v.start_time, end_time: v.end_time, hr_tbd: false }),
				    created_by: (localStorage.getItem("nombre") || sessionStorage.getItem("nombre") || "").trim(),
			    ...(v.agenda_notes ? { agenda_notes: v.agenda_notes } : {}),
          ...(v.override_montaje_text ? { override_montaje_text: v.override_montaje_text } : {}),
			    ...(v.override_title ? { override_title: v.override_title } : {}),
			    ...(v.override_location ? { override_location: v.override_location } : {}),
		    ...(v.override_description ? { override_description: v.override_description } : {}),
		    ...(Array.isArray(v.override_by_day) && v.override_by_day.length ? { override_by_day: v.override_by_day } : {}),
		    ...(Array.isArray(v.segments) && v.segments.length ? { segments: v.segments } : {}),
		    ...(Array.isArray(v.blocks) && v.blocks.length ? { blocks: v.blocks } : {}),
		    ...(v.force_single_day ? { force_single_day: 1 } : {}),
		    ...(v.multi_day_mode ? { multi_day_mode: 1 } : {}),
		    ...(v.days_n ? { days_n: v.days_n } : {}),
		  };

  const idempotencyKey = `agenda-${lead.id_lead}-${Date.now()}-${Math.random().toString(36).slice(2,10)}`;
  await Swal.fire({
    title:"Agendando…",
    text:"No cierre esta ventana. Estamos confirmando el lead y creando el calendario.",
    allowOutsideClick:false,
    allowEscapeKey:false,
    showConfirmButton:false,
    didOpen:()=>Swal.showLoading(),
    timer:350,
  });

  let out = null;
  try{
    out = await apiJSON(`/leads/${lead.id_lead}/confirmar_agendamiento`, {
      method:"POST",
      headers:{
        "Content-Type":"application/json",
        "X-Idempotency-Key":idempotencyKey,
      },
      body:JSON.stringify(payload),
    });
  }catch(err){
    await Swal.fire({
      icon:"error",
      title:"No se pudo confirmar y agendar",
      text:String(err?.message || err),
    });
    return false;
  }
  const ev = out?.evento || {};
  const gcal = out;
  const gcalLink = String(gcal?.calendar_html_link || "");
  const gcalEid = String(gcal?.calendar_event_id || "");
  const gcalErr = String(gcal?.gcal_error || "");
  const gcalCalId = (Array.isArray(gcal?.calendar_ids) && gcal.calendar_ids.length) ? String(gcal.calendar_ids[0] || "") : "";
  const gcalLead = (gcal && typeof gcal === "object" && gcal.lead && typeof gcal.lead === "object") ? gcal.lead : {};

  const hasAnyId = !!gcalEid || (Array.isArray(gcal?.calendar_ids) && gcal.calendar_ids.some(x=>String(x||"").trim()));
  if (!hasAnyId){
    await Swal.fire({
      icon:"error",
      title:"No se pudo agendar",
      text:"No se obtuvo calendar_event_id. Se notificó a Super Admin para revisión. Intenta nuevamente.",
    });
    return false;
  }

  try{ playCashRegisterSound(); }catch(_){ }

  const fmtDT = (s)=>{
    if (!s) return "";
    try{ return new Date(s).toLocaleString("es-CL",{weekday:"long", day:"2-digit", month:"long", hour:"2-digit", minute:"2-digit"}); }
    catch(_){ return String(s); }
  };

  // WhatsApp (cliente + ventas) al calendarizar
  const evs = (Array.isArray(out?.eventos) && out.eventos.length)
    ? out.eventos
    : ((Array.isArray(previewEvents) && previewEvents.length) ? previewEvents : (ev ? [ev] : []));

  const moneyCLP = (n)=>{
    const x = Number(n || 0);
    if (!Number.isFinite(x)) return "—";
    return "$" + new Intl.NumberFormat("es-CL",{maximumFractionDigits:0}).format(x);
  };
  const waDigits = (s)=> String(s || "").replace(/\\D/g,"");
  const waE164 = (tel)=>{
    let d = waDigits(tel);
    if (!d) return "";
    // Chile: si el usuario puso solo 9 dígitos, agregamos +56 para el enlace.
    if (d.length === 9) d = "56" + d;
    return d;
  };
  const phoneTextCL = (tel)=>{
    const d = waDigits(tel);
    if (!d) return "";
    // Mostrar 9 dígitos (sin +56) para que sea legible en mensaje.
    if (d.length === 11 && d.startsWith("56")) return d.slice(2);
    return d;
  };
  const fmtDateLong = (d)=>{
    if (!d) return "";
    try{
      const dd = new Date(String(d).slice(0,10) + "T00:00:00");
      let s = dd.toLocaleDateString("es-CL",{weekday:"long", day:"2-digit", month:"long"});
      // Normaliza: "sábado 18 de abril" -> "sábado, 18 de abril"
      if (s && !s.includes(",")){
        const i = s.indexOf(" ");
        if (i > 0) s = s.slice(0,i) + ", " + s.slice(i+1);
      }
      return s;
    }catch(_){ return String(d).slice(0,10); }
  };
  const fmtTime24 = (dt)=>{
    try{
      const d = new Date(dt);
      if (isNaN(d.getTime())) return "";
      const h = d.getHours();
      const m = d.getMinutes();
      const hh = String(h).padStart(2,"0");
      const mm = String(m).padStart(2,"0");
      return `${hh}:${mm}`;
    }catch(_){ return ""; }
  };
  const bulletsFrom = (txt)=>{
    const raw = String(txt || "");
    const lines = raw.split("\\n").map(l=>l.trim()).filter(Boolean);
    const out = [];
    for (const ln of lines){
      if (!ln) continue;
      const up = ln.toUpperCase();
      if (up === "PRODUCTOS" || up === "PRODUCTOS:" || up === "MONTAJE" || up === "MONTAJE:" || up === "MONTAJE SUGERIDO") continue;
      if (ln.startsWith("•")) out.push(ln);
      else if (ln.startsWith("-")) out.push("• " + ln.replace(/^-\s*/, ""));
      else out.push("• " + ln);
    }
    return out.length ? out : ["• —"];
  };

  // quote meta
  let cotN = (gcalLead?.num_cotizacion || lead?.num_cotizacion || "").toString().trim();
  let neto = (gcalLead?.monto_cotizado != null) ? Number(gcalLead.monto_cotizado) : Number(lead?.monto_cotizado || 0);
  let ivaVal = null;
  let total = neto;
  let abono = null;
  if (v?.id_cotizacion){
    try{
      const q = await apiJSON(`/quotes/${Number(v.id_cotizacion)}`);
      const c = q?.cotizacion || {};
      if (c?.numero != null) cotN = String(c.numero);
      const sub = (c?.subtotal_productos != null) ? Number(c.subtotal_productos) : ((c?.subtotal != null) ? Number(c.subtotal) : null);
      if (sub != null && Number.isFinite(sub) && sub > 0) neto = sub;
      if (c?.iva != null && Number.isFinite(Number(c.iva))) ivaVal = Number(c.iva);
      if (c?.total != null && Number.isFinite(Number(c.total))) total = Number(c.total);
      if (c?.abono != null) abono = Number(c.abono);
    }catch(_){}
  }
  // Override: si el usuario ingresó abono en el modal de agenda, respétalo.
  try{
    if (v?.abono != null && Number.isFinite(Number(v.abono)) && Number(v.abono) > 0){
      abono = Number(v.abono);
    }
  }catch(_){}

  const clienteNom = (lead?.nombre_cliente || lead?.cliente || "").toString().trim();
  const marcaNom = (lead?.marca_nombre || lead?.marca || "").toString().trim();
  const comunaNom = (lead?.comuna_nombre || lead?.comuna || "").toString().trim();
  const telCliente = (v?.telefono || gcalLead?.telefono || lead?.telefono || "").toString().trim();
  const telVentas = (gcalLead?.ventas_telefono || "").toString().trim();
  const dirTxt = (v?.direccion || gcalLead?.direccion || lead?.direccion || "").toString().trim();
  const dirLine = (()=>{
    const d = String(dirTxt || "").trim();
    const c = String(comunaNom || "").trim();
    if (!d) return "";
    if (!c) return d;
    if (d.toUpperCase().includes(c.toUpperCase())) return d;
    return d + " " + c;
  })();
  const tipoName = (()=>{
    try{
      const hit = (CATS?.tipos || []).find(t => Number(t.id_tipo_cliente) === Number(lead?.id_tipo_cliente));
      return String(hit?.nombre || hit?.tipo || "").trim();
    }catch(_){ return ""; }
  })();
  let isEmpresa = /EMPRESA|FACTURA/i.test(tipoName);
  try{
    const dm = String(v?.doc_mode || "").trim().toLowerCase();
    if (dm === "con") isEmpresa = true;
    if (dm === "sin") isEmpresa = false;
  }catch(_){}
  if (!v?.id_cotizacion){
    if (isEmpresa){
      ivaVal = Math.round(Number.isFinite(neto) ? (neto * 0.19) : 0);
      total = (Number.isFinite(neto) ? neto : 0) + (Number.isFinite(ivaVal) ? ivaVal : 0);
    }else{
      ivaVal = 0;
      total = Number.isFinite(neto) ? neto : 0;
    }
  }else{
    if (ivaVal == null && isEmpresa){
      const diff = (Number.isFinite(total) ? total : 0) - (Number.isFinite(neto) ? neto : 0);
      ivaVal = Math.max(0, Math.round(diff));
    }
  }

  const days = evs.map(e => String(e?.day || e?.start_at || "").slice(0,10)).filter(Boolean);
  const uniqueDays = Array.from(new Set(days));
  uniqueDays.sort();
  const dateLine = uniqueDays.length > 1
    ? `del ${fmtDateLong(uniqueDays[0])} al ${fmtDateLong(uniqueDays[uniqueDays.length-1])}`
    : (uniqueDays[0] ? fmtDateLong(uniqueDays[0]) : "");

  const hrLine = v?.hr_tbd ? "POR CONFIRMAR" : `${fmtTime24(evs[0]?.start_at)} a ${fmtTime24(evs[0]?.end_at)}`;

  const EMO = {
    // Importante: usamos escapes por codepoint para evitar problemas de encoding en producción
    // (a veces los emojis literales terminan como "�" / U+FFFD).
    cal: "\u{1F4C5}",   // 📅
    cart: "\u{1F6D2}",  // 🛒
    tools: "\u{1F9F0}", // 🧰
    ops: "\u{1F465}",   // 👥
    clock: "\u{1F552}", // 🕒
    phone: "\u{1F4DE}", // 📞
    pin: "\u{1F4CD}",   // 📍
    doc: "\u{1F4C4}",   // 📄
  };

  let productosBlock = "";
  let montajeBlock = "";
  if (uniqueDays.length > 1){
    productosBlock = `${EMO.cart} PRODUCTOS (por día):\n` + uniqueDays.map((d, idx)=>{
      const e = evs.find(x => String(x?.day || x?.start_at || "").slice(0,10) === d) || {};
      const bl = bulletsFrom(e.products_text);
      return `Día ${idx+1} · ${d}:\n${bl.join("\n")}`;
    }).join("\n\n");
    montajeBlock = `${EMO.tools} MONTAJE (por día):\n` + uniqueDays.map((d, idx)=>{
      const e = evs.find(x => String(x?.day || x?.start_at || "").slice(0,10) === d) || {};
      const bl = bulletsFrom(e.montaje_text);
      const ops = (e.ops != null) ? String(e.ops) : "—";
      return `Día ${idx+1} · ${d}:\n${bl.join("\n")}\n${EMO.ops} OPS: ${ops}`;
    }).join("\n\n");
  } else {
    productosBlock = `${EMO.cart} PRODUCTOS:\n` + bulletsFrom(evs[0]?.products_text).join("\n");
    montajeBlock = `${EMO.tools} MONTAJE:\n` + bulletsFrom(evs[0]?.montaje_text).join("\n") + `\n${EMO.ops} OPS: ${String(evs[0]?.ops ?? "—")}`;
  }

  let wspText =
`${EMO.cal} FECHA EVENTO: ${dateLine || "POR CONFIRMAR"}
NOMBRE CLIENTE: ${[clienteNom, marcaNom].filter(Boolean).join(" - ") || "—"}
COMUNA: ${(comunaNom || "—").toUpperCase()}
Valor TOTAL: ${moneyCLP(total)}
Abono: ${abono != null && Number.isFinite(Number(abono)) ? moneyCLP(abono) : "—"}
COT Nº: ${cotN || "—"}
${EMO.doc} Documento: ${isEmpresa ? `Con Documento (IVA: ${moneyCLP(ivaVal || 0)})` : "Sin Documento"}
${EMO.clock} HORARIO: ${hrLine}

${productosBlock}

${montajeBlock}

${EMO.phone} TELEFONO: ${phoneTextCL(telCliente) || "POR CONFIRMAR"}
${EMO.pin} DIRECCION: ${dirLine || "POR CONFIRMAR"}

¿Me confirmas por favor que estos datos están correctos?`;

  // Fallback ultra-seguro si por algún motivo el runtime terminó con U+FFFD.
  if (wspText.includes("\uFFFD")){
    const ALT = {
      cal: "[FECHA EVENTO]",
      cart: "[PRODUCTOS]",
      tools: "[MONTAJE]",
      ops: "[OPS]",
      clock: "[HORARIO]",
      phone: "[TELEFONO]",
      pin: "[DIRECCION]",
      doc: "[DOCUMENTO]",
    };
    wspText = wspText
      .replaceAll(EMO.cal, ALT.cal)
      .replaceAll(EMO.cart, ALT.cart)
      .replaceAll(EMO.tools, ALT.tools)
      .replaceAll(EMO.ops, ALT.ops)
      .replaceAll(EMO.clock, ALT.clock)
      .replaceAll(EMO.phone, ALT.phone)
      .replaceAll(EMO.pin, ALT.pin)
      .replaceAll(EMO.doc, ALT.doc);
  }

  const urlClient = telCliente ? `https://wa.me/${waE164(telCliente)}?text=${encodeURIComponent(wspText)}` : "";
  const urlVentas = telVentas ? `https://wa.me/${waE164(telVentas)}?text=${encodeURIComponent(wspText)}` : "";

  await Swal.fire({
    icon: (gcalLink && gcalEid) ? "success" : "warning",
    title: (gcalLink && gcalEid) ? "Evento calendarizado" : "Confirmado (sin Calendar)",
    html: `
      <div style="text-align:left;display:grid;gap:10px">
        <div style="font-weight:1000;font-size:14px">${escapeHtml(ev.title||"")}</div>
        <div style="opacity:.7">${escapeHtml(fmtDT(ev.start_at))} → ${escapeHtml(fmtDT(ev.end_at))}</div>
        ${gcalCalId ? `<div class="muted" style="opacity:.7">CalendarId: <b>${escapeHtml(gcalCalId)}</b></div>` : ``}
        ${gcalLink ? `<div><a href="${escapeHtml(gcalLink)}" target="_blank" rel="noopener" style="color:#60a5fa;font-weight:1000">Abrir en Google Calendar</a></div>` : ``}
        ${(!gcalLink || !gcalEid) ? `<div style="padding:10px 12px;border:1px solid rgba(239,68,68,.35);background:rgba(239,68,68,.12);border-radius:12px">
          <div style="font-weight:1000">No se creó el evento en Google Calendar.</div>
          <div class="muted" style="margin-top:4px">${escapeHtml(gcalErr || "Revisar conexión/credenciales.")}</div>
        </div>` : ``}

        <div style="border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.10);display:grid;gap:8px">
          <div class="muted" style="font-weight:1000">WhatsApp (mensaje listo)</div>
          <textarea id="sw_ag_wsp_msg" class="swTa" rows="10" style="min-height:180px">${escapeHtml(wspText)}</textarea>
          <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end">
            <button type="button" class="swBtn secondary" id="sw_ag_copy">Copiar</button>
            <button type="button" class="swBtn secondary" id="sw_ag_ventas" ${urlVentas ? "" : "disabled"}>Enviar a Ventas</button>
            <button type="button" class="swBtn" id="sw_ag_cliente" ${urlClient ? "" : "disabled"}>Enviar a Cliente</button>
          </div>
          <div class="muted agSmall">Tip: si falta teléfono/dirección, completa el lead antes de enviar.</div>
        </div>
      </div>
    `,
    showConfirmButton:false,
    showCloseButton:true,
    didOpen: ()=>{
      const ta = qs("#sw_ag_wsp_msg");
      const getTxt = ()=> (ta?.value || wspText || "").trim();
      qs("#sw_ag_copy")?.addEventListener("click", async ()=>{
        try{
          await navigator.clipboard.writeText(getTxt());
          toast("Mensaje copiado", "success");
        }catch(_){
          try{ ta && ta.select && ta.select(); }catch(_2){}
          toast("Copia manual (Ctrl/Cmd+C)", "warning");
        }
      });
      qs("#sw_ag_cliente")?.addEventListener("click", ()=>{
        const t = getTxt();
        const u = telCliente ? `https://wa.me/${waE164(telCliente)}?text=${encodeURIComponent(t)}` : "";
        if (!u) return toast("Lead sin teléfono", "warning");
        window.open(u, "_blank", "noopener,noreferrer");
      });
      qs("#sw_ag_ventas")?.addEventListener("click", ()=>{
        const t = getTxt();
        const u = telVentas ? `https://wa.me/${waE164(telVentas)}?text=${encodeURIComponent(t)}` : "";
        if (!u) return toast("Falta teléfono de Ventas (usuario asignado)", "warning");
        window.open(u, "_blank", "noopener,noreferrer");
      });
    }
  });

  return true;
}

async function onDrop(e, newEstado){
  e.preventDefault();
  const id = Number((e.dataTransfer && e.dataTransfer.getData("text/plain")) || DRAG_ID || 0);
  if (!id) return;

  const lead = LEADS.find(x => Number(x.id_lead) === id);
  if (!lead){ onDragEnd(); return; }

  const prev = lead.id_estado;
  if (Number(prev) === Number(newEstado)){ onDragEnd(); return; }

  const prevName = estadoNombre(prev);
  const nextName = estadoNombre(newEstado);

  try{
    if (isConfirmEstadoName(nextName)){
      const ok = await handleConfirmado(lead, newEstado);
      if (!ok){ onDragEnd(); render(); return; }
    } else if (nextName.includes("DECLINADO")){
      const ok = await handleDeclinado(lead, newEstado);
      if (!ok){ onDragEnd(); render(); return; }
    } else {
      if (isConfirmEstadoName(prevName) && !isConfirmEstadoName(nextName)){
        const res = await Swal.fire({
          icon:"warning",
          title:"¿Salir de Confirmado?",
          text:"Esto eliminará la pre-agenda y sus datos.",
          showCancelButton:true,
          confirmButtonText:"Sí, mover",
          cancelButtonText:"Cancelar"
        });
        if (!res.isConfirmed){ onDragEnd(); render(); return; }
        await setLeadEstado(id, newEstado, { undo_preagenda: true });
      } else {
        await setLeadEstado(id, newEstado);
      }
    }

    lead.id_estado = Number(newEstado);
    toast("Estado actualizado", "success");
  }catch(err){
    toast("Error moviendo lead: " + String(err.message||err), "error");
  }finally{
    onDragEnd();
    render();
  }
}

/* ========= Create / Edit (payload correcto: cliente) ========= */
async function openCreateModal(){
  const marcas = CATS.marcas || [];
  const comunas = CATS.comunas || [];
  const tipos  = CATS.tipos  || [];
  const estados = CATS.estados || [];
  const plataformas = CATS.plataformas?.length ? CATS.plataformas : ["FORMULARIO","WHATSAPP","EMAIL","INSTAGRAM","LLAMADO","OTRO"].map((nombre,i)=>({nombre, orden:i+1}));

  const defaultEstado = estados[0]?.id_estado ?? null;

  if (!marcas.length || !comunas.length){
    toast("Catálogos incompletos (marcas/comunas)", "error");
    return;
  }

  const html =
    '<div class="swForm"><div class="grid2">' +
    '<label>Nombre cliente<input id="c_cliente" class="swInp" placeholder="Ej: Juan Pérez" /></label>' +
    '<label>Email<input id="c_email" class="swInp" placeholder="correo@dominio.cl" /></label>' +
    '<label>Marca<select id="c_marca" class="swSel">' +
      marcas.map(m=>`<option value="${m.id_marca}">${escapeHtml(m.nombre || m.marca || m.id_marca)}</option>`).join("") +
    '</select></label>' +
    '<label>Comuna<select id="c_comuna" class="swSel">' +
      comunas.map(c=>`<option value="${c.id_comuna}">${escapeHtml(c.nombre || c.comuna || c.id_comuna)}</option>`).join("") +
    '</select></label>' +
    '<label>Tipo cliente<select id="c_tipo" class="swSel">' +
      '<option value="">- Seleccionar -</option>' +
      tipos.map(t=>`<option value="${t.id_tipo_cliente}">${escapeHtml(t.nombre || t.tipo || t.id_tipo_cliente)}</option>`).join("") +
    '</select></label>' +
    '<label>Plataforma<select id="c_plataforma" class="swSel">' +
      plataformas.map(p=>`<option value="${escapeHtml(p.nombre)}">${escapeHtml(p.nombre)}</option>`).join("") +
    '</select></label>' +
    '<label>Teléfono<input id="c_tel" class="swInp" placeholder="+569..." /></label>' +
    '<label>Fecha evento<input id="c_fecha" class="swInp" type="date" /></label>' +
    '<label class="span2">Dirección<input id="c_dir" class="swInp" placeholder="Calle #, Depto, referencia" /></label>' +
    '<label class="span2">Notas<textarea id="c_notas" class="swTa" placeholder="Contexto, requerimientos, etc."></textarea></label>' +
    '</div></div>';

  const res = await Swal.fire({
    title: "Crear lead",
    html,
    width: 860,
    focusConfirm: false,
    showCancelButton: true,
    confirmButtonText: "Crear",
    cancelButtonText: "Cancelar",
    preConfirm: ()=>{
      const cliente = (qs("#c_cliente").value || "").trim();
      if (!cliente){
        Swal.showValidationMessage("Nombre cliente es obligatorio.");
        return false;
      }
      if (!Number(qs("#c_marca").value || 0)){
        Swal.showValidationMessage("Marca es obligatoria.");
        return false;
      }
      if (!(qs("#c_fecha").value || "").trim()){
        Swal.showValidationMessage("Fecha evento es obligatoria.");
        return false;
      }
      const payload = {
        cliente,
        email: (qs("#c_email").value || "").trim() || null,
        telefono: (qs("#c_tel").value || "").trim() || null,
        id_marca: Number(qs("#c_marca").value),
        id_comuna: Number(qs("#c_comuna").value),
        id_tipo_cliente: qs("#c_tipo").value ? Number(qs("#c_tipo").value) : null,
        plataforma: (qs("#c_plataforma").value || "").trim() || null,
        fecha_evento: (qs("#c_fecha").value || null),
        direccion: (qs("#c_dir").value || "").trim() || null,
        notas: (qs("#c_notas").value || "").trim() || null
      };
      if (defaultEstado != null) payload.id_estado = Number(defaultEstado);
      return payload;
    }
  });

  if (!res.isConfirmed) return;

  try{
    await apiJSON("/leads", {
      method:"POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify(res.value)
    });
    toast("Lead creado", "success");
    await loadLeads();
    render();
    setStatus("Leads: " + LEADS.length);
  }catch(err){
    toast("Error creando lead: " + String(err.message||err), "error");
  }
}

async function openEditModal(lead){
  try{ EDITING_LEAD_ID = Number(lead?.id_lead) || null; }catch(_){ EDITING_LEAD_ID = null; }
  const marcas = CATS.marcas || [];
  const comunas = CATS.comunas || [];
  const tipos  = CATS.tipos  || [];
  const estados = CATS.estados || [];
  const platformsBase = (CATS.plataformas?.length ? CATS.plataformas.map(p=>p.nombre) : ["FORMULARIO","WHATSAPP","EMAIL","INSTAGRAM","LLAMADO","OTRO"]);
  const curPlat = String(lead.plataforma || "").trim();
  const platforms = Array.from(new Set([curPlat, ...platformsBase].filter(Boolean)));
  let pdfFile = null;
  let isAdmin = false;

  try{
    const GD = window.parent && window.parent.GD;
    const me = GD?.me;
    const role = (me?.role || me?.rol || "").toString().toUpperCase();
    // Importante: SOLO Admin/SuperAdmin puede borrar leads (para no ensuciar métricas).
    isAdmin = ["ADMIN","SUPERADMIN"].includes(role);
  }catch(_){}

  const html =
    '<div class="swForm"><div class="grid2">' +
    `<label>Nombre cliente<input id="e_cliente" class="swInp" value="${escapeHtml(lead.cliente || "")}" /></label>` +
    `<label>Email
      <div class="gdInline">
        <input id="e_email" class="swInp" value="${escapeHtml(lead.email || "")}" />
        <button type="button" class="gdIcoBtn" id="qa_email" title="Enviar email">✉️</button>
      </div>
    </label>` +
    '<label>Marca<select id="e_marca" class="swSel">' +
      marcas.map(m=>`<option value="${m.id_marca}" ${Number(m.id_marca)===Number(lead.id_marca)?"selected":""}>${escapeHtml(m.nombre)}</option>`).join("") +
    '</select></label>' +
    '<label>Comuna<select id="e_comuna" class="swSel">' +
      comunas.map(c=>`<option value="${c.id_comuna}" ${Number(c.id_comuna)===Number(lead.id_comuna)?"selected":""}>${escapeHtml(c.nombre)}</option>`).join("") +
    '</select></label>' +
    '<label>Tipo cliente<select id="e_tipo" class="swSel">' +
      '<option value="">- Seleccionar -</option>' +
      tipos.map(t=>`<option value="${t.id_tipo_cliente}" ${Number(t.id_tipo_cliente)===Number(lead.id_tipo_cliente)?"selected":""}>${escapeHtml(t.nombre)}</option>`).join("") +
    '</select></label>' +
    '<label>Plataforma<select id="e_plataforma" class="swSel">' +
      '<option value="">- Seleccionar -</option>' +
      platforms.map(p=>`<option value="${escapeHtml(p)}" ${String(p)===String(curPlat)?"selected":""}>${escapeHtml(p)}</option>`).join("") +
    '</select></label>' +
    '<label>Estado<select id="e_estado" class="swSel">' +
      estados.map(s=>`<option value="${s.id_estado}" ${Number(s.id_estado)===Number(lead.id_estado)?"selected":""}>${escapeHtml(s.nombre)}</option>`).join("") +
    '</select></label>' +
    `<label>Teléfono
      <div class="gdInline">
        <input id="e_tel" class="swInp" value="${escapeHtml(lead.telefono || "")}" />
        <button type="button" class="gdIcoBtn" id="qa_call" title="Llamar">📞</button>
        <button type="button" class="gdIcoBtn" id="qa_wa" title="WhatsApp">🟢</button>
        <button type="button" class="gdIcoBtn" id="qa_vcard" title="vCard">👤</button>
      </div>
    </label>` +
    `<label>Fecha evento<input id="e_fecha" class="swInp" type="date" value="${escapeHtml(String(lead.fecha_evento||"").slice(0,10))}" /></label>` +
    `<label>N° Cotización
      <div class="gdInline">
        <input id="e_numcot" class="swInp" value="${escapeHtml(String(lead.num_cotizacion ?? ""))}" />
        <button type="button" class="gdIcoBtn" id="qa_quote" title="Abrir cotización">🧾</button>
      </div>
    </label>` +
    `<label>Monto cotizado<input id="e_monto" class="swInp" type="number" step="0.01" value="${escapeHtml(String(lead.monto_cotizado ?? 0))}" /></label>` +
    `<label class="span2">Dirección<input id="e_dir" class="swInp" value="${escapeHtml(lead.direccion || "")}" /></label>` +
    `<label class="span2">
      <details class="gdDetails" id="manualDetails" ${(!lead.id_cotizacion_vigente || lead.cotizacion_pdf_url) ? "open" : ""}>
        <summary class="gdManualHdr">Carga manual (PDF)</summary>
        <div class="gdManualBox">
          <input id="e_pdf" class="swInp" type="file" accept="application/pdf" />
          <div style="display:flex;gap:10px;align-items:center;margin-top:6px;flex-wrap:wrap">
            <button type="button" class="swBtn secondary" id="e_viewpdf" disabled>Ver PDF</button>
            <button type="button" class="swBtn secondary" id="e_ocrpdf" disabled>Cargar productos</button>
            <div class="muted" id="e_pdfhint">${lead.cotizacion_pdf_url ? "PDF cargado. Puedes verlo y/o cargar productos manualmente." : "Sin PDF (opcional). Igual puedes cargar productos manualmente."}</div>
          </div>
        </div>
      </details>
     </label>` +
    `<label>Creado<input id="e_created" class="swInp" value="${escapeHtml(String(lead.created_at||lead.fecha_ingreso||"").replace("T"," ").slice(0,16))}" disabled /></label>` +
    `<label class="span2">Notas / Historial<textarea id="e_notas" class="swTa" spellcheck="false">${escapeHtml(lead.notas || "")}</textarea></label>` +
    `<label class="span2">Agregar comentario
      <div class="gdQuickRow" style="margin:6px 0 8px">
        <button type="button" class="gdQBtn" id="qf_wsp" title="Registrar seguimiento WhatsApp">🟢 WSP</button>
        <button type="button" class="gdQBtn" id="qf_call" title="Registrar seguimiento llamada">📞 Llamada</button>
        <button type="button" class="gdQBtn" id="qf_email" title="Registrar seguimiento correo">✉️ Email</button>
        <button type="button" class="gdQBtn secondary" id="qf_no" title="Registrar: cliente no contesta">⏳ No contesta</button>
        <button type="button" class="gdQBtn secondary" id="qf_pick" title="Seguimiento rápido (según estado)">⚡ Seguimiento</button>
      </div>
      <textarea id="e_comment" class="swTa" rows="2" placeholder="Nuevo comentario..."></textarea>
    </label>` +
    '</div></div>';

	  const isEmbed = (()=>{
	    try{ return new URLSearchParams(location.search).get("embed") === "1"; }catch(_){ return false; }
	  })();

		  const res = await Swal.fire({
		    title: "Editar lead de: " + (lead.cliente || lead.nombre_cliente || ("#" + lead.id_lead)),
		    html,
		    width: 860,
		    focusConfirm: false,
		    allowOutsideClick: false,
		    customClass: { popup: "gdEditLead" },
		    showCancelButton: true,
		    confirmButtonText: "Guardar",
		    cancelButtonText: "Cerrar",
	    showDenyButton: isAdmin,
		    denyButtonText: "Borrar lead",
	    denyButtonColor: "#ef4444",
		    willClose: ()=>{
          try{ EDITING_LEAD_ID = null; }catch(_){}
		      if (!isEmbed) return;
		      try{ window.parent?.postMessage({ type:"embed:close", id_lead: lead.id_lead }, "*"); }catch(_){}
		    },
	    didOpen: ()=>{
	      // Quick-actions: estilos mínimos (solo dentro del modal)
	      try{
	        if (!document.getElementById("gdLeadQaStyle")){
	          const st = document.createElement("style");
	          st.id = "gdLeadQaStyle";
	          st.textContent = `
	            .gdInline{ display:flex; gap:8px; align-items:center; }
	            .gdIcoBtn{
	              width:40px; height:40px; min-width:40px;
	              border-radius:12px;
	              border:1px solid var(--border);
	              background: var(--surface2);
	              color: var(--text);
	              font-weight: 1000;
	              cursor:pointer;
	            }
	            .gdIcoBtn:hover{ background: var(--hover-surface); }
	            .gdDetails{ border:0; }
	            .gdDetails > summary{ list-style:none; cursor:pointer; }
	            .gdDetails > summary::-webkit-details-marker{ display:none; }
	            .gdManualHdr{
	              font-weight:1000; margin:2px 0 8px; color: var(--muted);
	              letter-spacing:.2px; display:flex; align-items:center; gap:8px;
	            }
	            .gdManualHdr::after{ content:"▾"; opacity:.75; margin-left:auto; font-weight:1100; }
	            details[open] > .gdManualHdr::after{ content:"▴"; }
	            .gdManualBox{ border:1px solid var(--border); background: var(--surface2); border-radius:14px; padding:10px; }
	            .gdQuickRow{ display:flex; gap:8px; flex-wrap:wrap; }
	            .gdQBtn{
	              height:34px;
	              border-radius:999px;
	              border:1px solid var(--border);
	              background: var(--surface2);
	              color: var(--text);
	              font-weight: 1000;
	              padding:0 12px;
	              cursor:pointer;
	              white-space:nowrap;
	            }
	            .gdQBtn.secondary{ opacity:.92; }
	            .gdQBtn:hover{ background: var(--hover-surface); }
	          `;
	          document.head.appendChild(st);
	        }
	      }catch(_){}
	      const viewBtn = qs("#e_viewpdf");
	      const ocrBtn = qs("#e_ocrpdf");
	      const hint = qs("#e_pdfhint");
	      const fileEl = qs("#e_pdf");
	      let localPdfFile = null;
	      let isUploadingPdf = false;
	      let metaSaveT = null;
		      const logAction = async (kind, title, text, followup=false, contact_outcome="")=>{
		        await logLeadActionNote(lead, {
		          kind,
		          title,
		          text,
		          followup: !!followup,
		          contact_outcome,
		        });
		      };

	      async function quickFollow(kind, title, defaultText){
	        const res = await Swal.fire({
	          title,
	          input: "textarea",
	          inputValue: defaultText || "",
	          inputPlaceholder: "Detalle (opcional)…",
	          showCancelButton: true,
	          confirmButtonText: "Registrar",
	          cancelButtonText: "Cancelar",
	        });
	        if (!res.isConfirmed) return;
	        const text = String(res.value || defaultText || "").trim();
	        if (!text){
	          toast("Sin texto", "warning");
	          return;
	        }
		        try{
		          await logAction(kind, title, text, true);
		          toast("Seguimiento registrado", "success");
		          try{ qs("#e_comment").value = ""; }catch(_){}
		        }catch(_){
		          toast("No pude registrar seguimiento", "error");
		        }
		      }

			      qs("#qf_wsp")?.addEventListener("click", ()=>quickFollow("WSP", "Cliente contactado por WhatsApp", "Cliente contactado por WhatsApp."));
			      qs("#qf_call")?.addEventListener("click", ()=>quickFollow("CALL", "Cliente contactado por llamada", "Cliente contactado por llamada."));
			      qs("#qf_email")?.addEventListener("click", ()=>quickFollow("EMAIL", "Cliente contactado por correo", "Cliente contactado por correo."));
			      qs("#qf_no")?.addEventListener("click", async ()=>{
		        // "No contesta" queda como intento en el historial, pero no cambia
		        // el estado comercial del lead.
		        const res = await Swal.fire({
		          title: "Cliente no contesta",
		          html: `
		            <div style="text-align:left;display:grid;gap:10px">
		              <label class="muted" style="font-weight:950">Canal</label>
		              <select id="sw_no_ch" class="swSel">
		                <option value="CALL">📞 Llamada</option>
		                <option value="WSP">🟢 WhatsApp</option>
		                <option value="EMAIL">✉️ Email</option>
		              </select>
		              <label class="muted" style="font-weight:950">Detalle (opcional)</label>
		              <textarea id="sw_no_txt" class="swTa" rows="3" placeholder="Ej: 2 intentos, pedir confirmación de datos…"></textarea>
		            </div>
		          `,
		          showCancelButton: true,
		          confirmButtonText: "Registrar",
		          cancelButtonText: "Cancelar",
		          focusConfirm: false,
		          preConfirm: ()=>{
		            const ch = String(document.getElementById("sw_no_ch")?.value || "CALL").trim().toUpperCase();
		            const tx = String(document.getElementById("sw_no_txt")?.value || "").trim();
		            return { ch, tx };
		          }
		        });
		        if (!res.isConfirmed) return;
		        const ch = String(res.value?.ch || "CALL").trim().toUpperCase();
		        const tx = String(res.value?.tx || "").trim();
		        const base = "Cliente no contesta. Se solicita respuesta para avanzar.";
		        const text = tx ? (base + "\n" + tx) : base;
		        const title = (ch === "WSP") ? "Cliente no responde WhatsApp" : (ch === "EMAIL") ? "Cliente no responde correo" : "Cliente no contesta llamada";
			        try{
			          await logAction(ch, title, text, true, "NO_ANSWER");
			          toast("Seguimiento registrado", "success");
			        }catch(_){
			          toast("No pude registrar seguimiento", "error");
			        }
			      });

			      // Seguimiento rápido (según estado) — lista curada para registrar movimiento con 1 click.
			      qs("#qf_pick")?.addEventListener("click", async ()=>{
			        const st = String(estadoNombre(lead?.id_estado || "") || "").toUpperCase();
			        const bucket = st.includes("NUEVO") ? "NUEVO"
			          : st.includes("CONTACT") ? "CONTACTADO"
			          : st.includes("COTIZ") ? "COTIZADO"
			          : st.includes("CONFIRM") ? "CONFIRMADO"
			          : "OTRO";

			        const PRESETS = {
			          NUEVO: [
			            { label:"Nuevo ingreso", kind:"NOTE", title:"Nuevo ingreso", text:"Se registra nuevo cliente/oportunidad en CRM pendiente de gestión inicial.", followup:false },
			            { label:"Lead recibido por formulario", kind:"NOTE", title:"Lead recibido por formulario", text:"Se recibe lead desde formulario web y queda pendiente primer contacto.", followup:false },
			            { label:"Lead recibido por WhatsApp", kind:"NOTE", title:"Lead recibido por WhatsApp", text:"Se recibe consulta inicial vía WhatsApp pendiente de atención comercial.", followup:false },
			            { label:"Lead recibido por correo", kind:"NOTE", title:"Lead recibido por correo", text:"Se recibe consulta comercial vía correo electrónico.", followup:false },
			            { label:"Lead derivado interno", kind:"NOTE", title:"Lead derivado interno", text:"Cliente/oportunidad derivado internamente para gestión comercial.", followup:false },
			            { label:"Lead referido", kind:"NOTE", title:"Lead referido", text:"Cliente ingresa por recomendación o referido.", followup:false },
			            { label:"Datos incompletos", kind:"NOTE", title:"Datos incompletos", text:"Registro creado con información parcial del cliente. Pendiente completar.", followup:false },
			            { label:"Pendiente validación", kind:"NOTE", title:"Pendiente validación", text:"Cliente registrado pendiente de validación comercial o administrativa.", followup:false },
			            { label:"Sin canal definido", kind:"NOTE", title:"Sin canal definido", text:"Cliente ingresado sin canal de comunicación prioritario definido.", followup:false },
			            { label:"Pendiente asignación", kind:"NOTE", title:"Pendiente asignación", text:"Oportunidad ingresada pendiente de asignación a ejecutivo responsable.", followup:false },
			          ],
			          CONTACTADO: [
			            { label:"Contactado por WhatsApp", kind:"WSP", title:"Contactado por WhatsApp", text:"Se realiza contacto inicial con el cliente vía WhatsApp.", followup:true },
			            { label:"Contactado por correo", kind:"EMAIL", title:"Contactado por correo", text:"Se realiza contacto inicial con el cliente vía correo electrónico.", followup:true },
			            { label:"Contactado por llamada", kind:"CALL", title:"Contactado por llamada", text:"Se realiza contacto telefónico con el cliente para inicio de gestión comercial.", followup:true },
			            { label:"Cliente responde contacto", kind:"NOTE", title:"Cliente responde contacto", text:"Cliente responde gestión inicial y se establece comunicación.", followup:true },
			            { label:"Cliente solicita información", kind:"NOTE", title:"Cliente solicita información", text:"Cliente solicita antecedentes adicionales para evaluar la propuesta comercial.", followup:true },
			            { label:"Cliente solicita llamada posterior", kind:"NOTE", title:"Cliente solicita llamada posterior", text:"Cliente indica disponibilidad para contacto posterior en otra fecha u horario.", followup:true },
			            { label:"Cliente no contesta llamada", kind:"CALL", title:"Cliente no contesta llamada", text:"Se intenta contacto telefónico sin obtener respuesta del cliente.", followup:true, contact_outcome:"NO_ANSWER" },
			            { label:"Cliente no responde WhatsApp", kind:"WSP", title:"Cliente no responde WhatsApp", text:"Se envía mensaje por WhatsApp sin respuesta del cliente.", followup:true, contact_outcome:"NO_ANSWER" },
			            { label:"Cliente no responde correo", kind:"EMAIL", title:"Cliente no responde correo", text:"Se envía correo sin respuesta del cliente.", followup:true, contact_outcome:"NO_ANSWER" },
			            { label:"Seguimiento activo", kind:"NOTE", title:"Seguimiento activo", text:"Se mantiene gestión comercial activa a la espera de interacción o definición del cliente.", followup:true },
			          ],
			          COTIZADO: [
			            { label:"Cotización enviada", kind:"NOTE", title:"Cotización enviada", text:"Se envía cotización/propuesta comercial al cliente para evaluación.", followup:true },
			            { label:"Cotización enviada por correo", kind:"EMAIL", title:"Cotización enviada por correo", text:"Se remite cotización al cliente vía correo electrónico.", followup:true },
			            { label:"Cotización enviada por WhatsApp", kind:"WSP", title:"Cotización enviada por WhatsApp", text:"Se comparte cotización al cliente vía WhatsApp.", followup:true },
			            { label:"Cliente confirma recepción", kind:"NOTE", title:"Cliente confirma recepción", text:"Cliente confirma recepción de la cotización enviada.", followup:true },
			            { label:"Cliente revisando propuesta", kind:"NOTE", title:"Cliente revisando propuesta", text:"Cliente indica encontrarse revisando internamente la cotización/propuesta.", followup:true },
			            { label:"Cliente solicita ajuste de precio", kind:"NOTE", title:"Cliente solicita ajuste de precio", text:"Cliente solicita revisión o ajuste económico de la propuesta.", followup:true },
			            { label:"Cliente solicita ajuste técnico", kind:"NOTE", title:"Cliente solicita ajuste técnico", text:"Cliente solicita modificación en alcance, especificación o condiciones.", followup:true },
			            { label:"Pendiente aprobación interna del cliente", kind:"NOTE", title:"Pendiente aprobación interna", text:"Cliente informa que la propuesta está en proceso de validación interna.", followup:true },
			            { label:"A la espera de respuesta sobre cotización", kind:"NOTE", title:"A la espera de respuesta", text:"Se mantiene seguimiento de cotización enviada pendiente de respuesta del cliente.", followup:true },
			            { label:"Cliente rechaza cotización", kind:"NOTE", title:"Cliente rechaza cotización", text:"Cliente informa que no continuará con la cotización propuesta.", followup:true },
			          ],
			          CONFIRMADO: [
			            { label:"Cliente confirma interés de avance", kind:"NOTE", title:"Cliente confirma interés de avance", text:"Cliente confirma intención de avanzar con la propuesta presentada.", followup:true },
			            { label:"Cliente acepta cotización", kind:"NOTE", title:"Cliente acepta cotización", text:"Cliente acepta condiciones comerciales de la cotización enviada.", followup:true },
			            { label:"Pendiente orden de compra", kind:"NOTE", title:"Pendiente orden de compra", text:"Cliente confirma avance, quedando pendiente emisión de orden de compra.", followup:true },
			            { label:"Pendiente pago anticipado", kind:"NOTE", title:"Pendiente pago anticipado", text:"Cliente confirma avance, quedando pendiente pago inicial o anticipo.", followup:true },
			            { label:"Pendiente firma de documentos", kind:"NOTE", title:"Pendiente firma de documentos", text:"Cliente confirma continuidad, pendiente firma de contrato o documentación.", followup:true },
			            { label:"Fecha de inicio confirmada", kind:"NOTE", title:"Fecha de inicio confirmada", text:"Se confirma fecha de inicio/entrega/implementación con el cliente.", followup:true },
			            { label:"Confirmado por correo", kind:"EMAIL", title:"Confirmado por correo", text:"Cliente confirma avance formalmente vía correo electrónico.", followup:true },
			            { label:"Confirmado por WhatsApp", kind:"WSP", title:"Confirmado por WhatsApp", text:"Cliente confirma avance comercial vía WhatsApp.", followup:true },
			            { label:"Confirmado verbalmente", kind:"CALL", title:"Confirmado verbalmente", text:"Cliente confirma verbalmente intención de avanzar.", followup:true },
			            { label:"En proceso de cierre", kind:"NOTE", title:"En proceso de cierre", text:"Operación confirmada comercialmente y en proceso de cierre administrativo.", followup:true },
			          ],
			          OTRO: [
			            { label:"Seguimiento", kind:"NOTE", title:"Seguimiento", text:"Seguimiento registrado.", followup:true },
			          ],
			        };

			        const options = PRESETS[bucket] || PRESETS.OTRO;
			        const optBtns = options.map((o, i)=>{
			          const active = (i===0) ? "fuBtnActive" : "";
			          return `<button type="button" class="fuBtn ${active}" data-idx="${i}" title="${escapeHtml(o.title || o.label)}">${escapeHtml(o.label)}</button>`;
			        }).join("");

			        const res = await Swal.fire({
			          title: "Seguimiento rápido",
			          html: `
			            <div style="text-align:left;display:grid;gap:10px">
			              <div class="muted" style="font-weight:950">Estado: <span style="color:var(--text)">${escapeHtml(st||bucket)}</span></div>
			              <div class="muted" style="font-weight:950">Tipo</div>
			              <input type="hidden" id="sw_fu_idx" value="0" />
			              <div class="fuGrid">${optBtns}</div>
			              <label class="muted" style="font-weight:950">Detalle (opcional)</label>
			              <textarea id="sw_fu_txt" class="swTa" rows="3" placeholder="Agrega contexto si aplica…"></textarea>
			            </div>
			            <style>
			              .fuGrid{ display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:8px; }
			              .fuBtn{
			                width:100%;
			                border:1px solid rgba(148,163,184,.22);
			                background:rgba(255,255,255,.04);
			                color:inherit;
			                border-radius:14px;
			                padding:10px 10px;
			                font-weight:1000;
			                cursor:pointer;
			                text-align:left;
			                line-height:1.15;
			              }
			              .fuBtn:hover{ background:rgba(255,255,255,.08); }
			              .fuBtnActive{
			                border-color: color-mix(in srgb, var(--accent,#19c37d) 55%, transparent);
			                background: color-mix(in srgb, var(--accent,#19c37d) 16%, transparent);
			              }
			              @media (max-width: 520px){ .fuGrid{ grid-template-columns: 1fr; } }
			            </style>
			          `,
			          showCancelButton: true,
			          confirmButtonText: "Registrar",
			          cancelButtonText: "Cancelar",
			          focusConfirm: false,
			          didOpen: ()=>{
			            try{
			              const root = Swal.getHtmlContainer();
			              if (!root) return;
			              const setIdx = (idx)=>{
			                try{ document.getElementById("sw_fu_idx").value = String(idx); }catch(_){}
			                root.querySelectorAll(".fuBtn").forEach(b=> b.classList.toggle("fuBtnActive", String(b.getAttribute("data-idx"))===String(idx)));
			              };
			              root.querySelectorAll(".fuBtn").forEach(b=>{
			                b.addEventListener("click", ()=>{
			                  const idx = Number(b.getAttribute("data-idx") || 0);
			                  setIdx(isNaN(idx) ? 0 : idx);
			                });
			              });
			              setIdx(0);
			            }catch(_){}
			          },
			          preConfirm: ()=>{
			            const idx = Number(document.getElementById("sw_fu_idx")?.value || 0);
			            const tx = String(document.getElementById("sw_fu_txt")?.value || "").trim();
			            return { idx, tx };
			          }
			        });
			        if (!res.isConfirmed) return;
			        const idx = Number(res.value?.idx || 0);
			        const extra = String(res.value?.tx || "").trim();
			        const o = options[Math.max(0, Math.min(options.length-1, idx))] || options[0];
			        const text = extra ? (String(o.text || "") + "\n" + extra) : String(o.text || "");
			        try{
			          await logAction(
			            o.kind || "NOTE",
			            o.title || o.label || "Seguimiento",
			            text,
			            !!o.followup,
			            o.contact_outcome || ""
			          );
			          toast("Seguimiento registrado", "success");
			        }catch(_){
			          toast("No pude registrar seguimiento", "error");
			        }
			      });

	      // Quick actions (iconos en labels)
	      qs("#qa_call")?.addEventListener("click", async ()=>{
	        const tel = String(qs("#e_tel")?.value || lead.telefono || "").trim();
	        if (!tel){ toast("Lead sin teléfono", "warning"); return; }
	        await logAction("CALL", "Llamada iniciada", `Se inicia llamada a ${tel}.`);
	        window.open("tel:" + tel, "_self");
	      });
	      qs("#qa_wa")?.addEventListener("click", ()=>{
	        try{ lead.telefono = String(qs("#e_tel")?.value || lead.telefono || ""); }catch(_){}
	        try{ doWhatsApp(lead, { defaultAction:"open" }); }catch(_){}
	      });
	      qs("#qa_email")?.addEventListener("click", async ()=>{
	        const mail = String(qs("#e_email")?.value || lead.email || "").trim();
	        if (!mail){ toast("Lead sin email", "warning"); return; }
	        await logAction("EMAIL", "Email iniciado", `Se abre cliente de correo para ${mail}.`);
	        window.open(`mailto:${encodeURIComponent(mail)}`, "_self");
	      });
	      qs("#qa_vcard")?.addEventListener("click", async ()=>{
	        try{
	          const safe = (s)=> String(s||"").trim().replace(/[\\/:*?"<>|]+/g, " ").replace(/\\s+/g, " ").trim();
	          const cliente = safe(lead.nombre_cliente || lead.cliente || "Cliente");
	          const marca = safe(lead.marca || "");
	          const fname = `Contacto - ${cliente}${marca ? (" - " + marca) : ""}.vcf`;

	          const share = await apiJSON(`/leads/${lead.id_lead}/vcard_link`, { method:"GET" }).catch(()=>null);
	          const sharePath = share?.url ? apiURL(String(share.url)) : "";
	          const shareURL = sharePath ? (sharePath.startsWith("http") ? sharePath : (location.origin + sharePath)) : "";

	          const r = await Swal.fire({
	            title: "Contacto (vCard)",
	            html: `
	              <div style="text-align:left">
	                <div class="muted" style="font-weight:900;margin-bottom:8px;">Opciones</div>
	                <ul style="margin:0 0 10px 18px; padding:0;">
	                  <li><strong>Descargar</strong> (.vcf) para guardarlo ahora.</li>
	                  <li><strong>Copiar link</strong> para abrirlo desde el teléfono (sin token).</li>
	                </ul>
	                ${shareURL ? `<div class="muted" style="font-size:12px;">Link: <span style="font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;">${escapeHtml(shareURL)}</span></div>` : `<div class="muted" style="font-size:12px;">(No pude generar link público; igual puedes descargar.)</div>`}
	              </div>
	            `,
	            showCancelButton: true,
	            showDenyButton: !!shareURL,
	            confirmButtonText: "Descargar",
	            denyButtonText: "Copiar link",
	            cancelButtonText: "Cerrar",
	            focusConfirm: false,
	            width: 720,
	          });

	          if (r.isDenied && shareURL){
	            try{
	              await navigator.clipboard.writeText(shareURL);
	              toast("Link copiado", "success");
	              try{ await logAction("VCARD", "vCard compartida", `Se copió link vCard: ${shareURL}`); }catch(_){}
	            }catch(_){
	              toast("No pude copiar (permiso de clipboard)", "warning");
	            }
	            return;
	          }
	          if (!r.isConfirmed) return;

	          try{ await logAction("VCARD", "vCard descargada", "Se descargó la vCard del cliente."); }catch(_){}
	          const r2 = await fetch(apiURL(`/leads/${lead.id_lead}/vcard`), {
	            headers: authHeaders({ "Accept": "text/vcard,text/x-vcard,text/plain,*/*" }),
	          });
	          if (!r2.ok) throw new Error("No pude generar vCard (HTTP " + r2.status + ")");
	          const blob = await r2.blob();
	          const url = URL.createObjectURL(blob);
	          const a = document.createElement("a");
	          a.href = url;
	          a.download = fname;
	          document.body.appendChild(a);
	          a.click();
	          a.remove();
	          setTimeout(()=>{ try{ URL.revokeObjectURL(url); }catch(_){ } }, 60_000);
	        }catch(err){
	          toast("No pude generar vCard: " + String(err?.message||err), "error");
	        }
	      });
	      qs("#qa_quote")?.addEventListener("click", async ()=>{
	        try{
	          const num = String(qs("#e_numcot")?.value || lead.num_cotizacion || "").trim();
	          const cid = Number(lead.id_cotizacion_vigente || 0);
	          if (cid > 0){
	            await logAction("QUOTE", "Cotización abierta", `Se abre cotización del sistema #${num || cid}.`);
	            const pdf = apiURL(`/quotes/${cid}/pdf`);
	            const wait = apiURL(`/web/views/pdf_wait.html?u=${encodeURIComponent(pdf)}&t=${encodeURIComponent("Abriendo PDF…")}`);
	            window.open(wait, "_blank", "noopener,noreferrer");
	            return;
	          }
	          if (lead.cotizacion_pdf_url){
	            await logAction("QUOTE", "Cotización abierta", `Se abre cotización manual #${num || ("Lead " + lead.id_lead)}.`);
	            const pdf = apiURL(`/leads/${lead.id_lead}/cotizacion_pdf`);
	            const wait = apiURL(`/web/views/pdf_wait.html?u=${encodeURIComponent(pdf)}&t=${encodeURIComponent("Abriendo PDF…")}`);
	            window.open(wait, "_blank", "noopener,noreferrer");
	            return;
	          }
	          toast("Sin cotización para abrir", "warning");
	        }catch(_){
	          toast("No pude abrir cotización", "error");
	        }
	      });

	      function setButtonsState(){
	        const hasLocal = !!localPdfFile;
	        const hasRemote = !!lead.cotizacion_pdf_url;
        if (viewBtn) viewBtn.disabled = !(hasLocal || hasRemote);
        // Cargar productos se puede abrir incluso sin PDF (carga manual).
        if (ocrBtn) ocrBtn.disabled = false;
        if (hint){
          if (isUploadingPdf) hint.textContent = "Subiendo PDF…";
          else if (hasLocal && !hasRemote) hint.textContent = "PDF seleccionado. Subiendo automáticamente…";
          else if (hasRemote) hint.textContent = "PDF cargado. Puedes verlo y/o cargar productos manualmente.";
          else hint.textContent = "Sin PDF (opcional). Igual puedes cargar productos manualmente.";
        }
      }

      async function uploadSelectedPdf(){
        if (!localPdfFile || isUploadingPdf) return;
        isUploadingPdf = true;
        setButtonsState();
        try{
          const fd = new FormData();
          fd.append("file", localPdfFile);
          const r = await fetch(apiURL(`/leads/${lead.id_lead}/cotizacion_pdf`), { method:"POST", headers: authHeaders(), body: fd });
          if (!r.ok){
            const t = await r.text().catch(()=> "");
            throw new Error("No pude subir PDF" + (t ? (": " + t.slice(0,200)) : ""));
          }
          const data = await r.json().catch(()=>null);
          if (data?.path) lead.cotizacion_pdf_url = data.path;

          toast("PDF subido", "success");
        }catch(err){
          toast(String(err?.message || err), "error");
        }finally{
          isUploadingPdf = false;
          setButtonsState();
        }
      }

      async function saveMetaNow(){
        try{
          const num = (qs("#e_numcot")?.value || "").trim();
          const montoRaw = (qs("#e_monto")?.value || "").trim();
          const meta = {};
          if (num) meta.num_cotizacion = num;
          if (montoRaw) meta.monto_cotizado = Number(montoRaw);
          if (!Object.keys(meta).length) return;

          await apiJSON("/leads/" + lead.id_lead, {
            method: "PUT",
            headers: { "Content-Type":"application/json" },
            body: JSON.stringify(meta),
          });
          lead.num_cotizacion = meta.num_cotizacion ?? lead.num_cotizacion;
          if (meta.monto_cotizado != null) lead.monto_cotizado = meta.monto_cotizado;
          toast("Cotización guardada", "success");
        }catch(err){
          toast("No pude guardar cotización: " + String(err?.message || err), "error");
        }
      }

      function scheduleMetaSave(){
        if (metaSaveT) clearTimeout(metaSaveT);
        metaSaveT = setTimeout(saveMetaNow, 500);
      }

      if (fileEl){
        fileEl.addEventListener("change", ()=>{
          localPdfFile = fileEl.files && fileEl.files[0] ? fileEl.files[0] : null;
          setButtonsState();
          // UX: al seleccionar PDF, lo subimos inmediatamente para evitar que el usuario "olvide guardar".
          uploadSelectedPdf();
        });
      }
      setButtonsState();

      // Guardado "a prueba de cierres": al cambiar número/monto, lo guardamos (debounce).
      const numEl = qs("#e_numcot");
      const montoEl = qs("#e_monto");
      if (numEl){
        numEl.addEventListener("input", scheduleMetaSave);
        numEl.addEventListener("blur", saveMetaNow);
      }
      if (montoEl){
        montoEl.addEventListener("input", scheduleMetaSave);
        montoEl.addEventListener("blur", saveMetaNow);
      }

      if (viewBtn){
        viewBtn.onclick = async ()=>{
          try{
            if (hint) hint.textContent = "Cargando PDF…";
            let blob = null;
            if (localPdfFile){
              blob = localPdfFile;
            }else{
              const r = await fetch(apiURL(`/leads/${lead.id_lead}/cotizacion_pdf`), { headers: authHeaders() });
              if (!r.ok) throw new Error("No pude abrir PDF (HTTP " + r.status + ")");
              blob = await r.blob();
            }
            const url = URL.createObjectURL(blob);
            window.open(url, "_blank", "noopener");
            setTimeout(()=>{ try{ URL.revokeObjectURL(url); }catch(_){ } }, 60_000);
            if (hint) hint.textContent = "PDF abierto.";
          }catch(err){
            if (hint) hint.textContent = "Error abriendo PDF.";
            toast("No pude abrir el PDF: " + String(err?.message||err), "error");
          }
        };
      }

      if (ocrBtn){
        ocrBtn.onclick = async ()=>{
          try{
            const list = [];
            const leadDay = String(lead.fecha_evento || "").slice(0,10);

            // Antes de abrir el modal, preguntamos si es 1 día o varios.
            const mode = await Swal.fire({
              title: "Productos para MICE",
              input: "radio",
              inputOptions: {
                single: leadDay ? `Un día (fecha evento: ${leadDay})` : "Un día (fecha evento)",
                multi: "Varios días (día por día)",
              },
              inputValue: "single",
              customClass: { popup: "gdNeutral" },
              showCancelButton: true,
              confirmButtonText: "Continuar",
              cancelButtonText: "Cancelar",
              inputValidator: (v)=> !v ? "Selecciona una opción." : null,
            });
            if (!mode.isConfirmed) return;
            const isMulti = String(mode.value || "single") === "multi";

            const marcaName = (()=>{
              try{
                const hit = (CATS.marcas || []).find(m => Number(m.id_marca) === Number(lead.id_marca));
                return (hit?.nombre || hit?.marca || "").toString().trim();
              }catch(_){ return ""; }
            })();
            const html2 = `
              <div style="text-align:left;display:grid;gap:10px">
                <div class="muted">Recomendado: carga manual (rápido y confiable). Si quieres, puedes intentar OCR como ayuda (opcional).</div>
                <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
                  <button type="button" class="swBtn secondary" id="mi2_toggle_ocr">Probar OCR</button>
                  <div class="muted" id="mi_ocr2_status"></div>
                </div>
                <div id="mi2_ocr_tools" style="display:none;flex-wrap:wrap;gap:10px;align-items:center">
                  <button type="button" class="swBtn secondary" id="mi_parse2">Leer PDF (rápido)</button>
                  <button type="button" class="swBtn secondary" id="mi_ocr2">Escanear PDF (OCR)</button>
                  <div class="muted" id="mi_ocr2_tip">Tip: OCR escanea hasta 2 páginas (más rápido).</div>
                </div>
                <div style="border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.10);display:grid;gap:10px">
                  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
                    ${isMulti ? `
                    <label style="width:170px">
                      <div class="muted" style="margin-bottom:6px">Día</div>
                      <input id="mi2_day" class="swInp" type="date" value="${escapeHtml(leadDay)}" />
                    </label>` : ``}
                    <label style="flex:1;min-width:240px">
                      <div class="muted" style="margin-bottom:6px">Producto (marca: ${escapeHtml(marcaName || "—")})</div>
                      <input id="mi2_prod_search" class="swInp" placeholder="Buscar producto…" />
                    </label>
                    <label style="flex:1;min-width:260px">
                      <div class="muted" style="margin-bottom:6px">Selecciona</div>
                      <select id="mi2_prod_sel" class="swSel"><option value="">Cargando…</option></select>
                    </label>
                    <label style="width:120px">
                      <div class="muted" style="margin-bottom:6px">Cantidad</div>
                      <input id="mi2_prod_qty" class="swInp" type="number" step="0.01" value="1" />
                    </label>
                    <button type="button" class="swBtn secondary" id="mi2_prod_add">Agregar</button>
                  </div>
                  <div class="muted" id="mi2_prod_status">Carga manual recomendada: elige productos de la marca y ajusta cantidades.</div>
                </div>
                <div id="mi_list2" style="display:grid;gap:6px"></div>
              </div>
            `;

            function currentDay(){
              if (!isMulti) return leadDay || "";
              const d = (qs("#mi2_day")?.value || "").trim();
              return d || (leadDay || "");
            }

            function renderList2(){
              const box = qs("#mi_list2");
              if (!box) return;
              const row = (it, idx) => `
                <div style="display:grid;grid-template-columns:${isMulti ? "170px 1fr 120px 96px" : "1fr 120px 96px"};gap:8px;align-items:center;border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:10px 12px;background:rgba(0,0,0,.12)">
                  ${isMulti ? `<input class="swInp" data-mi2-d="${idx}" type="date" value="${escapeHtml(String(it.service_date || leadDay || "").slice(0,10))}" />` : ``}
                  <input class="swInp" data-mi2-p="${idx}" value="${escapeHtml(it.producto || "")}" placeholder="Producto" />
                  <input class="swInp" data-mi2-q="${idx}" type="number" step="0.01" value="${escapeHtml(String(it.cantidad ?? ""))}" placeholder="Cantidad" />
                  <button type="button" class="swBtn secondary" data-mi2-del="${idx}">Quitar</button>
                </div>
              `;

              if (!list.length){
                box.innerHTML = `
                  <div style="display:grid;gap:10px">
                    <div class="muted">Aún no hay productos.</div>
                    <button type="button" class="swBtn secondary" id="mi2_add">+ Agregar línea</button>
                  </div>
                `;
              }else if (!isMulti){
                box.innerHTML = `
                  <div style="display:grid;gap:8px">
                    ${list.map((it, idx)=> row(it, idx)).join("")}
                    <button type="button" class="swBtn secondary" id="mi2_add">+ Agregar línea</button>
                  </div>
                `;
              }else{
                // Agrupar por día (día por día)
                const groups = {};
                for (let i=0;i<list.length;i++){
                  const it = list[i] || {};
                  const d = String(it.service_date || leadDay || "").slice(0,10) || "(sin día)";
                  (groups[d] ||= []).push({ idx:i, it });
                }
                const days = Object.keys(groups).sort();
                box.innerHTML = `
                  <div style="display:grid;gap:10px">
                    ${days.map(d => `
                      <div style="border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.08)">
                        <div style="font-weight:1000;margin-bottom:8px">${escapeHtml(d)}</div>
                        <div style="display:grid;gap:8px">
                          ${groups[d].map(x => row(x.it, x.idx)).join("")}
                        </div>
                      </div>
                    `).join("")}
                    <button type="button" class="swBtn secondary" id="mi2_add">+ Agregar línea</button>
                  </div>
                `;
              }

              // wire edits
              box.querySelectorAll("[data-mi2-d]").forEach(inp=>{
                inp.oninput = ()=>{
                  const i = Number(inp.getAttribute("data-mi2-d"));
                  if (!Number.isFinite(i) || !list[i]) return;
                  list[i].service_date = String(inp.value || "").slice(0,10) || null;
                };
              });
              box.querySelectorAll("[data-mi2-p]").forEach(inp=>{
                inp.oninput = ()=>{
                  const i = Number(inp.getAttribute("data-mi2-p"));
                  if (!Number.isFinite(i) || !list[i]) return;
                  list[i].producto = String(inp.value || "").trim();
                };
              });
              box.querySelectorAll("[data-mi2-q]").forEach(inp=>{
                inp.oninput = ()=>{
                  const i = Number(inp.getAttribute("data-mi2-q"));
                  if (!Number.isFinite(i) || !list[i]) return;
                  list[i].cantidad = Number(inp.value || 0) || 0;
                };
              });
              box.querySelectorAll("[data-mi2-del]").forEach(btn=>{
                btn.onclick = ()=>{ const i = Number(btn.getAttribute("data-mi2-del")); if (!Number.isFinite(i)) return; list.splice(i,1); renderList2(); };
              });
              const addBtn = qs("#mi2_add");
              addBtn && (addBtn.onclick = ()=>{
                const d = currentDay();
                list.push({ producto: "", cantidad: 1, service_date: isMulti ? (d || null) : null });
                renderList2();
              });
            }

            const res2 = await Swal.fire({
              title: "Cargar productos manualmente",
              html: html2,
              width: 860,
              focusConfirm: false,
              showCancelButton: true,
              confirmButtonText: "Guardar productos",
              cancelButtonText: "Cerrar",
              didOpen: ()=>{
                renderList2();
                // toggle OCR tools
                const tBtn = qs("#mi2_toggle_ocr");
                const tools = qs("#mi2_ocr_tools");
                if (tBtn && tools){
                  tBtn.onclick = ()=>{
                    const open = tools.style.display !== "none";
                    tools.style.display = open ? "none" : "flex";
                    tBtn.textContent = open ? "Probar OCR" : "Ocultar OCR";
                  };
                }
                const parseBtn = qs("#mi_parse2");
                const btn2 = qs("#mi_ocr2");
                const st2 = qs("#mi_ocr2_status");
                const setMsg = (m)=>{ if (st2) st2.textContent = m; };

                // ===== Manual: productos por marca =====
                const sel = qs("#mi2_prod_sel");
                const search = qs("#mi2_prod_search");
                const qtyEl = qs("#mi2_prod_qty");
                const addBtn = qs("#mi2_prod_add");
                const st = qs("#mi2_prod_status");
                let allProds = [];

                function renderProducts(filterText=""){
                  if (!sel) return;
                  const ft = String(filterText || "").trim().toLowerCase();
                  const items = ft
                    ? allProds.filter(p => String(p.producto || "").toLowerCase().includes(ft))
                    : allProds;
                  const opts = items.length
                    ? items.slice(0, 2000).map(p => `<option value="${escapeHtml(p.producto || "")}">${escapeHtml(p.producto || "")}</option>`).join("")
                    : `<option value="">(sin productos)</option>`;
                  sel.innerHTML = `<option value="">— Selecciona —</option>` + opts;
                }

                (async ()=>{
                  try{
                    if (st) st.textContent = "Cargando productos…";
                    // Ojo: en este hosting el filtro `?marca=` puede ser case-sensitive y retornar vacío.
                    // Para que SIEMPRE funcione, traemos el catálogo completo y filtramos aquí.
                    // Además, /productos no siempre reescribe a /crm/productos, así que pegamos a /crm.
                    const data = await apiJSON("/crm/productos?limit=5000");
                    // Compat: algunos endpoints/versions devuelven array directo en vez de {items:[...]}.
                    allProds = Array.isArray(data) ? data : (data?.items || []);

                    // Si el backend ignora el query param marca, filtramos acá por seguridad.
                    const norm = (s)=>String(s||"")
                      .normalize("NFD").replace(/[\u0300-\u036f]/g,"")
                      .trim().toUpperCase();
                    const want = norm(marcaName);
                    if (want && allProds.length){
                      const filtered = allProds.filter(p => norm(p?.marca) === want);
                      // fallback: contiene (por si hay variantes tipo "CARRITOS DEL SABOR")
                      allProds = filtered.length ? filtered : allProds.filter(p => norm(p?.marca).includes(want));
                    }
                    renderProducts("");
                    if (st) st.textContent = allProds.length ? `Productos cargados: ${allProds.length}` : "No hay productos para esta marca.";
                  }catch(err){
                    allProds = [];
                    renderProducts("");
                    if (st) st.textContent = "No pude cargar productos: " + String(err?.message || err);
                  }
                })();

                search && search.addEventListener("input", ()=>{
                  // el input solo filtra; el valor real debe seleccionarse en el <select>
                  renderProducts(search.value);
                  if (sel) sel.value = "";
                });
                addBtn && (addBtn.onclick = ()=>{
                  const prod = String(sel?.value || "").trim();
                  const qty = Number(qtyEl?.value || 0) || 0;
                  const d = currentDay();
                  if (!prod){
                    toast("Selecciona un producto de la lista", "error");
                    return;
                  }
                  if (qty <= 0){
                    toast("Cantidad inválida", "error");
                    return;
                  }
                  const hit = list.find(x =>
                    String(x.producto || "").toUpperCase() === prod.toUpperCase()
                    && String(x.service_date || "").slice(0,10) === String(isMulti ? (d || "") : "").slice(0,10)
                  );
                  if (hit) hit.cantidad = (Number(hit.cantidad || 0) || 0) + qty;
                  else list.push({ producto: prod, cantidad: qty, service_date: isMulti ? (d || null) : null });
                  renderList2();
                  toast("Producto agregado", "success");
                });

                parseBtn && (parseBtn.onclick = async ()=>{
                  try{
                    parseBtn.disabled = true;
                    setMsg("Leyendo PDF (texto)…");
                    const parsed = await apiJSON(`/leads/${lead.id_lead}/cotizacion_pdf/parse`, { method:"POST" });
                    const items = (parsed && parsed.items) ? parsed.items : [];
                    if (!items.length){
                      setMsg("No pude detectar items por texto. Si el PDF es escaneado, usa OCR.");
                      return;
                    }
                    // Normaliza a {producto,cantidad}
                    const guessed = items.map(it => ({
                      producto: it.producto || it.nombre || it.item || "",
                      cantidad: Number(it.cantidad || it.qty || 0) || 0,
                    })).filter(x => x.producto && x.cantidad > 0);
                    const withDay = guessed.map(x => ({ ...x, service_date: isMulti ? (currentDay() || null) : null }));
                    if (!guessed.length){
                      setMsg("Leí el PDF, pero no pude armar items (usa OCR o agrega manual).");
                      return;
                    }
                    list.splice(0, list.length, ...withDay);
                    renderList2();
                    setMsg(`Listo: detecté ${guessed.length} producto(s). Revisa y guarda.`);
                  }catch(err){
                    setMsg("Error leyendo PDF: " + String(err?.message || err));
                  }finally{
                    parseBtn.disabled = false;
                  }
                });
                btn2 && (btn2.onclick = async ()=>{
                  try{
                    btn2.disabled = true;
                    setMsg("Preparando OCR…");
                    const prog = ({ phase, page, total, pct })=>{
                      const p = (pct != null) ? ` · ${(pct*100).toFixed(0)}%` : "";
                      setMsg(phase === "render"
                        ? `Renderizando página ${page}/${total}…`
                        : `OCR página ${page}/${total}${p}…`);
                    };
                    const r = localPdfFile
                      ? await ocrPdfToTextFromFile(localPdfFile, { maxPages: 2, onProgress: prog })
                      : await ocrPdfToText({
                          url: `/leads/${lead.id_lead}/cotizacion_pdf`,
                          headers: authHeaders(),
                          maxPages: 2,
                          onProgress: prog
                        });
                    const guessed = guessItemsFromOcrText(r.text);
                    if (!guessed.length){
                      setMsg("OCR listo, pero no pude detectar líneas (revisar PDF/contraste).");
                      return;
                    }
                    const withDay = guessed.map(x => ({ ...x, service_date: isMulti ? (currentDay() || null) : null }));
                    list.splice(0, list.length, ...withDay);
                    renderList2();
                    setMsg(`OCR listo: ${guessed.length} línea(s). Revísalas y guarda.${isMulti ? " (Si es multi-día, ajusta el día por línea.)" : ""}`);
                  }catch(err){
                    setMsg("Error OCR: " + String(err?.message || err));
                  }finally{
                    btn2.disabled = false;
                  }
                });

                // Manual (sin auto-scan): el usuario decide si leer rápido u OCR.
              },
              preConfirm: ()=>{
                if (!list.length){
                  Swal.showValidationMessage("No hay productos para guardar.");
                  return false;
                }
                if (isMulti){
                  const bad = list.find(x => !String(x.service_date || "").slice(0,10));
                  if (bad){
                    Swal.showValidationMessage("Falta el día en al menos un producto.");
                    return false;
                  }
                }
                const items = list.map(x => ({
                  producto: String(x.producto || "").trim(),
                  cantidad: Number(x.cantidad || 0) || 0,
                  service_date: (isMulti ? String(x.service_date || "").slice(0,10) : (leadDay || "")) || null,
                })).filter(x => x.producto && x.cantidad > 0);
                return { items };
              }
            });
            if (!res2.isConfirmed) return;

            await apiJSON(`/leads/${lead.id_lead}/mice_items`, {
              method: "PUT",
              headers: { "Content-Type":"application/json" },
              body: JSON.stringify(res2.value),
            });
            try{
              const cur = await apiJSON(`/leads/${lead.id_lead}/mice_items`);
              const use = Array.isArray(cur?.by_day) ? cur.by_day : (cur?.items || []);
              const n = Array.isArray(use) ? use.length : 0;
              lead._mice_items = use || [];
              toast(`Productos guardados (${n})`, "success");
            }catch(_){
              toast("Productos guardados", "success");
            }

            // SweetAlert2 no soporta modales anidados; al abrir este modal se cierra el del lead.
            // Reabrimos el lead para que el usuario siga trabajando sin perder contexto.
            setTimeout(()=>{ try{ openEditModal(lead); }catch(_){ } }, 50);
          }catch(err){
            toast("OCR: " + String(err?.message||err), "error");
          }
        };
      }
    },
    preConfirm: ()=>{
      const cliente = (qs("#e_cliente").value || "").trim();
      if (!cliente){
        Swal.showValidationMessage("Nombre cliente es obligatorio.");
        return false;
      }
      const comment = (qs("#e_comment").value || "").trim();
      const prevNotes = (qs("#e_notas").value || "").trim();
      const statusChanged = Number(qs("#e_estado").value) !== Number(lead.id_estado || 0);
      const selectedEstadoName = estadoNombre(Number(qs("#e_estado").value || 0));
      const isConfirmingEstado = isConfirmEstadoName(selectedEstadoName);
      if (statusChanged && !isConfirmingEstado && comment.length < 8){
        Swal.showValidationMessage("Para cambiar el estado debes escribir un comentario claro. Mínimo 8 caracteres.");
        return false;
      }
      const fileEl = qs("#e_pdf");
      pdfFile = fileEl?.files?.[0] || null;
      return {
        cliente,
        email: (qs("#e_email").value || "").trim() || null,
        telefono: (qs("#e_tel").value || "").trim() || null,
        id_marca: Number(qs("#e_marca").value),
        id_comuna: Number(qs("#e_comuna").value),
        id_tipo_cliente: qs("#e_tipo").value ? Number(qs("#e_tipo").value) : null,
        plataforma: (qs("#e_plataforma")?.value || "").trim() || null,
        id_estado: Number(qs("#e_estado").value),
        fecha_evento: (qs("#e_fecha").value || null),
        direccion: (qs("#e_dir").value || "").trim() || null,
        notas: prevNotes || null,
        movement_comment: comment || null,
        num_cotizacion: (qs("#e_numcot").value || "").trim() || null,
        monto_cotizado: qs("#e_monto").value ? Number(qs("#e_monto").value) : 0
      };
    }
  });

  if (res.isDenied){
    const ok = await Swal.fire({
      title: `¿Borrar lead #${lead.id_lead}?`,
      html: `<div style="text-align:left">
        <div>Esta acción <b>no elimina</b> definitivamente: lo marca como borrado para no ensuciar métricas.</div>
        <div class="muted" style="margin-top:8px">Solo Admin puede hacerlo.</div>
        <textarea id="del_motivo" class="swTa" style="margin-top:12px;min-height:96px" placeholder="Motivo obligatorio: duplicado, error de carga, cliente pidió eliminar, etc."></textarea>
      </div>`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: "Sí, borrar",
      cancelButtonText: "Cancelar",
      confirmButtonColor: "#ef4444",
      focusConfirm: false,
      preConfirm: ()=>{
        const txt = String(document.getElementById("del_motivo")?.value || "").trim();
        if (txt.length < 8){
          Swal.showValidationMessage("Escribe un motivo claro. Mínimo 8 caracteres.");
          return false;
        }
        return txt;
      }
    });
    if (!ok.isConfirmed) return;

    try{
      await apiJSON("/leads/" + lead.id_lead, {
        method:"DELETE",
        headers: { "Content-Type":"application/json" },
        body: JSON.stringify({ motivo: ok.value })
      });
      toast("Lead borrado", "success");
      await loadLeads();
      render();
      setStatus("Leads: " + LEADS.length);
    }catch(err){
      toast("No pude borrar el lead: " + String(err.message||err), "error");
    }
    return;
  }

  if (!res.isConfirmed) return;

  try{
    const estados = CATS.estados || [];
    const confirmadoId = (()=>{
      const hit = estados.find(s => String(s?.nombre || "").toUpperCase().includes("CONFIRM"));
      return hit ? Number(hit.id_estado) : null;
    })();
    const wantsConfirmFlow = (confirmadoId != null) && (Number(res.value.id_estado) === Number(confirmadoId));
    const statusChanged = Number(res.value.id_estado) !== Number(lead.id_estado || 0);

    // 1) Guardar cambios del lead (sin tocar el estado) para no saltarnos el flujo de confirmación/agendamiento.
    const payloadNoEstado = { ...res.value };
    delete payloadNoEstado.id_estado;
    if (statusChanged) delete payloadNoEstado.movement_comment;
    await apiJSON("/leads/" + lead.id_lead, {
      method:"PUT",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify(payloadNoEstado)
    });

    // 2) Subir PDF si corresponde
    if (pdfFile){
      const fd = new FormData();
      fd.append("file", pdfFile);
      const r = await fetch(apiURL(`/leads/${lead.id_lead}/cotizacion_pdf`), { method:"POST", headers: authHeaders(), body: fd });
      if (!r.ok){
        const t = await r.text().catch(()=> "");
        throw new Error("No pude subir PDF" + (t ? (": " + t.slice(0,200)) : ""));
      }
      try{
        const data = await r.json().catch(()=>null);
        if (data?.path) lead.cotizacion_pdf_url = data.path;
      }catch(_){}
    }

    // Reflejar cambios locales antes del flujo (fecha_evento, num/monto, marca, etc.)
    Object.assign(lead, res.value);

    // 3) Si el usuario dejó "Confirmado", ejecutamos el flujo correcto (elige cotización, calcula OPS/montaje y agenda).
    if (wantsConfirmFlow){
      const ok = await handleConfirmado(lead, Number(confirmadoId), res.value.movement_comment || "");
      if (!ok){
        toast("Confirmación cancelada", "warning");
      }
    }else{
      // Si NO es confirmado, actualizamos el estado normalmente.
      await apiJSON("/leads/" + lead.id_lead, {
        method:"PUT",
        headers: { "Content-Type":"application/json" },
        body: JSON.stringify({ id_estado: res.value.id_estado, movement_comment: res.value.movement_comment || null })
      });
      toast("Lead actualizado", "success");
    }

    await loadLeads();
    render();
    setStatus("Leads: " + LEADS.length);
  }catch(err){
    toast("Error guardando lead: " + String(err.message||err), "error");
  }
}

function _tzOffsetHHMM(d){
  try{
    const offMin = -d.getTimezoneOffset(); // minutes east of UTC
    const sign = offMin >= 0 ? "+" : "-";
    const abs = Math.abs(offMin);
    const hh = String(Math.floor(abs / 60)).padStart(2, "0");
    const mm = String(abs % 60).padStart(2, "0");
    return `${sign}${hh}:${mm}`;
  }catch(_){
    return "";
  }
}
function _localISO(dateStr, timeStr){
  const ds = String(dateStr||"").trim();
  const ts = String(timeStr||"").trim();
  if (!ds || !ts) return null;
  const [y,m,d] = ds.split("-").map(x=>Number(x||0));
  const [hh,mm] = ts.split(":").map(x=>Number(x||0));
  if (!y || !m || !d) return null;
  const dt = new Date(y, (m-1), d, hh||0, mm||0, 0);
  const off = _tzOffsetHHMM(dt);
  const pad = (n)=> String(n).padStart(2,"0");
  return `${dt.getFullYear()}-${pad(dt.getMonth()+1)}-${pad(dt.getDate())}T${pad(dt.getHours())}:${pad(dt.getMinutes())}:00${off}`;
}

async function openConfirmedEventEditor(lead){
  const fecha = String(lead?.fecha_evento || "").trim();
  if (!fecha){
    toast("Falta fecha_evento para editar agenda.", "error");
    return;
  }

  const currentTel = String(lead?.telefono || "").trim();
  const currentDir = String(lead?.direccion || "").trim();
  const defaultTitle = (()=>{
    const marca = String(lead?.marca_nombre || lead?.marca || "").trim();
    const cli = String(lead?.cliente || "").trim();
    return [cli, marca].filter(Boolean).join(" - ") || `Lead #${lead?.id_lead}`;
  })();

  const res = await Swal.fire({
    title: `Editar evento confirmado (#${lead.id_lead})`,
    html: `
      <div style="text-align:left;display:flex;flex-direction:column;gap:10px">
        <div class="muted">Esto actualiza el lead y re-sincroniza Google Calendar. Se registra en historial y notifica a Operaciones/MICE/Admin.</div>

        <label style="font-weight:950;font-size:12px;opacity:.8;margin-top:6px">Título (Calendar)</label>
        <input id="ev_title" class="swal2-input" style="height:42px" value="${esc(defaultTitle)}" />

        <label style="font-weight:950;font-size:12px;opacity:.8">Teléfono (solo requerido para eventos de esta semana)</label>
        <input id="ev_tel" class="swal2-input" style="height:42px" value="${esc(currentTel)}" placeholder="+569..." />

        <label style="font-weight:950;font-size:12px;opacity:.8">Dirección</label>
        <input id="ev_dir" class="swal2-input" style="height:42px" value="${esc(currentDir)}" placeholder="Dirección completa" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div>
            <label style="font-weight:950;font-size:12px;opacity:.8">Inicio</label>
            <input id="ev_hi" class="swal2-input" style="height:42px" placeholder="14:30" />
          </div>
          <div>
            <label style="font-weight:950;font-size:12px;opacity:.8">Fin</label>
            <input id="ev_hf" class="swal2-input" style="height:42px" placeholder="18:30" />
          </div>
        </div>

        <label style="font-weight:950;font-size:12px;opacity:.8">Notas (Calendar)</label>
        <textarea id="ev_desc" class="swal2-textarea" placeholder="Notas para operaciones / cliente (opcional)"></textarea>
      </div>
    `,
    focusConfirm: false,
    showCancelButton: true,
    confirmButtonText: "Guardar y sincronizar",
    cancelButtonText: "Cancelar",
    preConfirm: ()=>{
      const title = (document.getElementById("ev_title")?.value || "").trim();
      const telefono = (document.getElementById("ev_tel")?.value || "").trim() || null;
      const direccion = (document.getElementById("ev_dir")?.value || "").trim() || null;
      const hi = (document.getElementById("ev_hi")?.value || "").trim();
      const hf = (document.getElementById("ev_hf")?.value || "").trim();
      const desc = (document.getElementById("ev_desc")?.value || "").trim() || null;

      if (!title){
        Swal.showValidationMessage("Falta título.");
        return false;
      }
      if (!direccion){
        Swal.showValidationMessage("Falta dirección.");
        return false;
      }
      if (!hi || !/^[0-2]\\d:[0-5]\\d$/.test(hi) || !hf || !/^[0-2]\\d:[0-5]\\d$/.test(hf)){
        Swal.showValidationMessage("Horario inválido (HH:MM).");
        return false;
      }

      const preStart = _localISO(fecha, hi);
      const preEnd = _localISO(fecha, hf);
      if (!preStart || !preEnd){
        Swal.showValidationMessage("No pude construir el horario.");
        return false;
      }
      return { pre_title: title, pre_location: direccion, pre_description: desc, pre_start: preStart, pre_end: preEnd, telefono, direccion };
    }
  });
  if (!res.isConfirmed || !res.value) return;

  try{
    await apiJSON(`/tools/agenda/${lead.id_lead}/edit_confirmed`, {
      method: "PUT",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify(res.value),
    });
    toast("Evento actualizado y sincronizado", "success");
    await loadLeads();
    render();
  }catch(err){
    toast("No pude actualizar evento: " + String(err?.message||err), "error");
  }
}

/* ========= Init ========= */
async function init(){
  try{
    const params = new URLSearchParams(location.search);
    document.body.classList.toggle("embed", params.get("embed") === "1");
  }catch(_){}

  const t = getToken();
  if (!t){
    showError("No hay token. Vuelve a /web/login.html y entra de nuevo.");
    return;
  }

  loadPrefs();
  loadStaleFilterFromQuery();
  setStatus("Token OK");

  try{
    await loadCatalogos();
    setStatus("Catálogos OK");
  }catch(err){
    showError("Error catálogos: " + String(err.message||err));
    return;
  }

  try{
    await loadLeads();
    setStatus("Leads: " + LEADS.length);
    if (isAuditFocusMode()) VIEW = "table";
    if (PENDING_OPEN_ID){
      const lead = LEADS.find(x => String(x.id_lead) === String(PENDING_OPEN_ID));
      if (lead && !QUERY_LEAD_OPENED){
        QUERY_LEAD_OPENED = true;
        setTimeout(() => openEditModal(lead), 80);
      }
      PENDING_OPEN_ID = null;
    }
  }catch(err){
    showError("Error leads: " + String(err.message||err));
    return;
  }

  qs("#btnKanban").onclick = ()=>setView("kanban");
  qs("#btnTable").onclick  = ()=>setView("table");
  qs("#q").addEventListener("input", render);
  qs("#btnCreate").onclick = openCreateModal;
  // Basurero declinados (click + drag&drop)
  try{
    const bt = qs("#btnTrash");
    bt.addEventListener("click", openDeclinadosTrash);
    bt.addEventListener("dragover", (e)=>{ e.preventDefault(); bt.classList.add("dropHover"); });
    bt.addEventListener("dragleave", ()=> bt.classList.remove("dropHover"));
    bt.addEventListener("drop", async (e)=>{
      e.preventDefault();
      bt.classList.remove("dropHover");
      const did = _declinadoId();
      if (!did) return toast("No encontré estado DECLINADO", "warning");
      await onDrop(e, did);
    });
  }catch(_){}
  const monthPicker = qs("#monthPicker");
  monthPicker.value = `${FILTER_YEAR}-${String(FILTER_MONTH_NUMBER).padStart(2,"0")}`;
  monthPicker.onchange = async ()=>{
    const match = /^(\d{4})-(\d{2})$/.exec(monthPicker.value || "");
    if (!match) return;
    FILTER_YEAR = Number(match[1]);
    FILTER_MONTH_NUMBER = Number(match[2]);
    FILTER_MONTH = true;
    savePrefs();
    await loadLeads();
    render();
  };
  qs("#btnAllMonths").onclick = async ()=>{
    FILTER_MONTH = !FILTER_MONTH;
    savePrefs();
    await loadLeads();
    render();
  };

  // Respeta VIEW (en móvil se fuerza a Tabla en loadPrefs()).
  setView(VIEW);
  openLeadFromQuery();
}

init();
</script>

  <script src="../js/agenda_wizard_v4.js?v=20260731-17"></script>
  <script src="../js/agenda_wizard_v6.js?v=20260731-17"></script>
</body>
</html>
