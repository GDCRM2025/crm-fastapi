const qs = (s, el=document) => el.querySelector(s);

function getToken(){
  return localStorage.getItem("token") || sessionStorage.getItem("token") || "";
}
function authHeaders(extra={}){
  const t = getToken();
  return t ? { ...extra, Authorization: `Bearer ${t}` } : extra;
}
function requireAuth(){
  if (!getToken()){
    location.href = "/web/login.html";
    return false;
  }
  return true;
}

/* ---------------- THEME (global) ----------------
   Guardamos en THEME: 'day' | 'night' (simple y consistente)
*/
function getTheme(){
  return localStorage.getItem("THEME") || "night";
}
function applyTheme(t){
  const isDay = t === "day";
  document.documentElement.classList.toggle("light", isDay);
  localStorage.setItem("THEME", isDay ? "day" : "night");

  // Propaga al iframe (si escucha)
  const fr = qs("#mainFrame");
  try{
    fr?.contentWindow?.postMessage({ cmd:"apply-theme", theme: isDay ? "day" : "night" }, "*");
    // compat: algunos iframes viejos escuchan {type:"theme"}
    fr?.contentWindow?.postMessage({ type:"theme", mode: isDay ? "light" : "dark" }, "*");
  }catch(_){}
}

function syncThemeToggle(){
  const t = getTheme();
  qs("#themeToggle").checked = (t === "day");
}

/* ---------------- CLOCK ---------------- */
function startClock(){
  const el = qs("#clockBox");
  const fmt = new Intl.DateTimeFormat("es-CL", {
    year:"numeric", month:"2-digit", day:"2-digit",
    hour:"2-digit", minute:"2-digit"
  });
  const tick = () => { el.textContent = fmt.format(new Date()); };
  tick();
  setInterval(tick, 30_000);
}

/* ---------------- USER ---------------- */
let ME = null;
function isAdmin(){
  return (ME?.rol || "").toLowerCase() === "admin";
}
async function fetchMe(){
  try{
    const r = await fetch("/me", { headers: authHeaders() });
    if (!r.ok) throw new Error("me failed");
    ME = await r.json();
    qs("#userBox").textContent = ME?.nombre ? `${ME.nombre}` : (ME?.username || "Usuario");
  }catch(_){
    ME = null;
    qs("#userBox").textContent = "—";
  }
}

