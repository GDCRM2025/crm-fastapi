let ACTIVE_ID = "";

function setActive(id){
  ACTIVE_ID = id;
  document.querySelectorAll(".navitem").forEach(b=>{
    b.classList.toggle("active", b.dataset.id === id);
  });
}

function openMain(src, activeId){
  const fr = qs("#mainFrame");
  fr.src = src;
  if (activeId) setActive(activeId);

  // Re-aplica theme cuando carga
  fr.addEventListener("load", () => {
    try{
      fr.contentWindow.postMessage({ cmd:"apply-theme", theme: getTheme() }, "*");
      fr.contentWindow.postMessage({ type:"theme", mode: getTheme()==="day" ? "light" : "dark" }, "*");
    }catch(_){}
  }, { once:true });
}

function buildNav(){
  const nav = qs("#nav");
  nav.innerHTML = "";

  MENU.forEach(group=>{
    if (group.adminOnly && !isAdmin()) return;

    const wrap = document.createElement("div");
    wrap.className = "navgroup";
    wrap.dataset.group = group.id;

    const head = document.createElement("button");
    head.type = "button";
    head.className = "navhead";
    head.innerHTML = `
      <span class="navico">${group.ico}</span>
      <span class="navtitle">${group.title}</span>
      <span class="navchev">▾</span>
    `;
    head.onclick = () => {
      // si está colapsado (icon-only), primero abre sidebar
      if (!document.body.classList.contains("nav-open") && !document.body.classList.contains("nav-pinned")){
        document.body.classList.add("nav-open");
      }
      // toggle del grupo
      const isOpen = wrap.classList.contains("open");
      document.querySelectorAll(".navgroup").forEach(g=>g.classList.remove("open"));
      wrap.classList.toggle("open", !isOpen);
    };

    const items = document.createElement("div");
    items.className = "navitems";

    group.items.forEach(it=>{
      if (it.sep){
        const sep = document.createElement("div");
        sep.className = "navsep";
        items.appendChild(sep);
        return;
      }
      const b = document.createElement("button");
      b.type = "button";
      b.className = "navitem";
      b.dataset.id = it.id;
      b.innerHTML = `<span class="ico">${it.ico}</span><span class="lbl">${it.label}</span>`;
      b.onclick = () => {
        if (it.action === "calc"){
          // calculadora en modal (ya existe en calc_modal.js)
          if (window.GD?.openCalc) window.GD.openCalc();
          setActive(it.id);
          return;
        }
        openMain(it.src, it.id);
        // al elegir, si no está pinned, cierra sidebar (icon-only)
        if (!document.body.classList.contains("nav-pinned")){
          document.body.classList.remove("nav-open");
        }
      };
      items.appendChild(b);
    });

    wrap.appendChild(head);
    wrap.appendChild(items);
    nav.appendChild(wrap);
  });
}

/* Sidebar behavior: iconos siempre, expande con hover/focus, se contrae al perder foco */
function bindSidebarBehavior(){
  const sidebar = qs("#sidebar");

  sidebar.addEventListener("mouseenter", () => {
    if (!document.body.classList.contains("nav-pinned")){
      document.body.classList.add("nav-open");
    }
  });
  sidebar.addEventListener("mouseleave", () => {
    if (!document.body.classList.contains("nav-pinned")){
      document.body.classList.remove("nav-open");
      document.querySelectorAll(".navgroup").forEach(g=>g.classList.remove("open"));
    }
  });

  document.addEventListener("click", (e) => {
    if (document.body.classList.contains("nav-pinned")) return;
    const inside = sidebar.contains(e.target);
    if (!inside){
      document.body.classList.remove("nav-open");
      document.querySelectorAll(".navgroup").forEach(g=>g.classList.remove("open"));
    }
  });
}

function bindUI(){
  // Pin toggle
  qs("#btnNav").onclick = () => {
    const pinned = document.body.classList.toggle("nav-pinned");
    if (pinned) document.body.classList.add("nav-open");
    else document.body.classList.remove("nav-open");
    document.querySelectorAll(".navgroup").forEach(g=>g.classList.remove("open"));
  };

  // Home (Dashboard)
  qs("#btnHome").onclick = () => {
    openMain("/web/views/dashboard.html", "");
    setActive("");
    if (!document.body.classList.contains("nav-pinned")){
      document.body.classList.remove("nav-open");
    }
  };

  // Theme toggle
  qs("#themeToggle").addEventListener("change", (e) => {
    applyTheme(e.target.checked ? "day" : "night");
  });

  // Logout
  qs("#btnLogout").onclick = () => {
    localStorage.removeItem("token");
    localStorage.removeItem("nombre");
    sessionStorage.removeItem("token");
    sessionStorage.removeItem("nombre");
    location.href = "/web/login.html";
  };

  // Weather modal open/close
  qs("#wxPill").onclick = () => {
    const m = qs("#wxModal");
    m.classList.add("open");
    m.setAttribute("aria-hidden","false");
  };
  qs("#wxClose").onclick = () => {
    const m = qs("#wxModal");
    m.classList.remove("open");
    m.setAttribute("aria-hidden","true");
  };
  qs("#wxModalBg").onclick = () => {
    const m = qs("#wxModal");
    m.classList.remove("open");
    m.setAttribute("aria-hidden","true");
  };

  // expose helpers for other modules
  window.GD = window.GD || {};
  window.GD.getToken = getToken;
  window.GD.authHeaders = authHeaders;
  window.GD.openMain = openMain;
  window.GD.setTheme = applyTheme;
}

/* init */
(async function init(){
  if (!requireAuth()) return;

  await fetchMe();
  buildNav();
  bindSidebarBehavior();
  bindUI();
  startClock();

  // boot theme
  applyTheme(getTheme());
  syncThemeToggle();

  // default: Ver leads (Kanban)
  openMain("/web/views/leads.html#kanban", "leads_ver");
})();
