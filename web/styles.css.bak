/* web/styles.css */

/* ---------- RESET BÁSICO ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body { height: 100%; }

/* ---------- THEME (dark / light) ---------- */

:root {
  --bg-image: url('/web/img/night.jpg');

  --bg: rgba(15, 23, 42, 0.9);
  --bg-soft: rgba(15, 23, 42, 0.85);
  --bg-card: rgba(15, 23, 42, 0.92);
  --bg-card-soft: rgba(17, 24, 39, 0.94);
  --fg: #f9fafb;
  --fg-soft: #9ca3af;
  --border-subtle: rgba(55, 65, 81, 0.8);
  --primary: #22c55e;
  --primary-soft: rgba(34, 197, 94, 0.18);
  --accent: #0ea5e9;
  --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.55);
  --sep: rgba(31, 41, 55, 0.9);
}

:root.light {
  --bg-image: url('/web/img/day.jpg');

  --bg: rgba(243, 244, 246, 0.9);
  --bg-soft: rgba(249, 250, 251, 0.96);
  --bg-card: rgba(255, 255, 255, 0.96);
  --bg-card-soft: rgba(249, 250, 251, 0.96);
  --fg: #111827;
  --fg-soft: #6b7280;
  --border-subtle: rgba(209, 213, 219, 0.9);
  --primary: #16a34a;
  --primary-soft: rgba(22, 163, 74, 0.18);
  --accent: #0284c7;
  --shadow-soft: 0 12px 30px rgba(15, 23, 42, 0.15);
  --sep: rgba(229, 231, 235, 0.9);
}

body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--fg);
  background-color: #020617;
  background-image: var(--bg-image);
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

/* capa para que se lea el contenido encima de la foto */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.85) 0, rgba(15, 23, 42, 0.95) 45%, rgba(15, 23, 42, 1) 100%);
  z-index: -1;
}

:root.light body::before {
  background: radial-gradient(circle at top left, rgba(243, 244, 246, 0.95) 0, rgba(243, 244, 246, 0.98) 45%, #f3f4f6 100%);
}

/* ---------- TOPBAR ---------- */

.topbar {
  height: 48px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  background: linear-gradient(to right, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.92));
  border-bottom: 1px solid var(--border-subtle);
  color: var(--fg);
  backdrop-filter: blur(14px);
  gap: 6px;
}

:root.light .topbar {
  background: linear-gradient(to right, rgba(255, 255, 255, 0.96), rgba(249, 250, 251, 0.96));
}

.topbar .brand {
  font-weight: 600;
  letter-spacing: 0.06em;
  cursor: pointer;
  user-select: none;
}

/* TOP MENU (Quick nav) */
.topmenu{
  display:flex;
  align-items:center;
  gap:8px;
  margin-left:14px;
}
.topmenu a{
  display:inline-flex;
  align-items:center;
  padding:8px 10px;
  border-radius:999px;
  text-decoration:none;
  font-weight:900;
  font-size:13px;
  letter-spacing:.04em;
  color: var(--fg-soft);
  border:1px solid transparent;
  background: transparent;
}
.topmenu a:hover{
  background: rgba(34,197,94,.10);
  border-color: rgba(34,197,94,.22);
  color: var(--fg);
}
.topmenu a.active{
  background: rgba(34,197,94,.16);
  border-color: rgba(34,197,94,.35);
  color: #f0fdf4;
}
@media (max-width: 980px){
  .topmenu{ display:none; } /* en móvil usas sidebar */
}

.topbar .spacer { flex: 1; }

.icon-btn {
  border: none;
  background: transparent;
  color: var(--fg);
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  cursor: pointer;
  margin-right: 6px;
  font-size: 16px;
  transition: background 0.15s ease, transform 0.1s ease;
}

.icon-btn:last-child { margin-right: 0; }

.icon-btn:hover {
  background: rgba(148, 163, 184, 0.18);
  transform: translateY(-1px);
}

/* FECHA / HORA */
.top-meta {
  font-size: 12px;
  color: var(--fg-soft);
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(2, 6, 23, 0.35);
  backdrop-filter: blur(10px);
  white-space: nowrap;
}

/* CLIMA PILL */
.wx-pill {
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(2, 6, 23, 0.35);
  color: var(--fg);
  border-radius: 999px;
  padding: 6px 10px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  transition: transform .12s ease, background .15s ease, border-color .15s ease;
  backdrop-filter: blur(10px);
  max-width: 240px;
}

.wx-pill:hover {
  transform: translateY(-1px);
  border-color: rgba(34, 197, 94, 0.35);
  background: rgba(34, 197, 94, 0.10);
}

.wx-emoji { font-size: 14px; line-height: 1; }
.wx-temp  { font-size: 12px; font-weight: 650; }
.wx-city  {
  font-size: 12px;
  color: var(--fg-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- LAYOUT PRINCIPAL ---------- */

.layout {
  display: flex;
  height: calc(100vh - 48px);
}

/* Sidebar acordeón */
.sidebar {
  width: 250px;
  border-right: 1px solid var(--border-subtle);
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.92));
  padding: 8px 6px;
  overflow-y: auto;
  backdrop-filter: blur(16px);
}

:root.light .sidebar {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(249, 250, 251, 0.96));
}

/* colapsar menú */
body.collapsed .sidebar { width: 62px; }

body.collapsed .sidebar .acc summary b,
body.collapsed .sidebar .acc-body { display: none; }

/* Main */
#main {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top right, rgba(34, 197, 94, 0.08) 0, transparent 55%),
              radial-gradient(circle at bottom left, rgba(56, 189, 248, 0.09) 0, transparent 55%);
  color: var(--fg);
  overflow: hidden;
}

/* ---------- ACCORDIÓN MENU ---------- */

.accordion {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.acc {
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid transparent;
  background: transparent;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.acc[open] {
  border-color: rgba(148, 163, 184, 0.4);
  background: rgba(15, 23, 42, 0.9);
}

:root.light .acc[open] { background: rgba(255, 255, 255, 0.98); }

.acc > summary {
  list-style: none;
  cursor: pointer;
  padding: 8px 10px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  border-bottom: 1px solid rgba(15, 23, 42, 0.7);
  background: rgba(15, 23, 42, 0.95);
  color: var(--fg);
}

:root.light .acc > summary {
  border-bottom-color: rgba(229, 231, 235, 0.9);
  background: rgba(243, 244, 246, 0.98);
  color: #111827;
}

.acc > summary::-webkit-details-marker { display: none; }

.acc .icon { width: 18px; text-align: center; }

.acc b { font-weight: 600; }

.acc-body {
  padding: 6px 4px 8px 4px;
  display: flex;
  flex-direction: column;
}

.acc-body a {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 8px;
  font-size: 13px;
  color: var(--fg-soft);
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease, transform 0.08s ease;
}

.acc-body a:hover {
  background: rgba(148, 163, 184, 0.15);
  color: var(--fg);
  transform: translateX(1px);
}

/* separador en menú */
.acc-body > div[style*="height: 1px"] { opacity: 0.6; }

/* ---------- HOME DASHBOARD ---------- */

.home {
  padding: 18px 22px;
  height: 100%;
  overflow-y: auto;
}

.home-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.home-header h1 {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.home-header p {
  margin-top: 4px;
  font-size: 13px;
  color: var(--fg-soft);
}

.home-user {
  font-size: 13px;
  color: var(--fg-soft);
  white-space: nowrap;
}

.home-user-label { font-weight: 500; }

.home-block { margin-top: 4px; }

.home-section-title {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--fg-soft);
  margin-bottom: 10px;
}

/* Grid de tarjetas */
.home-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 12px;
}

.home-card {
  background: radial-gradient(circle at top left, var(--bg-card) 0%, var(--bg-card-soft) 60%);
  border-radius: 14px;
  padding: 12px 14px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  box-shadow: var(--shadow-soft);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-height: 80px;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease,
    background 0.15s ease;
  text-align: left;
}

.home-card:hover {
  transform: translateY(-3px);
  border-color: var(--primary-soft);
  background: radial-gradient(circle at top left, var(--primary-soft), var(--bg-card-soft));
}

.home-card-icon { font-size: 20px; margin-bottom: 2px; }

.home-card-title { font-size: 14px; font-weight: 600; }

.home-card-subtitle { font-size: 12px; color: var(--fg-soft); }

/* ---------- IFRAMES / VIEW WRAP ---------- */

.view { flex: 1; padding: 0; height: 100%; }

.viewframe {
  width: 100%;
  height: 100%;
  border: none;
  background: #020617;
}

:root.light .viewframe { background: #f9fafb; }

/* ---------- MODAL CLIMA ---------- */
.wx-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: flex-start;
  justify-content: center;
  padding: 56px 14px 14px;
  background: rgba(2, 6, 23, 0.55);
  backdrop-filter: blur(10px);
  z-index: 9999;
}

.wx-modal.show { display: flex; }

.wx-card {
  width: min(520px, 100%);
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  background: radial-gradient(circle at top left, var(--bg-card) 0%, var(--bg-card-soft) 65%);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.wx-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 14px 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.wx-card-city { font-size: 18px; font-weight: 700; letter-spacing: .02em; }
.wx-card-sub { font-size: 12px; color: var(--fg-soft); margin-top: 2px; }

.wx-close {
  border: none;
  background: rgba(148, 163, 184, 0.15);
  color: var(--fg);
  width: 34px;
  height: 34px;
  border-radius: 999px;
  cursor: pointer;
}

.wx-block { padding: 12px 14px 14px; }
.wx-block-title {
  font-size: 12px;
  color: var(--fg-soft);
  letter-spacing: .12em;
  margin-bottom: 10px;
}

.wx-days {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.wx-day {
  display: grid;
  grid-template-columns: 70px 30px 1fr 70px;
  align-items: center;
  gap: 10px;
  padding: 10px 10px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(2, 6, 23, 0.25);
}

.wx-dow { font-weight: 650; font-size: 14px; }
.wx-ico { font-size: 16px; text-align: center; }
.wx-bar {
  height: 6px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.18);
  position: relative;
  overflow: hidden;
}
.wx-bar > i {
  position: absolute;
  inset: 0;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(34, 197, 94, 0.55), rgba(14, 165, 233, 0.55));
}
.wx-maxmin {
  text-align: right;
  font-size: 13px;
  color: var(--fg);
}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 900px) {
  .layout { flex-direction: column; }

  .sidebar {
    width: 100%;
    height: auto;
    border-right: none;
    border-bottom: 1px solid var(--border-subtle);
  }

  body.collapsed .sidebar { display: none; }

  #main { height: calc(100vh - 48px); }

  .home { padding: 14px 12px 16px; }

  .top-meta { display: none; } /* en móvil lo escondemos */
  .wx-pill { max-width: 180px; }
}

@media (max-width: 600px) {
  .home-header {
    flex-direction: column;
    align-items: flex-start;
  }
  .home-user { align-self: flex-start; }
}
/* ===== TOOLS: MAC / GOOGLE CALENDAR LOOK ===== */

.tools-page { text-transform: uppercase; }

.tools-shell {
  margin-top: 10px;
  border: 1px solid rgba(148,163,184,.18);
  border-radius: 16px;
  overflow: hidden;
  background: rgba(2,6,23,.25);
  backdrop-filter: blur(14px);
}

.tools-tabs {
  display: flex;
  gap: 8px;
  padding: 10px;
  border-bottom: 1px solid rgba(148,163,184,.14);
  background: rgba(15,23,42,.55);
}

.tab-btn {
  border: 1px solid rgba(148,163,184,.18);
  background: rgba(2,6,23,.25);
  color: var(--fg);
  padding: 8px 12px;
  border-radius: 999px;
  cursor: pointer;
  font-weight: 700;
  letter-spacing: .08em;
  transition: transform .12s ease, background .15s ease, border-color .15s ease;
}
.tab-btn:hover { transform: translateY(-1px); border-color: rgba(34,197,94,.35); }
.tab-btn.active {
  background: rgba(34,197,94,.14);
  border-color: rgba(34,197,94,.45);
}

.tools-panels { padding: 12px; }

/* 🔥 CLAVE: OCULTAR TODO Y SOLO MOSTRAR ACTIVO */
.tools-panel { display: none; }
.tools-panel.active { display: block; }

.panel-head {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom: 10px;
}
.panel-actions { display:flex; gap:8px; flex-wrap:wrap; }

.tools-grid3 {
  display:grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
}
@media (max-width: 1100px) {
  .tools-grid3 { grid-template-columns: 1fr; }
}

.card.soft {
  border: 1px solid rgba(148,163,184,.18);
  border-radius: 16px;
  background: rgba(15,23,42,.40);
  box-shadow: var(--shadow-soft);
  padding: 10px;
}
.card-title { font-weight: 800; letter-spacing: .12em; color: var(--fg-soft); margin-bottom: 8px; }

.listbox { display:flex; flex-direction:column; gap:8px; min-height: 140px; }

.event-card {
  border: 1px solid rgba(148,163,184,.18);
  background: rgba(2,6,23,.20);
  color: var(--fg);
  border-radius: 14px;
  padding: 10px 12px;
  cursor: pointer;
  text-align:left;
  transition: transform .12s ease, border-color .15s ease, background .15s ease;
}
.event-card:hover {
  transform: translateY(-2px);
  border-color: rgba(34,197,94,.35);
  background: rgba(34,197,94,.08);
}
.event-card-top { display:flex; gap:8px; align-items:center; justify-content:space-between; }
.event-title { font-weight: 800; letter-spacing: .02em; }
.event-sub { margin-top: 2px; font-size: 12px; color: var(--fg-soft); }
.event-mini { margin-top: 6px; font-size: 12px; opacity:.9; }

.badge {
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 999px;
  border: 1px solid rgba(148,163,184,.18);
  background: rgba(2,6,23,.25);
  color: var(--fg);
  white-space: nowrap;
}
.badge.warn { border-color: rgba(245,158,11,.45); background: rgba(245,158,11,.12); }
.badge.danger { border-color: rgba(239,68,68,.50); background: rgba(239,68,68,.14); }

/* calc */
.calc-widget.mac { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
.calc-result { margin-top: 6px; font-weight: 800; letter-spacing: .08em; }

/* ===== MODAL (GOOGLE CALENDAR CARD) ===== */
.gd-modal {
  position: fixed;
  inset: 0;
  display:none;
  align-items:center;
  justify-content:center;
  padding: 18px;
  background: rgba(2,6,23,.55);
  backdrop-filter: blur(10px);
  z-index: 9999;
}
.gd-modal.show { display:flex; }

.gd-modal-card {
  width: min(720px, 100%);
  border-radius: 18px;
  border: 1px solid rgba(148,163,184,.20);
  background: radial-gradient(circle at top left, rgba(15,23,42,.92), rgba(2,6,23,.92));
  box-shadow: var(--shadow-soft);
  overflow:hidden;
}

.gd-modal-top {
  display:flex;
  align-items:center;
  gap:10px;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(148,163,184,.12);
}
.gd-dot { width: 12px; height: 12px; border-radius: 999px; background: rgba(34,197,94,.9); }
.gd-modal-title { font-weight: 900; letter-spacing: .02em; }
.gd-spacer { flex: 1; }

.gd-modal-body { padding: 14px; display:flex; flex-direction:column; gap:12px; }
.gd-row { display:flex; gap:10px; align-items:flex-start; }
.gd-ico { width: 26px; text-align:center; opacity:.95; }
.gd-col { flex:1; }
.gd-main { font-weight: 900; }
.gd-sub { font-size: 12px; color: var(--fg-soft); margin-top: 2px; }
.gd-sub.pre { white-space: pre-wrap; }

.gd-actions { display:flex; gap:10px; justify-content:flex-end; flex-wrap:wrap; padding-top: 6px; }
/* -------------------- SPLIT HORIZONTAL (MAIN ARRIBA + TOOL ABAJO) -------------------- */

.btn{
  border:1px solid rgba(148,163,184,.18);
  background:rgba(2,6,23,.35);
  color:var(--fg);
  padding:6px 10px;
  border-radius:999px;
  cursor:pointer;
  backdrop-filter:blur(10px);
}
.btn:hover{
  border-color:rgba(34,197,94,.35);
  background:rgba(34,197,94,.10);
}

.split-wrap{
  height:100%;
  width:100%;
  display:flex;
  flex-direction:column; /* ✅ HORIZONTAL: ARRIBA/ABAJO */
  gap:0;
}

.viewframe{
  flex:1;
  width:100%;
  height:100%;
  border:none;
  background:#020617;
}

.toolframe{
  width:100%;
  height:30%;           /* ✅ TOOL OCUPA ~30% */
  min-height:220px;
  max-height:60%;
  border:none;
  background:#020617;
}

.split-divider{
  height:10px;          /* ✅ DIVIDER HORIZONTAL */
  width:100%;
  cursor:row-resize;
  background:rgba(148,163,184,.08);
  border-top:1px solid rgba(148,163,184,.14);
  border-bottom:1px solid rgba(148,163,184,.14);
}
.split-divider:hover{
  background:rgba(34,197,94,.10);
}
