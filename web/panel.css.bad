cat > web/panel.css <<'EOF'
:root{
  --gd-bg0: #08121f;
  --gd-bg1: #0b1f34;
  --gd-panel: rgba(255,255,255,.06);
  --gd-panel-2: rgba(255,255,255,.10);
  --gd-border: rgba(255,255,255,.12);
  --gd-text: rgba(255,255,255,.92);
  --gd-muted: rgba(255,255,255,.65);
  --gd-accent: #22c55e;
  --gd-shadow: 0 18px 55px rgba(0,0,0,.45);
  --gd-radius: 18px;
}

:root.light{
  --gd-bg0: #eaf2ff;
  --gd-bg1: #cfe3ff;
  --gd-panel: rgba(255,255,255,.65);
  --gd-panel-2: rgba(255,255,255,.78);
  --gd-border: rgba(0,0,0,.08);
  --gd-text: rgba(0,0,0,.86);
  --gd-muted: rgba(0,0,0,.58);
  --gd-shadow: 0 18px 55px rgba(0,0,0,.18);
}

html,body{ height:100%; }
body{
  margin:0;
  color: var(--gd-text);
  background:
    radial-gradient(1200px 700px at 20% 10%, rgba(34,197,94,.12), transparent 60%),
    radial-gradient(900px 600px at 80% 20%, rgba(59,130,246,.18), transparent 55%),
    linear-gradient(135deg, var(--gd-bg0), var(--gd-bg1));
  overflow:hidden;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
}

/* Topbar (SIN menú horizontal) */
.topbar{
  height:56px;
  display:flex;
  align-items:center;
  gap:10px;
  padding:0 14px;
  border-bottom: 1px solid var(--gd-border);
  background: rgba(0,0,0,.20);
  backdrop-filter: blur(12px);
}
:root.light .topbar{ background: rgba(255,255,255,.45); }

.brand{
  font-weight:800;
  letter-spacing:.6px;
  text-transform:uppercase;
  opacity:.95;
}
.topspacer{ flex:1; }

.iconbtn{
  appearance:none;
  border: 1px solid var(--gd-border);
  background: var(--gd-panel);
  color: var(--gd-text);
  border-radius: 12px;
  padding:8px 10px;
  cursor:pointer;
}
.iconbtn:hover{ border-color: rgba(34,197,94,.35); }

/* Layout */
.layout{
  height: calc(100vh - 56px);
  display:grid;
  grid-template-columns: 240px 1fr;
}

.sidebar{
  border-right: 1px solid var(--gd-border);
  background: rgba(0,0,0,.18);
  backdrop-filter: blur(12px);
  padding: 10px 10px;
  overflow:auto;
}
:root.light .sidebar{ background: rgba(255,255,255,.36); }

.sidebar.collapsed{ width:72px; }
.sidebar .side-menu{ list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:6px; }

.side-item{
  width:100%;
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 12px;
  border-radius: 14px;
  border:1px solid transparent;
  background: transparent;
  color: var(--gd-text);
  cursor:pointer;
  text-align:left;
}
.side-item .ico{ width:20px; text-align:center; opacity:.9; }
.side-item .lbl{ font-weight:700; }
.side-item:hover{
  background: var(--gd-panel);
  border-color: var(--gd-border);
}
.side-item.active{
  background: rgba(34,197,94,.14);
  border-color: rgba(34,197,94,.34);
}

.side-footer{
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--gd-border);
}
.side-link{
  display:block;
  padding:10px 12px;
  border-radius: 14px;
  border:1px solid var(--gd-border);
  background: var(--gd-panel);
  color: var(--gd-text);
  text-decoration:none;
}
.side-link:hover{ border-color: rgba(34,197,94,.35); }

.main{
  height:100%;
  padding: 12px;
  overflow:hidden;
}
.frame{
  width:100%;
  height:100%;
  border:0;
  border-radius: var(--gd-radius);
  background: rgba(0,0,0,.12);
  box-shadow: var(--gd-shadow);
}

/* Weather pill */
.wx-pill{
  display:flex;
  align-items:center;
  gap:10px;
  border: 1px solid var(--gd-border);
  background: var(--gd-panel);
  color: var(--gd-text);
  border-radius: 999px;
  padding: 8px 12px;
  cursor:pointer;
}
.wx-pill:hover{ border-color: rgba(59,130,246,.35); }
.wx-temp{ font-weight:900; }
.wx-city{ opacity:.85; font-weight:700; }

/* Weather modal (iOS-ish) */
.wx-modal{
  position:fixed; inset:0;
  display:none;
  z-index: 9999;
}
.wx-modal.open{ display:block; }

.wx-modal-bg{
  position:absolute; inset:0;
  background:
    radial-gradient(900px 900px at 20% 10%, rgba(255,255,255,.35), transparent 55%),
    radial-gradient(900px 900px at 80% 20%, rgba(255,255,255,.20), transparent 60%),
    linear-gradient(180deg, rgba(68,140,220,.92), rgba(42,112,188,.92));
  filter:saturate(1.1);
}

:root.light .wx-modal-bg{
  background:
    radial-gradient(900px 900px at 20% 10%, rgba(255,255,255,.55), transparent 55%),
    linear-gradient(180deg, rgba(90,160,235,.92), rgba(56,130,246,.88));
}

.wx-modal-content{
  position:relative;
  height:100%;
  padding: 18px;
  overflow:auto;
  color: rgba(255,255,255,.95);
}

.wx-close{
  position: fixed;
  right: 18px;
  top: 14px;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.28);
  background: rgba(0,0,0,.18);
  color:#fff;
  font-size: 18px;
  cursor:pointer;
  backdrop-filter: blur(12px);
}

.wx-header{
  max-width: 780px;
  margin: 42px auto 14px auto;
  text-align:center;
}
.wx-loc{
  font-size: 44px;
  font-weight: 300;
  letter-spacing:.2px;
}
.wx-cond{
  margin-top: 6px;
  opacity:.85;
  font-size: 18px;
  font-weight: 600;
}
.wx-big{
  display:flex;
  align-items:flex-end;
  justify-content:center;
  gap:12px;
  margin-top: 8px;
}
.wx-big-temp{
  font-size: 110px;
  line-height: 1;
  font-weight: 200;
}
.wx-big-ico{
  font-size: 44px;
  padding-bottom: 16px;
  opacity:.95;
}
.wx-summary{
  margin-top: 10px;
  font-size: 16px;
  opacity:.9;
}

.wx-card{
  max-width: 780px;
  margin: 14px auto;
  border-radius: 22px;
  border: 1px solid rgba(255,255,255,.22);
  background: rgba(255,255,255,.16);
  backdrop-filter: blur(16px);
  padding: 14px;
}

.wx-card-title{
  font-size: 13px;
  letter-spacing:.9px;
  opacity:.9;
  font-weight: 800;
}

.wx-hours{
  margin-top: 10px;
  display:flex;
  gap:12px;
  overflow:auto;
  padding-bottom: 6px;
}
.wx-hour{
  min-width: 86px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,.18);
  background: rgba(0,0,0,.12);
  padding: 10px;
  text-align:center;
}
.wx-hour .t{ opacity:.9; font-weight:800; }
.wx-hour .i{ font-size: 22px; margin: 10px 0; }
.wx-hour .v{ font-size: 22px; font-weight:900; }

.wx-days{
  margin-top: 10px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.wx-day{
  display:grid;
  grid-template-columns: 86px 30px 52px 1fr 52px;
  align-items:center;
  gap:10px;
  padding: 8px 6px;
  border-radius: 14px;
}
.wx-day .d{ font-weight:800; opacity:.95; }
.wx-day .i{ font-size: 18px; text-align:center; }
.wx-day .min{ opacity:.75; font-weight:800; text-align:right; }
.wx-day .max{ font-weight:900; text-align:right; }

.wx-bar{
  height: 8px;
  border-radius: 999px;
  background: rgba(255,255,255,.18);
  overflow:hidden;
  position:relative;
}
.wx-bar > span{
  position:absolute; top:0; bottom:0;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(255,215,0,.95), rgba(255,165,0,.95));
}
EOF
